        <target state="final">نشط</target>
      </trans-unit>
      <trans-unit id="overview.badge.locked" approved="yes">
        <source>Locked</source>
        <target state="final">مُقفل</target>
      </trans-unit>
      <trans-unit id="overview.defaultProvider" approved="yes">
        <source>Default provider</source>
