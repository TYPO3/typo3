        <target state="final">قمت بتسجيل الخروج من وضع معاينة مساحة العمل. انقر على هذا الرابط إلى %1$s العودة إلى الموقع%2$s</target>
      </trans-unit>
      <trans-unit id="previewLogoutError" approved="yes">
        <source>%1$sERROR:%2$sTemplate File "%3$s" configured with $TYPO3_CONF_VARS["FE"]["workspacePreviewLogoutTemplate"] not found. Please contact webmaster about this problem.</source>
        <target state="final">%1$sخطأٌ:%2$s ملفُ القالبِ "%3$s" المُهيَّأُ بـ $TYPO3_CONF_VARS["FE"]["workspacePreviewLogoutTemplate"] غيرُ موجودٍ. يُرجى التواصلُ مع مشرفِ الموقعِ بشأنِ هذهِ المشكلةِ.</target>
      </trans-unit>
