    <body>
      <trans-unit id="stage_editing" approved="yes">
        <source>Editing</source>
        <target state="final">التعديل</target>
      </trans-unit>
      <trans-unit id="stage_ready_to_publish" approved="yes">
        <source>Ready to publish</source>
        <target state="final">جاهز للنشر</target>
      </trans-unit>
      <trans-unit id="stage_publish" approved="yes">
        <source>Publish</source>
        <target state="final">النشر</target>
      </trans-unit>
      <trans-unit id="stage_all" approved="yes">
        <source>All stages</source>
        <target state="final">جميع المراحل</target>
      </trans-unit>
      <trans-unit id="previewText" approved="yes">
        <source>Preview of workspace %s (%s)</source>
        <target state="final">معاينة مساحة العمل %s (%s)</target>
      </trans-unit>
      <trans-unit id="stopPreview" approved="yes">
