<?xml version="1.0" encoding="UTF-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" version="1.2">
  <file source-language="en" datatype="plaintext" original="EXT:reports/Resources/Private/Language/locallang_reports.xlf" date="2011-10-17T20:22:35Z" product-name="reports" target-language="km">
    <header/>
    <body>
      <trans-unit id="status_report_title" resname="status_report_title" approved="yes">
        <source>Status Report</source>
        <target state="final">ស្ទេតធឺស​របាយការណ៍</target>
      </trans-unit>
      <trans-unit id="status_report_description" resname="status_report_description" approved="yes">
        <source>Get a status report about your site's operation and any detected problems.</source>
        <target state="final">ទទួល​ស្ទេតធឺស​រាយការណ៍​អំពី​ការងារ​វែបសាយ​របស់​អ្នក និង​បញ្ហា​ដែល​ស្គាល់ ។</target>
      </trans-unit>
      <trans-unit id="status_report_explanation" resname="status_report_explanation" approved="yes">
        <source>Here you can find a short overview of your site's parameters as well as any problems detected with your installation. It may be useful to copy and paste this information into support requests filed on TYPO3's support mailinglists and project issue trackers.</source>
        <target state="final">ទីនេះ​អ្នក​អាច​ឃើញ​នូវ​ការសង្ខេប​ខ្លី​មួយ​នៃ​ប៉ារ៉ាម៉ែត​វែបសាយ ក៏ដូច​ជា​បញ្ហា​ដែល​រកឃើញ​ក្នុង​ការដំឡើង​របស់​អ្នក ។ វា​ប្រហែល​ជា​មាន​ប្រយោជន៍​សម្រាប់​ចម្លង និង​ផេស្ដ៍​ព័ត៌មាន​នេះ​ទៅ​ក្នុង​ហ្វៃល៍​ជំនួយ​នៅ​លើ​បញ្ជី​អ៊‍ីមេល​ជំនួយ​របស់ TYPO3 និង​កន្លែង​តាមដាន​ការចេញ​នៃ​គម្រោង ។</target>
      </trans-unit>
      <trans-unit id="status_ok" resname="status_ok" approved="yes">
        <source>OK</source>
        <target state="final">អូខេ</target>
      </trans-unit>
      <trans-unit id="status_insecure" resname="status_insecure" approved="yes">
        <source>Insecure</source>
        <target state="final">មិន​សុវត្ថភាព</target>
      </trans-unit>
      <trans-unit id="status_disabled" resname="status_disabled" approved="yes">
        <source>Disabled</source>
        <target state="final">បិទ​ដំណើរការ</target>
      </trans-unit>
      <trans-unit id="status_enabled" resname="status_enabled" approved="yes">
        <source>Enabled</source>
        <target state="final">បើក​ដំណើរការ</target>
      </trans-unit>
      <trans-unit id="status_enabledPermanently" resname="status_enabledPermanently" approved="yes">
        <source>Enabled permanently</source>
        <target state="final">បើក​ដំណើរការ​រហូត</target>
      </trans-unit>
      <trans-unit id="status_enabledTemporarily" resname="status_enabledTemporarily" approved="yes">
        <source>Enabled temporarily</source>
        <target state="final">បើក​ដំណើរការ​បណ្ដោះអាសន្ន</target>
      </trans-unit>
      <trans-unit id="status_empty" resname="status_empty" approved="yes">
        <source>Empty</source>
        <target state="final">ទទេ</target>
      </trans-unit>
      <trans-unit id="status_connectionFailed" resname="status_connectionFailed" approved="yes">
        <source>Connection Failed</source>
        <target state="final">ការភ្ជាប់​បរាជ័យ</target>
      </trans-unit>
      <trans-unit id="status_updateComplete" resname="status_updateComplete" approved="yes">
        <source>Update Complete</source>
        <target state="final">អាប់ដេត​ជោគជ័យ</target>
      </trans-unit>
      <trans-unit id="status_updateIncomplete" resname="status_updateIncomplete" approved="yes">
        <source>Update Incomplete</source>
        <target state="final">អាប់ដេត​មិន​ជោគជ័យ</target>
      </trans-unit>
      <trans-unit id="status_typo3" resname="status_typo3" approved="yes">
        <source>TYPO3 System</source>
        <target state="final">ប្រព័ន្ធ TYPO3</target>
      </trans-unit>
      <trans-unit id="status_system" resname="status_system" approved="yes">
        <source>System</source>
        <target state="final">ប្រព័ន្ធ</target>
      </trans-unit>
      <trans-unit id="status_security" resname="status_security" approved="yes">
        <source>Security</source>
        <target state="final">សុវត្ថភាព</target>
      </trans-unit>
      <trans-unit id="status_configuration" resname="status_configuration" approved="yes">
        <source>Configuration</source>
        <target state="final">ការខន់ហ្វីក</target>
      </trans-unit>
      <trans-unit id="status_referenceIndex" resname="status_referenceIndex" approved="yes">
        <source>Reference Index</source>
        <target state="final">មាតិកា​យោង</target>
      </trans-unit>
      <trans-unit id="status_memcachedConfiguration" resname="status_memcachedConfiguration" approved="yes">
        <source>Memcached Configuration</source>
        <target state="final">ខន់ហ្វីក​ការចងចាំ​ខាស្ស</target>
      </trans-unit>
      <trans-unit id="status_PhpSafeMode" resname="status_PhpSafeMode" approved="yes">
        <source>PHP safe_mode</source>
        <target state="final">PHP safe_mode</target>
      </trans-unit>
      <trans-unit id="status_adminUserAccount" resname="status_adminUserAccount" approved="yes">
        <source>Admin User Account</source>
        <target state="final">គណនី​អ្នក​គ្រប់គ្រង</target>
      </trans-unit>
      <trans-unit id="status_encryptionKey" resname="status_encryptionKey" approved="yes">
        <source>Encryption Key</source>
        <target state="final">ឃី​អ៊‍ីនគ្រីប</target>
      </trans-unit>
      <trans-unit id="status_fileDenyPattern" resname="status_fileDenyPattern" approved="yes">
        <source>File Deny Pattern</source>
        <target state="final">លំនាំ​ហ្វៃល៍​បដិសេធ</target>
      </trans-unit>
      <trans-unit id="status_htaccessUploadProtection" resname="status_htaccessUploadProtection" approved="yes">
        <source>.htaccess Upload Protection</source>
        <target state="final">ការការពារ​អាប់ឡូត .htaccess</target>
      </trans-unit>
      <trans-unit id="status_installToolPassword" resname="status_installToolPassword" approved="yes">
        <source>Install Tool Password</source>
        <target state="final">ពាក្យ​សម្ងាត់​ឧបករណ៍​ដំឡើង</target>
      </trans-unit>
      <trans-unit id="status_installTool" resname="status_installTool" approved="yes">
        <source>Install Tool</source>
        <target state="final">ឧបករណ៍​ដំឡើង</target>
      </trans-unit>
      <trans-unit id="status_phpVersion" resname="status_phpVersion" approved="yes">
        <source>PHP Version</source>
        <target state="final">កំណែ PHP</target>
      </trans-unit>
      <trans-unit id="status_phpTooOld" resname="status_phpTooOld" approved="yes">
        <source>Your PHP installation is too old.</source>
        <target state="final">PHP ដែល​អ្នក​ដំឡើង​ចាស់​ពេក ។</target>
      </trans-unit>
      <trans-unit id="status_phpMemory" resname="status_phpMemory" approved="yes">
        <source>PHP Memory Limit</source>
        <target state="final">កម្រិត​មេមឺរី PHP</target>
      </trans-unit>
      <trans-unit id="status_phpMemoryEditLimit" resname="status_phpMemoryEditLimit" approved="yes">
        <source>Increase the memory limit by editing the memory_limit parameter in the file %s and then restart your web server (or contact your system administrator or hosting provider for assistance).</source>
        <target state="final">ដំឡើង​កម្រិត​មេមឺរី​ដោយ​កែ​ប៉ារ៉ាមែត memory_limit ក្នុង​ហ្វៃល៍ %s រួច​បិទបើក​សឺវើ​វែប (ឬ​ទាក់ទង​អ្នក​គ្រប់គ្រង​ប្រព័ន្ធ ឬ​អ្នក​ផ្ដល់​សេវា​ហស្ដ៍​ដើម្បី​សុំ​ជំនួយ) ។</target>
      </trans-unit>
      <trans-unit id="status_phpMemoryContactAdmin" resname="status_phpMemoryContactAdmin" approved="yes">
        <source>Contact your system administrator or hosting provider for assistance with increasing your PHP memory limit.</source>
        <target state="final">ទាក់ទង​អ្នកគ្រប់គ្រង​ប្រព័ន្ធ ឬ​អ្នក​ផ្ដល់​សេវា​ហស្ដ៍​ដើម្បី​សុំ​ជំនួយ​អំពី​វិធី​ដំឡើង​កម្រិត​មេមឺរី PHP ។</target>
      </trans-unit>
      <trans-unit id="status_phpRegisterGlobals" resname="status_phpRegisterGlobals" approved="yes">
        <source>PHP Register Globals</source>
        <target state="final">PHP ចុះ​ឈ្មោះ​សកល</target>
      </trans-unit>
      <trans-unit id="status_phpRegisterGlobalsEnabled" resname="status_phpRegisterGlobalsEnabled" approved="yes">
        <source>%s is enabled. TYPO3 requires this configuration directive to be disabled.</source>
        <target state="final">%s បាន​បើក​ដំណើរការ ។ TYPO3 ត្រូវការ​ការខន់ហ្វីក​នេះ​ដើម្បី​បិទ​ដំណើរការ ។</target>
      </trans-unit>
      <trans-unit id="status_phpRegisterGlobalsSecurity" resname="status_phpRegisterGlobalsSecurity" approved="yes">
        <source>Your site may not be secure when %s is enabled.</source>
        <target state="final">វែបសាយ​របស់​អ្នក​ប្រហែល​មិន​មាន​សុវត្ថភាព ពេល​ %s ត្រូវ​បាន​ដាក់​ឱ្យ​ដំណើរការ ។</target>
      </trans-unit>
      <trans-unit id="status_phpRegisterGlobalsHowToChange" resname="status_phpRegisterGlobalsHowToChange" approved="yes">
        <source>how to change configuration settings</source>
        <target state="final">វិធី​ប្ដូរ​ការកំណត់​នៃ​ការខន់ហ្វីក</target>
      </trans-unit>
      <trans-unit id="status_phpRegisterGlobalsPHPManual" resname="status_phpRegisterGlobalsPHPManual" approved="yes">
        <source>The PHP manual has instructions for %s.</source>
        <target state="final">សៀវភៅ​ណែនាំ PHP ណែនាំ​សម្រាប់ %s ។</target>
      </trans-unit>
      <trans-unit id="status_webServer" resname="status_webServer" approved="yes">
        <source>Web Server</source>
        <target state="final">សឺវើ​វែប</target>
      </trans-unit>
      <trans-unit id="status_installEnabledTemporarily" resname="status_installEnabledTemporarily" approved="yes">
        <source>The Install Tool is temporarily enabled. Delete the file "%s" when you have finished setting up TYPO3. If not used the Install Tool will be disabled automatically in %s minutes.</source>
        <target state="final">ឧបករណ៍​ដំឡើង​បាន​បើក​ដំណើរការ​បណ្ដោះអាសន្ន ។ លុប​ហ្វៃល៍ "%s" ពេល​ដែល​អ្នក​ធ្វើការ​កំណត់​​លើ TYPO3 ចប់ ។ បើ​មិន​បាន​ប្រើ ឧបករណ៍​ដំឡើង​នឹង​បិទ​ដោយ​ខ្លួនឯង​ក្នុង​រយៈពេល %s នាទី ។</target>
      </trans-unit>
      <trans-unit id="status_configuration_PhpSafeModeEnabled" resname="status_configuration_PhpSafeModeEnabled" approved="yes">
        <source>PHP INI setting safe_mode "On" is deprecated since PHP 5.3 and is not supported by TYPO3 anymore.</source>
        <target state="final">ការកំណត់ PHP INI safe_mode "On" មិន​ត្រូវ​បាន​គាំទ្រ​​ឲ្យ​ប្រើ​ចាប់​ពី PHP 5.2 និង មិន​ត្រូវ​បាន​ឲ្យ​ប្រើ​ចាប់​ពី PHP 5.3 និង មិន​ត្រូវ​បាន​ប្រើ​វា​ទៀត​ទេ ។</target>
      </trans-unit>
      <trans-unit id="status_updateTaskTitle" resname="status_updateTaskTitle" approved="yes">
        <source>System Status Update</source>
        <target state="final">បច្ចុប្បន្នភាព​ស្ថានភាព​ប្រព័ន្ធ</target>
      </trans-unit>
      <trans-unit id="status_updateTaskDescription" resname="status_updateTaskDescription" approved="yes">
        <source>Runs a system status check and sends notifications if problems have been found.</source>
        <target state="final">ដំណើរការ​ការត្រួតពិនិត្យ​ស្ថានភាព​ប្រព័ន្ធ និង ផ្ញើ​ការជូនដំណឹង ប្រសិន​បើ​រក​ឃើញ​មាន​បញ្ហា ។</target>
      </trans-unit>
      <trans-unit id="status_updateTaskField_notificationEmail" resname="status_updateTaskField_notificationEmail" approved="yes">
        <source>Notification Email Address</source>
        <target state="final">អាសយដ្ឋាន​អ៊‍ីមេល​សម្រាប់​ជូន​ដំណឹង</target>
      </trans-unit>
      <trans-unit id="status_updateTaskField_notificationEmail_invalid" resname="status_updateTaskField_notificationEmail_invalid" approved="yes">
        <source>Empty or invalid notification email address.</source>
        <target state="final">អាសយដ្ឋាន​អ៊‍ីមេល​សម្រាប់​ជូន​ដំណឹង ទទេ ឬ មិន​ត្រឹមត្រូវ</target>
      </trans-unit>
      <trans-unit id="status_updateTask_email_subject" resname="status_updateTask_email_subject" approved="yes">
        <source>System Status Notification for site %s</source>
        <target state="final">ជូន​ដំណឹង​អំពី​ស្ថានភាព​ប្រព័ន្ធ​លើ​វែបសាយ %s</target>
      </trans-unit>
      <trans-unit id="status_updateTask_email_site" resname="status_updateTask_email_site" approved="yes">
        <source>Site</source>
        <target state="final">វែបសាយ</target>
      </trans-unit>
      <trans-unit id="status_updateTask_email_issues" resname="status_updateTask_email_issues" approved="yes">
        <source>Issues</source>
        <target state="final">ចេញ​ផ្សាយ</target>
      </trans-unit>
    </body>
  </file>
