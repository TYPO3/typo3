  <file t3:id="1415814842" source-language="en" datatype="plaintext" original="EXT:install/Resources/Private/Language/BackendModule.xlf" date="2011-10-17T20:22:33Z" product-name="install" target-language="t3">
    <header/>
    <body>
      <trans-unit id="mlang_labels_tablabel" resname="mlang_labels_tablabel">
        <source>Install Tool</source>
        <target>crwdns77404:0crwdne77404:0</target>
      </trans-unit>
      <trans-unit id="mlang_labels_tabdescr" resname="mlang_labels_tabdescr">
        <source>Provides a simple link to the Install Tool. Notice the Install Tool (in typo3/install/) must be enabled.&lt;br /&gt;&lt;em&gt;Access for 'admin' users only!&lt;/em&gt;</source>
        <target>crwdns77406:0crwdne77406:0</target>
      </trans-unit>
      <trans-unit id="mlang_tabs_tab" resname="mlang_tabs_tab">
        <source>Install</source>
        <target>crwdns77408:0crwdne77408:0</target>
      </trans-unit>
      <trans-unit id="confirmUnlockInstallToolTitle" resname="confirmUnlockInstallToolTitle">
        <source>The Install Tool is locked</source>
        <target>crwdns77410:0crwdne77410:0</target>
      </trans-unit>
      <trans-unit id="confirmUnlockInstallToolMessage" resname="confirmUnlockInstallToolMessage" xml:space="preserve">
				<source>&lt;p&gt;For security reasons the Install Tool is locked by default.&lt;/p&gt;
&lt;p&gt;To enable the Install Tool, the file &lt;strong&gt;ENABLE_INSTALL_TOOL&lt;/strong&gt; must be created in the directory &lt;strong&gt;typo3conf/&lt;/strong&gt;.&lt;/p&gt;
&lt;p&gt;Just click the button below, the file will be created for you and the Install Tool will be unlocked.&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;Security note: &lt;/strong&gt;When you are finished with your work, please log out of the Install Tool. Otherwise TYPO3 will automatically lock the Install Tool after one hour.&lt;/p&gt;
				</source>
			<target>crwdns77412:0crwdne77412:0
				</target></trans-unit>
      <trans-unit id="confirmUnlockInstallToolButton" resname="confirmUnlockInstallToolButton">
        <source>Unlock the Install&amp;#160;Tool</source>
        <target>crwdns77414:0crwdne77414:0</target>
      </trans-unit>
      <trans-unit id="cancel" resname="cancel">
        <source>Cancel</source>
        <target>crwdns122734:0crwdne122734:0</target>
      </trans-unit>
      <trans-unit id="confirm" resname="confirm">
        <source>Confirm</source>
        <target>crwdns122736:0crwdne122736:0</target>
      </trans-unit>
      <trans-unit id="sudoUserPasswordConfirm" resname="sudoUserPasswordConfirm">
        <source>Confirm with user password</source>
        <target>crwdns122738:0crwdne122738:0</target>
      </trans-unit>
      <trans-unit id="sudoInstallToolPasswordConfirm" resname="sudoInstallToolPasswordConfirm">
        <source>Confirm with Install Tool password</source>
        <target>crwdns122740:0crwdne122740:0</target>
      </trans-unit>
      <trans-unit id="sudoPasswordInvalid" resname="sudoPasswordConfirm">
        <source>Invalid password</source>
        <target>crwdns122742:0crwdne122742:0</target>
      </trans-unit>
      <trans-unit id="sudoUserPasswordMode" resname="sudoUserPasswordMode">
        <source>Use user password instead</source>
        <target>crwdns122744:0crwdne122744:0</target>
      </trans-unit>
      <trans-unit id="sudoInstallToolPasswordMode" resname="sudoInstallToolPasswordMode">
        <source>Use Install Tool password instead</source>
        <target>crwdns122746:0crwdne122746:0</target>
      </trans-unit>
