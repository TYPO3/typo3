        <target>crwdns374464:0%1$scrwdne374464:0</target>
      </trans-unit>
      <trans-unit id="widget.rss.noItems.title">
        <source>No items to display</source>
        <target>crwdns374466:0crwdne374466:0</target>
      </trans-unit>
      <trans-unit id="widget.rss.noItems.message">
