<?xml version="1.0" encoding="UTF-8"?>
<xliff xmlns:t3="http://typo3.org/schemas/xliff" version="1.0">
  <file t3:id="1415814821" source-language="en" datatype="plaintext" original="EXT:felogin/Resources/Private/Language/locallang.xlf" date="2011-10-17T20:22:32Z" product-name="felogin" target-language="et">
    <header/>
    <body>
      <trans-unit id="ll_welcome_header" resname="ll_welcome_header" approved="yes">
        <source>User login</source>
        <target state="final">Login</target>
      </trans-unit>
      <trans-unit id="ll_logout_header" resname="ll_logout_header" approved="yes">
        <source>You have logged out.</source>
        <target state="final">Oled välja logitud.</target>
      </trans-unit>
      <trans-unit id="ll_logout_message" resname="ll_logout_message" approved="yes">
        <source>You just logged out from your user session on this website. You can login again or as another user by the form below.</source>
        <target state="final">Logisid leheküljelt välja. Uuesti sisenemiseks kasuta login vormi.</target>
      </trans-unit>
      <trans-unit id="ll_error_header" resname="ll_error_header" approved="yes">
        <source>Login failure</source>
        <target state="final">Login ebaõnnestus</target>
      </trans-unit>
      <trans-unit id="ll_error_message" resname="ll_error_message" xml:space="preserve" approved="yes">
				<source>An error occurred during login. Most likely you didn't enter the username or password correctly.
Be certain that you enter them precisely as they are, including upper/lower case.
Another possibility is that cookies might be disabled in your web browser.</source>
			<target state="final">Viga. Tõenäoliselt on viga kasutajanimes ja/või paroolis.Veendu mõlema õigsuses ja arvesta ka suur- ja väiketähtedega.Veebilehitsejal peavad olema lubatud küpsised.</target></trans-unit>
      <trans-unit id="ll_success_header" resname="ll_success_header" approved="yes">
        <source>Login successful</source>
        <target state="final">Login õnnestus</target>
      </trans-unit>
      <trans-unit id="ll_success_message" resname="ll_success_message" approved="yes">
        <source>You are now logged in as '###USER###'</source>
        <target state="final">Sisenesid kasutajana '###USER###'</target>
      </trans-unit>
      <trans-unit id="ll_status_header" resname="ll_status_header" approved="yes">
        <source>Current status</source>
        <target state="final">Staatus</target>
      </trans-unit>
      <trans-unit id="cookie_warning" resname="cookie_warning" approved="yes">
        <source>Warning: There is a possibility that cookies are not enabled in your web browser! If your login disappears on your next click that is the case and you should enable cookies (or accept cookies from this website) immediately!</source>
        <target state="final">Hoiatus: Võimalik, et sinu veebilehitsejas ei ole lubatud küpsised. Kui sinud logitakse välja järgmisel klikkimisel veendu, et küpsiste kasutamine oleks lubatud.</target>
      </trans-unit>
      <trans-unit id="login" resname="login" approved="yes">
        <source>Login</source>
        <target state="final">Login</target>
      </trans-unit>
      <trans-unit id="logout" resname="logout" approved="yes">
        <source>Logout</source>
        <target state="final">Logout</target>
      </trans-unit>
      <trans-unit id="send_password" resname="send_password" approved="yes">
        <source>Send password</source>
        <target state="final">Saada parool</target>
      </trans-unit>
      <trans-unit id="reset_password" resname="reset_password" approved="yes">
        <source>Reset Password</source>
        <target state="final">Uuenda parool</target>
      </trans-unit>
      <trans-unit id="ll_change_password_header" resname="ll_change_password_header" approved="yes">
        <source>Change your password</source>
        <target state="final">Muuda parooli</target>
      </trans-unit>
      <trans-unit id="ll_change_password_message" resname="ll_change_password_message" approved="yes">
        <source>Please enter your new password twice. Password needs a minimum length of %s chars.</source>
        <target state="final">Palun sisesta uus parool kordusega. Parooli minimaalne pikkus on %s märki.</target>
      </trans-unit>
      <trans-unit id="change_password" resname="change_password" approved="yes">
        <source>Change your password</source>
        <target state="final">Muuda parooli</target>
      </trans-unit>
      <trans-unit id="newpassword_label1" resname="newpassword_label1" approved="yes">
        <source>Enter new password</source>
        <target state="final">Uus parool</target>
      </trans-unit>
      <trans-unit id="newpassword_label2" resname="newpassword_label2" approved="yes">
        <source>Repeat new password</source>
        <target state="final">Korda uut parooli</target>
      </trans-unit>
      <trans-unit id="ll_forgot_header" resname="ll_forgot_header" approved="yes">
        <source>Forgot your password?</source>
        <target state="final">Unustasid parooli?</target>
      </trans-unit>
      <trans-unit id="ll_forgot_header_backToLogin" resname="ll_forgot_header_backToLogin" approved="yes">
        <source>Return to login form</source>
        <target state="final">Tagasi login vormi</target>
      </trans-unit>
    </body>
  </file>
</xliff>
