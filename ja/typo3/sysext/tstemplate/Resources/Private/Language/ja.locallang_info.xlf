        <target state="final">現在のページの選択したTypoScriptレコードの内容を変更します。 TypoScript定数のような構成やセットアップ、TypoScriptレコードのタイトルや説明などの基本的な構成に変更を加えることができます。</target>
      </trans-unit>
      <trans-unit id="options.selectedRecord" approved="yes">
        <source>Selected record</source>
        <target state="final">選択済レコード</target>
      </trans-unit>
      <trans-unit id="table.column.constants" approved="yes">
        <source>Constants</source>
        <target state="final">定数</target>
      </trans-unit>
      <trans-unit id="table.column.description" approved="yes">
        <source>Description</source>
        <target state="final">説明</target>
      </trans-unit>
      <trans-unit id="table.column.lines" approved="yes">
        <source>%s lines</source>
        <target state="final">%s 行</target>
      </trans-unit>
