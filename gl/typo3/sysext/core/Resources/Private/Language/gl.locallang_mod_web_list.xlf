        <target state="final">Predeterminado</target>
      </trans-unit>
      <trans-unit id="multipleLanguages" resname="multipleLanguages" approved="yes">
        <source>All languages</source>
        <target state="final">Todos os idiomas</target>
      </trans-unit>
    </body>
