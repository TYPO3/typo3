        <target state="final">Προεπιλεγμένο</target>
      </trans-unit>
      <trans-unit id="multipleLanguages" approved="yes">
        <source>All languages</source>
        <target state="final">Όλες οι γλώσσες</target>
      </trans-unit>
      <trans-unit id="viewRecords" approved="yes">
        <source>Viewing records of</source>
        <target state="final">Εμφανίζονται εγγραφές από</target>
      </trans-unit>
