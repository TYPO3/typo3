        <target state="final">पृष्ठ'###title###' (id=###uid###) हटा दिया गया है।</target>
      </trans-unit>
      <trans-unit id="list.report.pagenotvisible" approved="yes">
        <source>Page '###title###' (id=###uid###) is not visible.</source>
        <target state="final">पृष्ठ '###title###' (id=###uid###) दृश्यमान नहीं है।</target>
      </trans-unit>
