        <target state="final">बहुविकल्पीय (300)।</target>
      </trans-unit>
      <trans-unit id="list.report.error.httpstatuscode.305" approved="yes">
        <source>Use proxy (305).</source>
        <target state="final">प्रॉक्सी का उपयोग करें (305)।</target>
      </trans-unit>
