<?xml version="1.0" encoding="UTF-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" version="1.2">
  <file source-language="en" datatype="plaintext" original="EXT:indexed_search/Resources/Private/Language/locallang_db.xlf" date="2011-10-17T20:22:33Z" product-name="indexed_search" target-language="hi">
    <header/>
    <body>
      <trans-unit id="index_config" resname="index_config" approved="yes">
        <source>Indexing Configuration</source>
        <target state="final">इंडेक्सिंग कॉन्फ़िगरेशन</target>
      </trans-unit>
      <trans-unit id="index_config.title" resname="index_config.title" approved="yes">
        <source>Title</source>
        <target state="final">टाइटल</target>
      </trans-unit>
      <trans-unit id="index_config.description" resname="index_config.description" approved="yes">
        <source>Description</source>
        <target state="final">विवरण</target>
      </trans-unit>
      <trans-unit id="index_config.type.I.1" resname="index_config.type.I.1" approved="yes">
        <source>Database Records</source>
        <target state="final">डेटाबेस रिकार्ड्स</target>
      </trans-unit>
      <trans-unit id="index_config.type.I.2" resname="index_config.type.I.2" approved="yes">
        <source>Filepath on server</source>
        <target state="final">सर्वर पर फ़ाइल पथ</target>
      </trans-unit>
      <trans-unit id="index_config.type.I.3" resname="index_config.type.I.3" approved="yes">
        <source>External URL</source>
        <target state="final">बाहरी URL</target>
      </trans-unit>
      <trans-unit id="index_config.type.I.4" resname="index_config.type.I.4" approved="yes">
        <source>Page tree</source>
        <target state="final">पेज ट्री</target>
      </trans-unit>
      <trans-unit id="index_config.type.I.5" resname="index_config.type.I.5" approved="yes">
        <source>Meta configuration</source>
        <target state="final">मेटा कॉन्फ़िगरेशन</target>
      </trans-unit>
      <trans-unit id="index_config.type" resname="index_config.type" approved="yes">
        <source>Type</source>
        <target state="final">प्रकार</target>
      </trans-unit>
      <trans-unit id="index_config.depth" resname="index_config.depth" approved="yes">
        <source>Depth</source>
        <target state="final">गहराई</target>
      </trans-unit>
      <trans-unit id="index_config.table2index" resname="index_config.table2index" approved="yes">
        <source>Table to index</source>
        <target state="final">अनुक्रमणिका के लिए टेबल</target>
      </trans-unit>
      <trans-unit id="index_config.alternative_source_pid" resname="index_config.alternative_source_pid" approved="yes">
        <source>Alternative Source Page</source>
        <target state="final">वैकल्पिक स्रोत पृष्ठ</target>
      </trans-unit>
      <trans-unit id="index_config.get_params" resname="index_config.get_params" approved="yes">
        <source>GET parameter string (with ###UID### substitution)</source>
        <target state="final">GET पैरामीटर स्ट्रिंग (###UID### प्रतिस्थापन के साथ)</target>
      </trans-unit>
      <trans-unit id="index_config.fields" resname="index_config.fields" approved="yes">
        <source>Fields (first is title)</source>
        <target state="final">फ़ील्ड (पहला शीर्षक है)</target>
      </trans-unit>
      <trans-unit id="index_config.externalUrl" resname="index_config.externalUrl" approved="yes">
        <source>External URL (eg. "http://www.domain.org/")</source>
        <target state="final">बाहरी URL (उदाहरणार्थ "http://www.domain.org/")</target>
      </trans-unit>
      <trans-unit id="index_config.filepath" resname="index_config.filepath" approved="yes">
        <source>Filepath</source>
        <target state="final">फाइलपथ</target>
      </trans-unit>
      <trans-unit id="index_config.extensions" resname="index_config.extensions" approved="yes">
        <source>Limit to extensions (commalist)</source>
        <target state="final">एक्सटेंशन तक सीमित करें (कॉमा से अलग की गई सूची)</target>
      </trans-unit>
      <trans-unit id="index_config.url_deny" resname="index_config.url_deny" approved="yes">
        <source>Enter sub-URLs in which not to decend</source>
        <target state="final">वे उप-URL दर्ज करें जिनमें आगे नेविगेट (descend) नहीं करना है।</target>
      </trans-unit>
      <trans-unit id="index_config.records_indexonchange" resname="index_config.records_indexonchange" approved="yes">
        <source>Index Records immediately when saved?</source>
        <target state="final">क्या रिकॉर्ड को सहेजते समय तुरन्त अनुक्रमित किया जा सकता है?</target>
      </trans-unit>
      <trans-unit id="index_config.timer_next_indexing" resname="index_config.timer_next_indexing" approved="yes">
        <source>Next indexing is scheduled (if empty, then immediately)</source>
        <target state="final">अगला अनुक्रमण निर्धारित है (यदि रिक्त है, तो तुरंत)</target>
      </trans-unit>
      <trans-unit id="index_config.timer_offset" resname="index_config.timer_offset" approved="yes">
        <source>Timing offset from midnight</source>
        <target state="final">समय मध्यरात्रि से ऑफसेट</target>
      </trans-unit>
      <trans-unit id="index_config.timer_frequency" resname="index_config.timer_frequency" approved="yes">
        <source>How often would you like a re-index?</source>
        <target state="final">आप कितनी बार पुनः सूचीकरण चाहेंगे?</target>
      </trans-unit>
      <trans-unit id="index_config.timer_frequency.I.0" resname="index_config.timer_frequency.I.0" approved="yes">
        <source>Every hour</source>
        <target state="final">प्रत्येक घंटे</target>
      </trans-unit>
      <trans-unit id="index_config.timer_frequency.I.1" resname="index_config.timer_frequency.I.1" approved="yes">
        <source>Every day (24 hours)</source>
        <target state="final">हर दिन (24 घंटे)</target>
      </trans-unit>
      <trans-unit id="index_config.timer_frequency.I.2" resname="index_config.timer_frequency.I.2" approved="yes">
        <source>Every week</source>
        <target state="final">प्रत्येक सप्ताह</target>
      </trans-unit>
      <trans-unit id="index_config.recordsbatch" resname="index_config.recordsbatch" approved="yes">
        <source>How many records to index a minute (default is 100)</source>
        <target state="final">एक मिनट में कितने रिकॉर्ड को अनुक्रमित करना है (डिफ़ॉल्ट 100 है)</target>
      </trans-unit>
      <trans-unit id="index_config.set_id" resname="index_config.set_id" approved="yes">
        <source>Session ID (if &gt; zero, then indexing job is running)</source>
        <target state="final">सेशन ID (यदि 0 से बड़ा है, तो इंडेक्सिंग जॉब चल रहा है)</target>
      </trans-unit>
      <trans-unit id="index_config.indexcfgs" resname="index_config.indexcfgs" approved="yes">
        <source>Indexing configurations</source>
        <target state="final">अनुक्रमण कॉन्फ़िगरेशन</target>
      </trans-unit>
      <trans-unit id="index_config.parameterCfgs" resname="index_config.parameterCfgs" approved="yes">
        <source>Parameter combination configuration ([tablename]:&amp;[param]=###UID###)</source>
        <target state="final">पैरामीटर संयोजन कॉन्फ़िगरेशन ([tablename]:&amp;[param]=###UID###)</target>
      </trans-unit>
      <trans-unit id="index_config.rootpage" resname="index_config.rootpage" approved="yes">
        <source>Root page</source>
        <target state="final">मूल पृष्ठ</target>
      </trans-unit>
    </body>
