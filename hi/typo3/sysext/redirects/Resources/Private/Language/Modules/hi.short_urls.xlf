<?xml version="1.0" encoding="UTF-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" version="1.2">
  <file source-language="en" datatype="plaintext" original="EXT:redirects/Resources/Private/Language/Modules/short_urls.xlf" date="2025-11-13T18:00:15Z" product-name="redirects" target-language="hi">
    <header/>
    <body>
      <trans-unit id="title" approved="yes">
        <source>Short URLs</source>
        <target state="final">संक्षिप्त URLs</target>
      </trans-unit>
      <trans-unit id="short_description" approved="yes">
        <source>Short URLs Administration</source>
        <target state="final">संक्षिप्त URLs प्रशासन</target>
      </trans-unit>
      <trans-unit id="description" approved="yes">
        <source>Create and manage Short URLs that redirect to longer links for easier sharing and tracking.</source>
        <target state="final">आसान शेयरिंग और ट्रैकिंग के लिए, संक्षिप्त URLs बनाएं और प्रबंधित करें जो लंबे लिंक पर रीडायरेक्ट करते हैं।</target>
      </trans-unit>
      <trans-unit id="heading_text" approved="yes">
        <source>Short URL Management</source>
        <target state="final">संक्षिप्त URL प्रबंधन</target>
      </trans-unit>
      <trans-unit id="add_text" approved="yes">
        <source>Add Short URL</source>
        <target state="final">संक्षिप्त URL जोड़ें</target>
      </trans-unit>
      <trans-unit id="not_found_with_filter.message" approved="yes">
        <source>No Short URL could be found with the current set of filters applied.</source>
        <target state="final">वर्तमान में लागू किए गए फ़िल्टरों के साथ कोई संक्षिप्त URL नहीं मिल सका।</target>
      </trans-unit>
      <trans-unit id="not_found.title" approved="yes">
        <source>No Short URLs found</source>
        <target state="final">कोई संक्षिप्त URL नहीं मिला</target>
      </trans-unit>
      <trans-unit id="not_found.message" approved="yes">
        <source>There are currently no Short URLs found in the database.</source>
        <target state="final">डेटाबेस में फिलहाल कोई संक्षिप्त URL नहीं मिला है।</target>
      </trans-unit>
      <trans-unit id="create" approved="yes">
        <source>Create new Short URL</source>
        <target state="final">नया संक्षिप्त URL  बनाएं</target>
      </trans-unit>
      <trans-unit id="delete.title" approved="yes">
        <source>Delete Short URLs</source>
        <target state="final">संक्षिप्त URLs हटाएँ</target>
      </trans-unit>
      <trans-unit id="delete.message" approved="yes">
        <source>Delete all marked Short URLs permanently? You cannot undo this action.</source>
        <target state="final">क्या आप सभी चिह्नित संक्षिप्त URLs  को स्थायी रूप से हटाना चाहते हैं? आप इस कार्रवाई को पूर्ववत नहीं कर सकते।</target>
      </trans-unit>
      <trans-unit id="show" approved="yes">
        <source>Show Short URL</source>
        <target state="final">संक्षिप्त URL दिखाएँ</target>
      </trans-unit>
      <trans-unit id="generate_short_url" approved="yes">
        <source>Generate Short URL</source>
        <target state="final">संक्षिप्त URL जनरेट करें</target>
      </trans-unit>
      <trans-unit id="validation.duplicate_short_url" approved="yes">
        <source>This Short URL already exists. Please choose a different source host or source path.</source>
        <target state="final">यह संक्षिप्त URL पहले से मौजूद है। कृपया कोई दूसरा स्रोत होस्ट या स्रोत पथ चुनें।</target>
      </trans-unit>
    </body>
  </file>
</xliff>
