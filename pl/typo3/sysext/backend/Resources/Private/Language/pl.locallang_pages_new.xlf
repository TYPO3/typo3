        <source>No pages were created.</source>
        <target state="final">Nie utworzono żadnej strony.</target>
      </trans-unit>
      <trans-unit id="pagesCreated.title" approved="yes">
        <source>Pages added</source>
        <target state="final">Strony dodane</target>
      </trans-unit>
