        <source>Insufficient permissions</source>
        <target state="final">Niewystarczające uprawnienia</target>
      </trans-unit>
      <trans-unit id="canNotCreateNew.message" approved="yes">
        <source>Sorry, you are not allowed to create new subpages to this page due to access restrictions.</source>
        <target state="final">Niestety, nie możesz tworzyć nowych podstron na tej stronie ze względu na ograniczenia dostępu.</target>
      </trans-unit>
      <trans-unit id="newPage" approved="yes">
        <source>Page</source>
        <target state="final">Strona</target>
      </trans-unit>
      <trans-unit id="addMoreLines" approved="yes">
        <source>Add more lines</source>
        <target state="final">Dodaj więcej wierszy</target>
      </trans-unit>
