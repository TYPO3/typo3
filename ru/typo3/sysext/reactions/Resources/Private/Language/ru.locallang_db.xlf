<?xml version="1.0" encoding="UTF-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" version="1.2">
  <file source-language="en" datatype="plaintext" original="EXT:reactions/Resources/Private/Language/locallang_db.xlf" date="2022-08-15T20:22:32Z" product-name="reactions" target-language="ru">
    <header/>
    <body>
      <trans-unit id="reactions" approved="yes">
        <source>Reactions</source>
        <target state="final">Реакции</target>
      </trans-unit>
      <trans-unit id="sys_reaction" approved="yes">
        <source>System Reactions</source>
        <target state="final">Системные реакции</target>
      </trans-unit>
      <trans-unit id="sys_reaction.name" approved="yes">
        <source>Name</source>
        <target state="final">Название</target>
      </trans-unit>
      <trans-unit id="sys_reaction.name.description" approved="yes">
        <source>Meaningful name of the reaction</source>
        <target state="final">Понятное название реакции</target>
      </trans-unit>
      <trans-unit id="sys_reaction.identifier" approved="yes">
        <source>Identifier</source>
        <target state="final">Идентификатор</target>
      </trans-unit>
      <trans-unit id="sys_reaction.identifier.description" approved="yes">
        <source>This is your unique reaction identifier within the TYPO3 URL</source>
        <target state="final">Это ваш уникальный идентификатор реакции в URL TYPO3</target>
      </trans-unit>
      <trans-unit id="sys_reaction.secret" approved="yes">
        <source>Secret</source>
        <target state="final">Секрет</target>
      </trans-unit>
      <trans-unit id="sys_reaction.secret.description" approved="yes">
        <source>The secret is required to call the reaction from the outside. The secret can be re-created anytime, but will only be visible once (until the record got saved).</source>
        <target state="final">Секрет необходим для вызова реакции извне. Секрет может быть воссоздан в любое время, но виден он только единожды (при сохранении записи).</target>
      </trans-unit>
      <trans-unit id="sys_reaction.secret.passwordGenerator" approved="yes">
        <source>Generate secret token</source>
        <target state="final">Сгенерировать секретный токен</target>
      </trans-unit>
      <trans-unit id="sys_reaction.reaction_type" approved="yes">
        <source>Reaction Type</source>
        <target state="final">Тип реакции</target>
      </trans-unit>
      <trans-unit id="sys_reactions.reaction_type.description" approved="yes">
        <source>Select the reaction type to be configured.</source>
        <target state="final">Выберите тип реакции для настройки.</target>
      </trans-unit>
      <trans-unit id="sys_reaction.reaction_type.select" approved="yes">
        <source>Select a reaction</source>
        <target state="final">Выберите реакцию</target>
      </trans-unit>
      <trans-unit id="sys_reaction.reaction_type.create_record" approved="yes">
        <source>Create database record</source>
        <target state="final">Создать запись базы данных</target>
      </trans-unit>
      <trans-unit id="sys_reaction.impersonate_user" approved="yes">
        <source>Impersonate User</source>
        <target state="final">Представиться как пользователь</target>
      </trans-unit>
      <trans-unit id="sys_reaction.impersonate_user.description" approved="yes">
        <source>Select the user with the appropriate access rights that is allowed to add a record of this type. If in doubt, use the CLI user.</source>
        <target state="final">Выберите пользователя с соответствующими правами доступа, которым разрешено добавлять записи этого типа. Если есть сомнения, используйте пользователя CLI.</target>
      </trans-unit>
      <trans-unit id="sys_reaction.last_called" approved="yes">
        <source>Last called</source>
        <target state="final">Последний вызов</target>
      </trans-unit>
      <trans-unit id="sys_reaction.last_status" approved="yes">
        <source>Status of the last call</source>
        <target state="final">Статус последнего вызова</target>
      </trans-unit>
      <trans-unit id="sys_reaction.last_failure" approved="yes">
        <source>Reason the last call failed</source>
        <target state="final">Причина, по которой последний вызов завершился неудачно</target>
      </trans-unit>
      <trans-unit id="sys_reaction.table_name" approved="yes">
        <source>Table</source>
        <target state="final">Таблица</target>
      </trans-unit>
      <trans-unit id="sys_reaction.table_name.description" approved="yes">
        <source>Select one tables to display the corresponding fields.</source>
        <target state="final">Выберите одну таблицу для отображения соответствующих полей.</target>
      </trans-unit>
      <trans-unit id="sys_reaction.table_name.select" approved="yes">
        <source>Select a table</source>
        <target state="final">Выберите таблицу</target>
      </trans-unit>
      <trans-unit id="sys_reaction.storage_pid" approved="yes">
        <source>Storage PID</source>
        <target state="final">PID хранилища</target>
      </trans-unit>
      <trans-unit id="sys_reaction.storage_pid.description" approved="yes">
        <source>Select the page on which a new record is created on.</source>
        <target state="final">Выберите страницу, на которой создается новая запись.</target>
      </trans-unit>
      <trans-unit id="sys_reaction.fields" approved="yes">
        <source>Fields</source>
        <target state="final">Поля</target>
      </trans-unit>
      <trans-unit id="sys_reaction.fields.description" approved="yes">
        <source>Which fields are offered depends on the selected table. Each field is either fixed to a value, filled from the request with a placeholder such as ${foo.bar} addressing a key of the payload the caller sends, or not set at all. A field that is not set, and one whose placeholder the request does not carry, keeps the default of the table.</source>
        <target state="final">Какие поля будут доступны, зависит от выбранной таблицы.  Каждое поле имеет либо фиксированное значение, либо заполняется из запроса с помощью заполнителя, например ${foo.bar}, указывающего на ключ в отправляемых данных, либо не задается вовсе.  Для незаданного поля, у которого в запросе нет заполнителя, используется значение по умолчанию из таблицы.</target>
      </trans-unit>
      <trans-unit id="palette.config" approved="yes">
        <source>Configuration</source>
        <target state="final">Конфигурация</target>
      </trans-unit>
      <trans-unit id="palette.config.description" approved="yes">
        <source>General configuration of the reaction.</source>
        <target state="final">Основные настройки реакции.</target>
      </trans-unit>
      <trans-unit id="palette.additional" approved="yes">
        <source>Additional configuration</source>
        <target state="final">Дополнительная конфигурация</target>
      </trans-unit>
      <trans-unit id="palette.additional.description" approved="yes">
        <source>Specific configuration for the selected reaction type</source>
        <target state="final">Определенная конфигурация для выбранного типа реакции</target>
      </trans-unit>
      <trans-unit id="fieldMapElement.noFields" approved="yes">
        <source>The selected table '%s' does not define any valid fields to be configured.</source>
        <target state="final">В выбранной таблице '%s' не определены допустимые поля для настройки.</target>
      </trans-unit>
      <trans-unit id="fieldMapElement.valueSource" approved="yes">
        <source>Value source</source>
        <target state="final">Источник значения</target>
      </trans-unit>
      <trans-unit id="fieldMapElement.valueSource.unset" approved="yes">
        <source>Do not set</source>
        <target state="final">Не установлено</target>
      </trans-unit>
      <trans-unit id="fieldMapElement.valueSource.fixed" approved="yes">
        <source>Fixed value</source>
        <target state="final">Фиксированное значение</target>
      </trans-unit>
      <trans-unit id="fieldMapElement.valueSource.payload" approved="yes">
        <source>Payload value</source>
        <target state="final">Значение из содержимого</target>
      </trans-unit>
      <trans-unit id="fieldMapElement.valueSource.payload.inverted" approved="yes">
        <source>This field is displayed inverted, so the value 1 means the opposite of the label above.</source>
        <target state="final">Это поле отображается инвертированным, поэтому значение 1 обозначает противоположность ярлыку выше.</target>
      </trans-unit>
    </body>
  </file>
</xliff>
