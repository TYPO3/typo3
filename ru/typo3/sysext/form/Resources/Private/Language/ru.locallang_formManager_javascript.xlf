        <source>Form created</source>
        <target state="final">Форма создана</target>
      </trans-unit>
      <trans-unit id="formManager.finisher.redirect.success.description" approved="yes">
        <source>The form has been successfully created. Click "Finish" to be redirected to the newly created form.</source>
        <target state="final">Форма успешно создана. Нажмите «Готово», чтобы перейти к новой форме.</target>
