<?xml version="1.0" encoding="UTF-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" version="1.2">
  <file source-language="en" datatype="plaintext" original="EXT:recycler/Resources/Private/Language/locallang_tasks.xlf" date="2011-10-17T20:22:35Z" product-name="recycler" target-language="ru">
    <header/>
    <body>
      <trans-unit id="cleanerTaskTitle" approved="yes">
        <source>Remove deleted records</source>
        <target state="final">Удалить удаленные записи</target>
      </trans-unit>
      <trans-unit id="cleanerTaskDescription" approved="yes">
        <source>Deletes rows from the database which are flagged as "deleted"</source>
        <target state="final">Удаляет строки из базы данных, помеченные как «удалённые»</target>
      </trans-unit>
      <trans-unit id="cleanerTaskPeriod" approved="yes">
        <source>Delete entries older than (in days)</source>
        <target state="final">Удалить записи старше (в днях)</target>
      </trans-unit>
      <trans-unit id="cleanerTaskTCA" approved="yes">
        <source>Tables</source>
        <target state="final">Таблицы</target>
      </trans-unit>
      <trans-unit id="cleanerTaskDescriptionTables" approved="yes">
        <source>Tables: %s</source>
        <target state="final">Таблицы: %s</target>
      </trans-unit>
      <trans-unit id="cleanerTaskDescriptionDays" approved="yes">
        <source>Older than %d day(s)</source>
        <target state="final">Старше %d дня(ей)</target>
      </trans-unit>
      <trans-unit id="cleanerTaskErrorPeriod" approved="yes">
        <source>The period has to be an integer and greater than zero.</source>
        <target state="final">Период должен быть целым числом и больше нуля.</target>
      </trans-unit>
      <trans-unit id="cleanerTaskErrorTCAempty" approved="yes">
        <source>You have to select at least one table.</source>
        <target state="final">Необходимо выбрать хотя бы одну таблицу.</target>
      </trans-unit>
      <trans-unit id="cleanerTaskErrorTCANotSet" approved="yes">
        <source>The table "%s" is not in the TCA.</source>
        <target state="final">Таблица "%s" не находится в TCA.</target>
      </trans-unit>
    </body>
  </file>
</xliff>
