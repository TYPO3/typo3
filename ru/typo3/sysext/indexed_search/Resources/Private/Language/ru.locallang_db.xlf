      </trans-unit>
      <trans-unit id="index_config.timer_frequency.I.0" resname="index_config.timer_frequency.I.0" approved="yes">
        <source>Every hour</source>
        <target state="final">Раз в час</target>
      </trans-unit>
      <trans-unit id="index_config.timer_frequency.I.1" resname="index_config.timer_frequency.I.1" approved="yes">
        <source>Every day (24 hours)</source>
        <target state="final">Раз в сутки</target>
      </trans-unit>
      <trans-unit id="index_config.timer_frequency.I.2" resname="index_config.timer_frequency.I.2" approved="yes">
