  <file source-language="en" datatype="plaintext" original="EXT:linkvalidator/Resources/Private/Language/Module/locallang.xlf" date="2011-10-17T20:22:34Z" product-name="linkvalidator" target-language="ru">
    <header/>
    <body>
      <trans-unit id="linkvalidator" approved="yes">
        <source>LinkValidator</source>
        <target state="final">Проверка ссылок</target>
      </trans-unit>
      <trans-unit id="overview.headline" approved="yes">
        <source>Link check</source>
        <target state="final">Проверка ссылок</target>
      </trans-unit>
      <trans-unit id="overview.headlineWithPageTitle" approved="yes">
        <source>Link check of page "%s"</source>
        <target state="final">Проверка ссылок страницы "%s"</target>
      </trans-unit>
      <trans-unit id="hooks.db" approved="yes">
        <source>Internal Links</source>
        <target state="final">Внутренние ссылки</target>
      </trans-unit>
      <trans-unit id="hooks.file" approved="yes">
        <source>File Links</source>
        <target state="final">Ссылки на файлы</target>
      </trans-unit>
      <trans-unit id="hooks.record" approved="yes">
        <source>Record Links</source>
        <target state="final">Запись ссылок</target>
      </trans-unit>
      <trans-unit id="hooks.external" approved="yes">
        <source>External Links</source>
        <target state="final">Внешние ссылки</target>
      </trans-unit>
      <trans-unit id="filter.depth" approved="yes">
        <source>Depth</source>
        <target state="final">Глубина</target>
      </trans-unit>
      <trans-unit id="filter.type" approved="yes">
