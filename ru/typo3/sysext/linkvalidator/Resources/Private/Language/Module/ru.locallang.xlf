      </trans-unit>
      <trans-unit id="filter.btn.filter" approved="yes">
        <source>Filter</source>
        <target state="final">Фильтр</target>
      </trans-unit>
      <trans-unit id="label_update" approved="yes">
        <source>Check</source>
        <target state="final">Проверка</target>
