        <target state="final">Set up MFA</target>
      </trans-unit>
      <trans-unit id="standalone.selection.message" approved="yes">
        <source>
          %s requires you setting up MFA to secure your account. Please select one of the available providers below.
        </source>
        <target state="final">
         %s требует настроить MFA для защиты вашей учетной записи. Пожалуйста, выберите одного из доступных поставщиков услуг, указанных ниже.
        </target>
      </trans-unit>
      <trans-unit id="standalone.selection.goBack" approved="yes">
