        <target state="final">Отсутствуют разрешения для папки</target>
      </trans-unit>
      <trans-unit id="missingFolderPermissionsMessage" resname="missingFolderPermissionsMessage" approved="yes">
        <source>You have no access to the folder "%s".</source>
        <target state="final">У вас нет доступа к папке "%s".</target>
      </trans-unit>
      <trans-unit id="localStorageOfflineTitle" resname="localStorageOfflineTitle" approved="yes">
        <source>Base folder for local storage missing or not allowed</source>
        <target state="final">Базовая папка для локального хранилища отсутствует или не разрешена для доступа</target>
      </trans-unit>
      <trans-unit id="localStorageOfflineMessage" resname="localStorageOfflineMessage" approved="yes">
        <source>Verify that the base folder for the storage "%s" exists and is allowed to be accessed.</source>
        <target state="final">Проверьте существование базовой папки для хранилища "%s" и разрешения для доступа к ней.</target>
      </trans-unit>
      <trans-unit id="folderNotFoundTitle" resname="folderNotFoundTitle" approved="yes">
        <source>Folder not found.</source>
        <target state="final">Доступ к папке запрещён.</target>
      </trans-unit>
      <trans-unit id="folderNotFoundMessage" resname="folderNotFoundMessage" approved="yes">
        <source>The folder "%s" cannot be accessed. Trying to use parent folder(s).</source>
        <target state="final">Не может быть получен доступ к папке "%s".</target>
      </trans-unit>
      <trans-unit id="translateMetadata" resname="translateMetadata" approved="yes">
        <source>Translate metadata</source>
        <target state="final">Перевод метаданных</target>
      </trans-unit>
      <trans-unit id="createMetadataForLanguage" resname="createMetadataForLanguage" approved="yes">
        <source>Create metadata of this file for %s</source>
        <target state="final">Создайте метаданные этого файла для %s</target>
      </trans-unit>
      <trans-unit id="editMetadataForLanguage" resname="editMetadataForLanguage" approved="yes">
        <source>Edit metadata of this file for %s</source>
        <target state="final">Правка метаданных этого файла для %s</target>
      </trans-unit>
      <trans-unit id="paramError" resname="paramError" approved="yes">
        <source>Parameter Error</source>
        <target state="final">Ошибка параметра</target>
      </trans-unit>
      <trans-unit id="targetNoDir" resname="targetNoDir" approved="yes">
        <source>Target was not a directory!</source>
        <target state="final">Цель не является директорией!</target>
      </trans-unit>
