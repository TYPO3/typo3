    <header/>
    <body>
      <trans-unit id="short_description" approved="yes">
        <source>Shows database record statistics</source>
        <target state="final">Показывает статистику записей в базе данных</target>
      </trans-unit>
      <trans-unit id="description" approved="yes">
        <source>Get statistics for database records, including total, translated, hidden, and deleted pages, page type distribution, and and detailed table records with lost record detection. The report analyzes the entire page tree.</source>
        <target state="final">Предоставляет полную аналитику всех записей в базе данных, включая переведенные, скрытые и удаленные страницы. Отчет также включает распределение типов страниц и подробные таблицы с идентификацией утерянных записей. Анализ охватывает всю структуру страниц.</target>
      </trans-unit>
      <trans-unit id="title" approved="yes">
        <source>Record Statistics</source>
        <target state="final">Статистика записей</target>
      </trans-unit>
      <trans-unit id="doktype" approved="yes">
        <source>Document types</source>
        <target state="final">Типы документов</target>
      </trans-unit>
      <trans-unit id="doktype_value" approved="yes">
        <source>Document types (value)</source>
        <target state="final">Типы документов (значение)</target>
      </trans-unit>
      <trans-unit id="count" approved="yes">
        <source>Count</source>
        <target state="final">Количество</target>
      </trans-unit>
      <trans-unit id="pages" approved="yes">
        <source>Pages</source>
        <target state="final">Страниц</target>
      </trans-unit>
      <trans-unit id="total_pages" approved="yes">
