<?xml version="1.0" encoding="UTF-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" version="1.2">
  <file source-language="en" datatype="plaintext" original="EXT:redirects/Resources/Private/Language/Modules/qrcodes.xlf" date="2025-11-13T18:00:15Z" product-name="redirects" target-language="ru">
    <header/>
    <body>
      <trans-unit id="title" approved="yes">
        <source>QR Codes</source>
        <target state="final">QR-коды</target>
      </trans-unit>
      <trans-unit id="short_description" approved="yes">
        <source>QR Codes Administration</source>
        <target state="final">Управление QR-кодами</target>
      </trans-unit>
      <trans-unit id="description" approved="yes">
        <source>Generate and customize QR codes to provide quick, scannable access to your digital content.</source>
        <target state="final">Создавайте и настраивайте QR-коды для быстрого доступа к вашми материалам в электронном виде.</target>
      </trans-unit>
      <trans-unit id="heading_text" approved="yes">
        <source>QR Code Management</source>
        <target state="final">Управление QR-кодом</target>
      </trans-unit>
      <trans-unit id="add_text" approved="yes">
        <source>Add QR Code</source>
        <target state="final">Добавить QR-код</target>
      </trans-unit>
      <trans-unit id="not_found_with_filter.message" approved="yes">
        <source>No QR Code could be found with the current set of filters applied.</source>
        <target state="final">Не найден QR-код с применением текущего набора фильтров.</target>
      </trans-unit>
      <trans-unit id="not_found.title" approved="yes">
        <source>No QR Codes found</source>
        <target state="final">QR-коды не найдены</target>
      </trans-unit>
      <trans-unit id="not_found.message" approved="yes">
        <source>There are currently no QR Codes found in the database.</source>
        <target state="final">В настоящее время в базе данных нет QR-кодов.</target>
      </trans-unit>
      <trans-unit id="create" approved="yes">
        <source>Create new QR Code</source>
        <target state="final">Создать новый QR-код</target>
      </trans-unit>
      <trans-unit id="delete.title" approved="yes">
        <source>Delete QR Codes</source>
        <target state="final">Удалить QR-коды</target>
      </trans-unit>
      <trans-unit id="delete.message" approved="yes">
        <source>Delete all marked QR Codes permanently? You cannot undo this action.</source>
        <target state="final">Удалить все отмеченные QR-коды навсегда? Это действие отменить невозможно.</target>
      </trans-unit>
      <trans-unit id="download" approved="yes">
        <source>Download</source>
        <target state="final">Скачать</target>
      </trans-unit>
      <trans-unit id="show" approved="yes">
        <source>Show QR Code</source>
        <target state="final">Показать QR код</target>
      </trans-unit>
