<?xml version="1.0" encoding="UTF-8"?>
<xliff xmlns:t3="http://typo3.org/schemas/xliff" version="1.0">
  <file t3:id="1415814881" source-language="en" datatype="plaintext" original="EXT:core/Resources/Private/Language/locallang_mod_web_list.xlf" date="2011-10-17T20:22:34Z" product-name="lang" target-language="ru">
    <header/>
    <body>
      <trans-unit id="mlang_labels_tablabel" resname="mlang_labels_tablabel" approved="yes">
        <source>List of database-records</source>
        <target state="final">Список записей базы данных</target>
      </trans-unit>
      <trans-unit id="mlang_labels_tabdescr" resname="mlang_labels_tabdescr" approved="yes">
        <source>The Web&gt;List module provides low level access to records appearing on a page.</source>
        <target state="final">Модуль Веб&gt;Список обеспечивает доступ к наиболее широкому количеству элементов и параметров страницы.</target>
      </trans-unit>
      <trans-unit id="mlang_tabs_tab" resname="mlang_tabs_tab" approved="yes">
        <source>List</source>
        <target state="final">Список</target>
      </trans-unit>
      <trans-unit id="clip_pasteAfter" resname="clip_pasteAfter" approved="yes">
        <source>Paste after: Clipboard content is inserted after this record</source>
        <target state="final">Вставка после: вставить содержимое Буфера обмена после этой записи</target>
      </trans-unit>
      <trans-unit id="clip_pasteInto" resname="clip_pasteInto" approved="yes">
        <source>Paste into: Clipboard content is inserted on this page</source>
        <target state="final">Вставка внутрь: вставить содержимое Буфера обмена в эту страницу</target>
      </trans-unit>
      <trans-unit id="clip_paste" resname="clip_paste" approved="yes">
        <source>Paste in clipboard content</source>
        <target state="final">Вставить содержимое Буфера обмена</target>
      </trans-unit>
      <trans-unit id="clip_markRecords" resname="clip_markRecords" approved="yes">
        <source>Mark All/Mark none</source>
        <target state="final">Выделить все/Снять выделение</target>
      </trans-unit>
      <trans-unit id="clip_selectMarked" resname="clip_selectMarked" approved="yes">
        <source>Transfer the selection of records to clipboard</source>
        <target state="final">Передать выбранные записи в Буфер обмена</target>
      </trans-unit>
      <trans-unit id="clip_duplicates" resname="clip_duplicates" approved="yes">
        <source>Mark duplicates</source>
        <target state="final">Выделить дубликаты</target>
      </trans-unit>
      <trans-unit id="clip_editMarked" resname="clip_editMarked" approved="yes">
        <source>Edit marked</source>
        <target state="final">Редактировать выделенные</target>
      </trans-unit>
      <trans-unit id="clip_deleteMarked" resname="clip_deleteMarked" approved="yes">
        <source>Delete marked</source>
        <target state="final">Удалить выделенные</target>
      </trans-unit>
      <trans-unit id="clip_deleteMarkedWarning" resname="clip_deleteMarkedWarning" approved="yes">
        <source>Are you sure you want to delete all marked records from the table '%s'?</source>
        <target state="final">Вы уверены, что хотите удалить все выделенные записи из таблицы '%s'</target>
      </trans-unit>
      <trans-unit id="showInfo" resname="showInfo" approved="yes">
        <source>Display information</source>
        <target state="final">Показать информацию</target>
      </trans-unit>
      <trans-unit id="edit" resname="edit" approved="yes">
        <source>Edit record</source>
        <target state="final">Редактировать запись</target>
      </trans-unit>
      <trans-unit id="editPage" resname="editPage" approved="yes">
        <source>Edit page properties</source>
        <target state="final">Свойства страницы</target>
      </trans-unit>
      <trans-unit id="new" resname="new" approved="yes">
        <source>New record</source>
        <target state="final">Создать запись</target>
      </trans-unit>
      <trans-unit id="newPage" resname="newPage" approved="yes">
        <source>Create new page after this page</source>
        <target state="final">Создать новую страницу после этой</target>
      </trans-unit>
      <trans-unit id="newRecord" resname="newRecord" approved="yes">
        <source>Create new record after this record</source>
        <target state="final">Создать новую запись после этой</target>
      </trans-unit>
      <trans-unit id="newRecordGeneral" resname="newRecordGeneral" approved="yes">
        <source>Create new record</source>
        <target state="final">Создать новую запись</target>
      </trans-unit>
      <trans-unit id="moveUp" resname="moveUp" approved="yes">
        <source>Move up in list</source>
        <target state="final">Переместить выше по списку</target>
      </trans-unit>
      <trans-unit id="moveDown" resname="moveDown" approved="yes">
        <source>Move down in list</source>
        <target state="final">Переместить ниже по списку</target>
      </trans-unit>
      <trans-unit id="move_record" resname="move_record" approved="yes">
        <source>Re-position content element</source>
        <target state="final">Перемещение записи</target>
      </trans-unit>
      <trans-unit id="move_page" resname="move_page" approved="yes">
        <source>Move page</source>
        <target state="final">Переместить страницу</target>
      </trans-unit>
      <trans-unit id="hide" resname="hide" approved="yes">
        <source>Hide record</source>
        <target state="final">Сделать запись невидимой</target>
      </trans-unit>
      <trans-unit id="unHide" resname="unHide" approved="yes">
        <source>Un-hide record</source>
        <target state="final">Сделать запись видимой</target>
      </trans-unit>
      <trans-unit id="hidePage" resname="hidePage" approved="yes">
        <source>Hide page</source>
        <target state="final">Сделать страницу невидимой</target>
      </trans-unit>
      <trans-unit id="unHidePage" resname="unHidePage" approved="yes">
        <source>Un-hide page</source>
        <target state="final">Сделать страницу видимой</target>
      </trans-unit>
      <trans-unit id="prevLevel" resname="prevLevel" approved="yes">
        <source>Move this page to the position after the current parent page (Inwards)</source>
        <target state="final">Переместить страницу ближе к корню дерева (так, чтобы она располагалась сразу после страницы, которая сейчас является родительской)</target>
      </trans-unit>
      <trans-unit id="nextLevel" resname="nextLevel" approved="yes">
        <source>Move this page to be a subpage of the page above (Outwards)</source>
        <target state="final">Переместить эту страницу дальше от корня дерева (так, чтобы она стала подстраницей той страницы, которая сейчас в предыдущей строке списка)</target>
      </trans-unit>
      <trans-unit id="delete" resname="delete" approved="yes">
        <source>Delete record (!)</source>
        <target state="final">Удалить запись (!)</target>
      </trans-unit>
      <trans-unit id="restore" resname="restore" approved="yes">
        <source>Restore record</source>
        <target state="final">Восстановить запись</target>
      </trans-unit>
      <trans-unit id="history" resname="history" approved="yes">
        <source>Display change history / Un-do</source>
        <target state="final">Показать историю изменений / Отмена</target>
      </trans-unit>
      <trans-unit id="displayVersions" resname="displayVersions" approved="yes">
        <source>Display versions</source>
        <target state="final">Показать версии</target>
      </trans-unit>
      <trans-unit id="permissions" resname="permissions" approved="yes">
        <source>Set permissions for page</source>
        <target state="final">Установить права доступа к странице</target>
      </trans-unit>
      <trans-unit id="largeControl" resname="largeControl" approved="yes">
        <source>Extended view</source>
        <target state="final">Расширенный вид</target>
      </trans-unit>
      <trans-unit id="contractView" resname="contractView" approved="yes">
        <source>List all tables</source>
        <target state="final">Список всех таблиц</target>
      </trans-unit>
      <trans-unit id="expandView" resname="expandView" approved="yes">
        <source>List only this table</source>
        <target state="final">Список только этих таблиц</target>
      </trans-unit>
      <trans-unit id="showClipBoard" resname="showClipBoard" approved="yes">
        <source>Show clipboard</source>
        <target state="final">Показать Буфер обмена</target>
      </trans-unit>
      <trans-unit id="editShownColumns" resname="editShownColumns" approved="yes">
        <source>Edit all shown fields of the listed records</source>
        <target state="final">Редактировать все поля перечисленных записей</target>
      </trans-unit>
      <trans-unit id="editThisColumn" resname="editThisColumn" approved="yes">
        <source>Edit the '%s' field of the listed records</source>
        <target state="final">Редактировать поле '%s' перечисленных записей</target>
      </trans-unit>
      <trans-unit id="deleteWarning" resname="deleteWarning" approved="yes">
        <source>Are you sure you want to delete this record?</source>
        <target state="final">Вы действительно хотите удалить эту запись?</target>
      </trans-unit>
      <trans-unit id="restoreWarning" resname="restoreWarning" approved="yes">
        <source>Are you sure you want to restore this record by reverting the delete status?</source>
        <target state="final">Вы действительно хотите восстановить удаленную запись?</target>
      </trans-unit>
      <trans-unit id="localization" resname="localization" approved="yes">
        <source>Localization view</source>
        <target state="final">Просмотр переводов</target>
      </trans-unit>
      <trans-unit id="defaultLanguage" resname="defaultLanguage" approved="yes">
        <source>Default</source>
        <target state="final">Стандартный</target>
      </trans-unit>
      <trans-unit id="multipleLanguages" resname="multipleLanguages" approved="yes">
        <source>All languages</source>
        <target state="final">Все языки</target>
      </trans-unit>
      <trans-unit id="Localize" resname="Localize" approved="yes">
        <source>Localize to</source>
        <target state="final">Перевести на</target>
      </trans-unit>
      <trans-unit id="viewRecords" resname="viewRecords" approved="yes">
        <source>Viewing records of</source>
        <target state="final">Просмотр записей</target>
      </trans-unit>
      <trans-unit id="pageIndicator" resname="pageIndicator" approved="yes">
        <source>Page %1$s of %2$d</source>
        <target state="final">Страница %1$s из %2$d</target>
      </trans-unit>
      <trans-unit id="rangeIndicator" resname="rangeIndicator" approved="yes">
        <source>Records %1$d - %2$d</source>
        <target state="final">Записи %1$d - %2$d</target>
      </trans-unit>
      <trans-unit id="missingTcaColumnsMessageTitle" resname="missingTcaColumnsMessageTitle" approved="yes">
        <source>Missing TCA definition</source>
        <target state="final">Ошибочное определение TCA</target>
      </trans-unit>
      <trans-unit id="missingTcaColumnsMessage" resname="missingTcaColumnsMessage" approved="yes">
        <source>No fields for table "%s" have been found. $TCA['%s']['columns'] does not contain the necessary definitions.</source>
        <target state="final">Не найдено полей для таблицы "%s". $TCA['%s']['columns'] не содержит необходимых определений.</target>
      </trans-unit>
      <trans-unit id="noRecordsOnThisPage" resname="noRecordsOnThisPage" approved="yes">
        <source>There are no records on this page.</source>
        <target state="final">На странице нет записей.</target>
      </trans-unit>
      <trans-unit id="noRecordsOfTypeOnThisPage" resname="noRecordsOfTypeOnThisPage" approved="yes">
        <source>There are no records of type "%s" on this page.</source>
        <target state="final">На этой странице нет записей типа "%s".</target>
      </trans-unit>
      <trans-unit id="button.cancel" resname="button.cancel" approved="yes">
        <source>Cancel</source>
        <target state="final">Отмена</target>
      </trans-unit>
      <trans-unit id="button.close" resname="button.close" approved="yes">
        <source>Close</source>
        <target state="final">Закрыть</target>
      </trans-unit>
      <trans-unit id="button.ok" resname="button.ok" approved="yes">
        <source>OK</source>
        <target state="final">Да</target>
      </trans-unit>
      <trans-unit id="button.delete" resname="button.delete" approved="yes">
        <source>Delete</source>
        <target state="final">Удалить</target>
      </trans-unit>
      <trans-unit id="button.yes" resname="button.yes" approved="yes">
        <source>Yes</source>
        <target state="final">Да</target>
      </trans-unit>
      <trans-unit id="button.no" resname="button.no" approved="yes">
        <source>No</source>
        <target state="final">Нет</target>
      </trans-unit>
      <trans-unit id="notification.request.title" resname="notification.request.title" approved="yes">
        <source>Allow notifications?</source>
        <target state="final">Разрешить уведомления?</target>
      </trans-unit>
      <trans-unit id="notification.request.description" resname="notification.request.description" approved="yes">
        <source>TYPO3 can send important notifications, e.g. when your login expires. To enable notifications, please click "Yes" and confirm your browser's notification request. If you choose "no", we will not ask again.</source>
        <target state="final">TYPO3 может отправлять важные уведомления, например, по истечении срока вашей авторизации в системе. Чтобы включить уведомления, нажмите "Да" и подтвердите запрос на уведомление от вашего браузера. Если вы выберете "нет", повторного запроса не будет.</target>
      </trans-unit>
    </body>
  </file>
