<?xml version="1.0" encoding="UTF-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" version="1.2">
  <file source-language="en" datatype="plaintext" original="EXT:core/Resources/Private/Language/locallang_cache.xlf" date="2026-02-24T00:00:00Z" product-name="lang" target-language="lt">
    <header/>
    <body>
      <trans-unit id="page.label" approved="yes">
        <source>Clear cache for this page</source>
        <target state="final">Išvalyti šio puslapio spartinančiąją atmintį</target>
      </trans-unit>
      <trans-unit id="group.pages.label" approved="yes">
        <source>Flush frontend caches</source>
        <target state="final">Išvalyti svetainės spartinančiąją atmintį</target>
      </trans-unit>
      <trans-unit id="group.pages.description" approved="yes">
        <source>Clear frontend and page-related caches.</source>
        <target state="final">Išvalyti svetainės ir su puslapiais susijusią spartinančiąją atmintį.</target>
      </trans-unit>
      <trans-unit id="group.all.label" approved="yes">
        <source>Flush all caches</source>
        <target state="final">Išvalyti visą spartinančiąją atmintį</target>
      </trans-unit>
      <trans-unit id="group.all.description" approved="yes">
        <source>Clear frontend and page-related caches, all system-related caches, including localization, extension configuration, file and opcode caches. Rebuilding these caches may take some time.</source>
        <target state="final">Išvalyti svetainės ir su puslapiais susijusią spartinančiąją atmintį, visą su sistema susijusią spartinančiąją atmintį, įskaitant lokalizaciją, plėtinių konfigūraciją, failų ir opkodo spartinančiąją atmintį. Šios spartinančiosios atminties atkūrimas gali užtrukti.</target>
      </trans-unit>
      <!-- Notifications -->
      <trans-unit id="notification.error.title" approved="yes">
        <source>An error occurred</source>
        <target state="final">Įvyko klaida</target>
      </trans-unit>
      <trans-unit id="notification.error.message" approved="yes">
        <source>An error occurred while clearing the cache. Some caches may not have been cleared successfully.</source>
        <target state="final">Valant spartinančiąją atmintį įvyko klaida. Dalis spartinančiosios atminties galėjo būti neišvalyta sėkmingai.</target>
      </trans-unit>
      <trans-unit id="notification.page.success.title" approved="yes">
        <source>Page cache cleared</source>
        <target state="final">Puslapio spartinančioji atmintis išvalyta</target>
      </trans-unit>
      <trans-unit id="notification.page.success.message" approved="yes">
        <source>Page cache for '%s' has been cleared.</source>
        <target state="final">Puslapio '%s' spartinančioji atmintis buvo išvalyta.</target>
      </trans-unit>
      <trans-unit id="notification.page.error.title" approved="yes">
        <source>Page cache not cleared</source>
        <target state="final">Puslapio spartinančioji atmintis neišvalyta</target>
      </trans-unit>
      <trans-unit id="notification.page.error.message" approved="yes">
        <source>Page cache could not be cleared.</source>
        <target state="final">Puslapio spartinančiosios atminties išvalyti nepavyko.</target>
      </trans-unit>
      <trans-unit id="notification.group.pages.success.title" approved="yes">
        <source>Frontend caches cleared</source>
        <target state="final">Svetainės spartinančioji atmintis išvalyta</target>
      </trans-unit>
      <trans-unit id="notification.group.pages.success.message" approved="yes">
        <source>Frontend caches have been cleared.</source>
        <target state="final">Svetainės spartinančioji atmintis buvo išvalyta.</target>
      </trans-unit>
      <trans-unit id="notification.group.all.success.title" approved="yes">
        <source>All caches cleared</source>
        <target state="final">Visa spartinančioji atmintis išvalyta</target>
      </trans-unit>
      <trans-unit id="notification.group.all.success.message" approved="yes">
        <source>All caches have been cleared.</source>
        <target state="final">Visa spartinančioji atmintis buvo išvalyta.</target>
      </trans-unit>
    </body>
  </file>
</xliff>
