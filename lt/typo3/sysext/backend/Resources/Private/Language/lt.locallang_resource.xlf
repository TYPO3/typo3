<?xml version="1.0" encoding="UTF-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" version="1.2">
  <file source-language="en" datatype="plaintext" original="EXT:backend/Resources/Private/Language/locallang_resource.xlf" date="2023-02-21T00:00:00Z" product-name="cms" target-language="lt">
    <header/>
    <body>
      <trans-unit id="ajax.success" approved="yes">
        <source>Success</source>
        <target state="final">Sėkminga</target>
      </trans-unit>
      <trans-unit id="ajax.success.message.renamed" approved="yes">
        <source>The resource "%s" has been renamed to "%s".</source>
        <target state="final">Išteklius „%s“ buvo pervadintas į „%s“.</target>
      </trans-unit>
      <trans-unit id="ajax.success.message.resourceReplaced" approved="yes">
        <source>The resource %s has been replaced.</source>
        <target state="final">Išteklius %s buvo pakeistas.</target>
      </trans-unit>
      <trans-unit id="ajax.error" approved="yes">
        <source>An error occurred</source>
        <target state="final">Įvyko klaida</target>
      </trans-unit>
      <trans-unit id="ajax.error.message.resourceNotFileOrFolder" approved="yes">
        <source>The resource must be a file or a folder.</source>
        <target state="final">Išteklius turi būti failas arba aplankas.</target>
      </trans-unit>
      <trans-unit id="ajax.error.message.resourceNoPermissionRename" approved="yes">
        <source>Renaming this resource is not permitted.</source>
        <target state="final">Šio ištekliaus pervadinti negalima.</target>
      </trans-unit>
      <trans-unit id="ajax.error.message.resourceNameCannotBeEmpty" approved="yes">
        <source>The resource name cannot be empty.</source>
        <target state="final">Ištekliaus pavadinimas negali būti tuščias.</target>
      </trans-unit>
      <trans-unit id="ajax.error.message.resourceNameNotDifferent" approved="yes">
        <source>The resource %s already has this name. No changes were made.</source>
        <target state="final">Išteklius %s jau turi tokį pavadinimą. Pakeitimai nebuvo atlikti.</target>
      </trans-unit>
      <trans-unit id="ajax.error.message.resourceNotAvailableToUpload" approved="yes">
        <source>No resource was selected to be uploaded.</source>
        <target state="final">Nepasirinktas joks įkeliamas išteklius.</target>
      </trans-unit>
      <trans-unit id="ajax.error.message.resourceNotRenamed" approved="yes">
        <source>The resource %s could not be renamed.</source>
        <target state="final">Ištekliaus %s nepavyko pervadinti.</target>
      </trans-unit>
      <trans-unit id="ajax.error.message.resourceNotFound" approved="yes">
        <source>The resource was not found.</source>
        <target state="final">Išteklius nerastas.</target>
      </trans-unit>
    </body>
