        <target state="final">Nepavyko atrakinti MFA teikėjo %s. Bandykite dar kartą.</target>
      </trans-unit>
      <trans-unit id="unlock.success" approved="yes">
        <source>Successfully unlocked MFA provider %s.</source>
        <target state="final">MFA teikėjas %s sėkmingai atrakintas.</target>
      </trans-unit>
      <trans-unit id="save.failure" approved="yes">
        <source>Could not update MFA provider %s. Please try again.</source>
        <target state="final">Nepavyko atnaujinti MFA teikėjo %s. Bandykite dar kartą.</target>
      </trans-unit>
      <trans-unit id="save.success" approved="yes">
        <source>Successfully updated MFA provider %s.</source>
        <target state="final">MFA teikėjas %s sėkmingai atnaujintas.</target>
      </trans-unit>
