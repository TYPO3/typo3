        <source>Select the page on which a new record is created on.</source>
        <target state="final">Pasirinkite puslapį, kuriame bus sukurtas naujas įrašas.</target>
      </trans-unit>
      <trans-unit id="sys_reaction.fields" approved="yes">
        <source>Fields</source>
        <target state="final">Laukai</target>
      </trans-unit>
