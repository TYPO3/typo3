        <source>Generate and customize QR codes to provide quick, scannable access to your digital content.</source>
        <target state="final">Generuokite ir pritaikykite QR kodus, kad suteiktumėte greitą, nuskenuojamą prieigą prie savo skaitmeninio turinio.</target>
      </trans-unit>
      <trans-unit id="heading_text" approved="yes">
        <source>QR Code Management</source>
        <target state="final">QR kodų valdymas</target>
      </trans-unit>
