        <target state="final">Visam laikui ištrinti visus pažymėtus QR kodus? Šio veiksmo atšaukti negalėsite.</target>
      </trans-unit>
      <trans-unit id="download" approved="yes">
        <source>Download</source>
        <target state="final">Atsisiųsti</target>
      </trans-unit>
      <trans-unit id="show" approved="yes">
        <source>Show QR Code</source>
        <target state="final">Rodyti QR kodą</target>
      </trans-unit>
