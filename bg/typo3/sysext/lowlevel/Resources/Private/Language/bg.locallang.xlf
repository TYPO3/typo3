    <header/>
    <body>
      <trans-unit id="configuration" resname="configuration" approved="yes">
        <source>Configuration</source>
        <target state="final">Конфигурация</target>
      </trans-unit>
      <trans-unit id="cropLines" resname="cropLines" approved="yes">
        <source>Crop lines</source>
        <target state="final">Отрежи линиите</target>
      </trans-unit>
      <trans-unit id="copyPaste" resname="copyPaste" approved="yes">
        <source>(Now, copy/paste this value into the configuration file where you can set it. This is all you can do from here...)</source>
        <target state="final">(Сега, копирайте и поставете тази стойност в конфигурационен файл, където можете да й зададете стойност. Това е всичко, което можете да направите оттук...)</target>
      </trans-unit>
      <trans-unit id="search" resname="search" approved="yes">
        <source>Search</source>
        <target state="final">Търсене</target>
      </trans-unit>
      <trans-unit id="useRegExp" resname="useRegExp" approved="yes">
        <source>Use regular expression (phrase is surrounded by slashes automatically)</source>
        <target state="final">Използвай регулярен израз</target>
      </trans-unit>
      <trans-unit id="writeValue" resname="writeValue" approved="yes">
        <source>Write value to configuration file</source>
        <target state="final">Запиши стойността в конфигурационен файл</target>
      </trans-unit>
      <trans-unit id="writeMessage" resname="writeMessage" approved="yes">
        <source>Following line was added to configuration file (%s): %s%s</source>
        <target state="final">Следната линия беше добавена към конфигурационния файл (%s): %s%s</target>
      </trans-unit>
      <trans-unit id="writeMessageFailed" resname="writeMessageFailed" approved="yes">
        <source>Write to configuration file failed (%s)!</source>
        <target state="final">Записът в конфигурационен файл беше неуспешен (%s)!</target>
      </trans-unit>
      <trans-unit id="searchButton" resname="searchButton" approved="yes">
        <source>Search</source>
        <target state="final">Търсене</target>
      </trans-unit>
