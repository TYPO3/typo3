        <source>No registered reports</source>
        <target state="final">Ingen registrerede rapporter</target>
      </trans-unit>
      <trans-unit id="noReportsMessage" approved="yes">
        <source>There are no reports registered in the system and default reports have been disabled.</source>
        <target state="final">Der er ingen rapporter registreret i systemet, og standard rapporter er blevet deaktiveret.</target>
      </trans-unit>
