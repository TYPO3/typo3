        <target state="final">Sti</target>
      </trans-unit>
      <trans-unit id="record.userDeleted" approved="yes">
        <source>[Deleted user] (id=%s)</source>
        <target state="final">[Slettet bruger] (id=%s)</target>
      </trans-unit>
