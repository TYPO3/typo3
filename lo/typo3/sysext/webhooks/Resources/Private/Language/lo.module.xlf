<?xml version="1.0" encoding="UTF-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" version="1.2">
  <file source-language="en" datatype="plaintext" original="EXT:webhooks/Resources/Private/Language/module.xlf" date="2025-10-20T12:00:00Z" product-name="webhooks" target-language="lo">
    <header/>
    <body>
      <trans-unit id="title" approved="yes">
        <source>Webhooks</source>
        <target state="final">ເວັບຮຸກ (Webhooks)</target>
      </trans-unit>
      <trans-unit id="short_description" approved="yes">
        <source>Manage outgoing HTTP webhooks to external system</source>
        <target state="final">ຈັດການການສົ່ງ HTTP Webhooks ອອກໄປຫາລະບົບພາຍນອກ</target>
      </trans-unit>
      <trans-unit id="description" approved="yes">
        <source>Configure TYPO3 webhooks to notify external systems when defined system events occur. Supports integrations with platforms such as Slack, Discord, payment providers, CRM systems, and more.</source>
        <target state="final">ກຳນົດຄ່າ webhooks ຂອງ TYPO3 ເພື່ອແຈ້ງເຕືອນລະບົບພາຍນອກເມື່ອມີເຫດການຂອງລະບົບທີ່ກຳນົດໄວ້ເກີດຂຶ້ນ. ຮອງຮັບການເຊື່ອມຕໍ່ກັບແພລດຟອມຕ່າງໆ ເຊັ່ນ Slack, Discord, ຜູ້ໃຫ້ບໍລິການຊຳລະເງິນ, ລະບົບ CRM, ແລະ ອື່ນໆ.</target>
      </trans-unit>
      <trans-unit id="heading_text" approved="yes">
        <source>Webhooks — Manage Outgoing HTTP Webhooks</source>
        <target state="final">ເວັບຮຸກ — ຈັດການການສົ່ງ HTTP Webhooks ອອກ</target>
      </trans-unit>
      <trans-unit id="webhook_not_found.title" approved="yes">
        <source>No webhooks found</source>
        <target state="final">ບໍ່ພົບເວັບຮຸກ</target>
      </trans-unit>
      <trans-unit id="webhook_not_found.message" approved="yes">
        <source>There are currently no webhooks records found in the database.</source>
        <target state="final">ປັດຈຸບັນບໍ່ພົບຂໍ້ມູນເວັບຮຸກໃນຖານຂໍ້ມູນ.</target>
      </trans-unit>
      <trans-unit id="webhook_create" approved="yes">
        <source>Create new webhook</source>
        <target state="final">ສ້າງເວັບຮຸກໃໝ່</target>
      </trans-unit>
      <trans-unit id="webhook_not_found_with_filter.title" approved="yes">
        <source>No webhooks found</source>
        <target state="final">ບໍ່ພົບເວັບຮຸກ</target>
      </trans-unit>
      <trans-unit id="webhook_not_found_with_filter.message" approved="yes">
        <source>With the current set of filters applied, no webhooks could be found.</source>
        <target state="final">ບໍ່ພົບເວັບຮຸກ ຕາມຕົວຕອງທີ່ທ່ານກຳນົດໄວ້.</target>
      </trans-unit>
      <trans-unit id="webhook_no_filter" approved="yes">
        <source>Remove all filter</source>
        <target state="final">ລຶບຕົວຕອງທັງໝົດອອກ</target>
      </trans-unit>
      <trans-unit id="webhook_no_implementation_class" approved="yes">
        <source>Implementation class for webhook type "%s" is missing.</source>
        <target state="final">ຄລາສການຈັດການ (Implementation class) ສຳລັບເວັບຮຸກປະເພດ "%s" ຫາຍໄປ.</target>
      </trans-unit>
      <trans-unit id="webhook_example" approved="yes">
        <source>Example</source>
        <target state="final">ຕົວຢ່າງ</target>
      </trans-unit>
      <trans-unit id="filter.sendButton" approved="yes">
        <source>Filter</source>
        <target state="final">ຕົວຕອງ</target>
      </trans-unit>
      <trans-unit id="filter.resetButton" approved="yes">
        <source>Reset</source>
        <target state="final">ຕັ້ງຄ່າໃໝ່</target>
      </trans-unit>
      <trans-unit id="filter.name" approved="yes">
        <source>Name</source>
        <target state="final">ຊື່</target>
      </trans-unit>
      <trans-unit id="filter.webhook_type" approved="yes">
        <source>Webhook Trigger</source>
        <target state="final">ຕົວຂັບເຄື່ອນເວັບຮຸກ (Trigger)</target>
      </trans-unit>
      <trans-unit id="filter.webhook_type.showAll" approved="yes">
        <source>Show all</source>
        <target state="final">ສະແດງທັງໝົດ</target>
      </trans-unit>
      <trans-unit id="pagination.previous" approved="yes">
        <source>previous</source>
        <target state="final">ກ່ອນໜ້າ</target>
      </trans-unit>
      <trans-unit id="pagination.next" approved="yes">
        <source>next</source>
        <target state="final">ຖັດໄປ</target>
      </trans-unit>
      <trans-unit id="pagination.first" approved="yes">
        <source>first</source>
        <target state="final">ທຳອິດ</target>
      </trans-unit>
      <trans-unit id="pagination.last" approved="yes">
        <source>last</source>
        <target state="final">ສຸດທ້າຍ</target>
      </trans-unit>
      <trans-unit id="pagination.records" approved="yes">
        <source>Records</source>
        <target state="final">ລາຍການຂໍ້ມູນ</target>
      </trans-unit>
      <trans-unit id="pagination.page" approved="yes">
        <source>Page</source>
        <target state="final">ໜ້າ</target>
      </trans-unit>
      <trans-unit id="pagination.refresh" approved="yes">
        <source>Refresh</source>
        <target state="final">ໂຫຼດໃໝ່</target>
      </trans-unit>
      <trans-unit id="labels.delete.title" approved="yes">
        <source>Delete webhooks</source>
        <target state="final">ລຶບເວັບຮຸກ</target>
      </trans-unit>
      <trans-unit id="labels.delete.message" approved="yes">
        <source>Delete all marked webhooks? You can restore deleted webhooks from the TYPO3 recycler.</source>
        <target state="final">ລຶບເວັບຮຸກທີ່ເລືອກໄວ້ທັງໝົດບໍ່? ທ່ານສາມາດກູ້ຄືນເວັບຮຸກທີ່ລຶບໄປແລ້ວຄືນໄດ້ຈາກຖັງຂີ້ເຫຍື້ອ (recycler) ຂອງ TYPO3.</target>
      </trans-unit>
    </body>
