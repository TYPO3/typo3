<?xml version="1.0" encoding="UTF-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" version="1.2">
  <file source-language="en" datatype="plaintext" original="EXT:form/Resources/Private/Language/locallang_relative_date_editor.xlf" date="2025-02-25T00:00:00Z" product-name="form" target-language="lo">
    <header/>
    <body>
      <trans-unit id="mode.no" approved="yes">
        <source>No value</source>
        <target state="final">ບໍ່ມີຄ່າ</target>
      </trans-unit>
      <trans-unit id="mode.today" approved="yes">
        <source>Today</source>
        <target state="final">ມື້ນີ້</target>
      </trans-unit>
      <trans-unit id="mode.absolute" approved="yes">
        <source>Absolute date</source>
        <target state="final">ວັນທີທີ່ແນ່ນອນ</target>
      </trans-unit>
      <trans-unit id="mode.relative" approved="yes">
        <source>Relative date</source>
        <target state="final">ວັນທີແບບທຽບເຄຽງ</target>
      </trans-unit>
      <trans-unit id="direction.past" approved="yes">
        <source>past</source>
        <target state="final">ອະດີດ</target>
      </trans-unit>
      <trans-unit id="direction.future" approved="yes">
        <source>future</source>
        <target state="final">ອະນາຄົດ</target>
      </trans-unit>
      <trans-unit id="unit.days" approved="yes">
        <source>{count, plural, one {Day} other {Days}}</source>
        <target state="final">{count, plural, one {ມື້} other {ມື້}}</target>
      </trans-unit>
      <trans-unit id="unit.weeks" approved="yes">
        <source>{count, plural, one {Week} other {Weeks}}</source>
        <target state="final">{count, plural, one {ອາທິດ} other {ອາທິດ}}</target>
      </trans-unit>
      <trans-unit id="unit.months" approved="yes">
        <source>{count, plural, one {Month} other {Months}}</source>
        <target state="final">{count, plural, one {ເດືອນ} other {ເດືອນ}}</target>
      </trans-unit>
      <trans-unit id="unit.years" approved="yes">
        <source>{count, plural, one {Year} other {Years}}</source>
        <target state="final">{count, plural, one {ປີ} other {ປີ}}</target>
      </trans-unit>
      <trans-unit id="mode.custom" approved="yes">
        <source>Custom relative expression</source>
        <target state="final">ສໍານວນວັນທີແບບທຽບເຄຽງທີ່ກຳນົດເອງ</target>
      </trans-unit>
      <trans-unit id="custom.placeholder" approved="yes">
        <source>e.g. "sunday next month"</source>
        <target state="final">ຕ.ຢ. "ວັນອາທິດເດືອນໜ້າ"</target>
      </trans-unit>
    </body>
  </file>
</xliff>
