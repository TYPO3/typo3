<?xml version="1.0" encoding="UTF-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" version="1.2">
  <file source-language="en" datatype="plaintext" original="EXT:lowlevel/Resources/Private/Language/Modules/database_integrity.xlf" date="2026-11-10T13:37:37Z" product-name="database_integrity" target-language="lo">
    <header/>
    <body>
      <trans-unit id="title" approved="yes">
        <source>Database</source>
        <target state="final">ຖານຂໍ້ມູນ</target>
      </trans-unit>
      <trans-unit id="short_description" approved="yes">
        <source>Database query tools</source>
        <target state="final">ເຄື່ອງມືການສອບຖາມຖານຂໍ້ມູນ</target>
      </trans-unit>
      <trans-unit id="description" approved="yes">
        <source>Search and query the TYPO3 database using advanced tools.</source>
        <target state="final">ຄົ້ນຫາ ແລະ ສອບຖາມຖານຂໍ້ມູນ TYPO3 ໂດຍໃຊ້ເຄື່ອງມືຂັ້ນສູງ.</target>
      </trans-unit>
      <trans-unit id="query_loaded" approved="yes">
        <source>Query "%s" loaded</source>
        <target state="final">ໂຫຼດຄຳສັ່ງສອບຖາມ "%s" ແລ້ວ</target>
      </trans-unit>
      <trans-unit id="query_saved" approved="yes">
        <source>Query saved</source>
        <target state="final">ບັນທຶກຄຳສັ່ງສອບຖາມແລ້ວ</target>
      </trans-unit>
      <trans-unit id="query_removed" approved="yes">
        <source>"%s" query entry removed</source>
        <target state="final">ລຶບລາຍການຄຳສັ່ງສອບຖາມ "%s" ອອກແລ້ວ</target>
      </trans-unit>
      <trans-unit id="undelete_only" approved="yes">
        <source>Undelete</source>
        <target state="final">ກູ້ຄືນການລຶບ</target>
      </trans-unit>
    </body>
  </file>
