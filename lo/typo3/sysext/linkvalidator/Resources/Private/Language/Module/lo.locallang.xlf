    <header/>
    <body>
      <trans-unit id="linkvalidator" approved="yes">
        <source>LinkValidator</source>
        <target state="final">ຕົວທວນສອບລິ້</target>
      </trans-unit>
      <trans-unit id="overview.headline" approved="yes">
        <source>Link check</source>
        <target state="final">ການກວດສອບລິ້ງ</target>
      </trans-unit>
      <trans-unit id="overview.headlineWithPageTitle" approved="yes">
        <source>Link check of page "%s"</source>
        <target state="final">ການກວດສອບລິ້ງຂອງໜ້າ "%s"</target>
      </trans-unit>
      <trans-unit id="hooks.db" approved="yes">
        <source>Internal Links</source>
        <target state="final">ລິ້ງພາຍໃນ</target>
      </trans-unit>
      <trans-unit id="hooks.file" approved="yes">
        <source>File Links</source>
        <target state="final">ລິ້ງໄຟລ໌</target>
      </trans-unit>
      <trans-unit id="hooks.external" approved="yes">
        <source>External Links</source>
        <target state="final">ລິ້ງພາຍນອກ</target>
      </trans-unit>
      <trans-unit id="filter.depth" approved="yes">
        <source>Depth</source>
        <target state="final">ຄວາມເລິກ</target>
      </trans-unit>
      <trans-unit id="filter.type" approved="yes">
        <source>Type</source>
        <target state="final">ປະເພດ</target>
      </trans-unit>
      <trans-unit id="filter.type.all" approved="yes">
        <source>All link types</source>
        <target state="final">ທຸກປະເພດລິ້ງ</target>
      </trans-unit>
      <trans-unit id="filter.btn.filter" approved="yes">
        <source>Filter</source>
        <target state="final">ກັ່ນຕອງ</target>
      </trans-unit>
      <trans-unit id="label_update" approved="yes">
        <source>Check</source>
        <target state="final">ກວດສອບ</target>
      </trans-unit>
      <trans-unit id="list.check.headline" approved="yes">
        <source>Check of link types</source>
        <target state="final">ການກວດສອບປະເພດລິ້ງ</target>
      </trans-unit>
      <trans-unit id="list.header" approved="yes">
        <source>Listing of broken links</source>
        <target state="final">ລາຍການລິ້ງທີ່ເສຍ</target>
      </trans-unit>
      <trans-unit id="list.tableHead.errorMessage" approved="yes">
        <source>Error message</source>
        <target state="final">ຂໍ້ຄວາມຜິດພາດ</target>
      </trans-unit>
      <trans-unit id="list.tableHead.field" approved="yes">
        <source>Field</source>
        <target state="final">ຟີວ (Field)</target>
      </trans-unit>
      <trans-unit id="list.tableHead.lastCheck" approved="yes">
        <source>Last check</source>
        <target state="final">ກວດສອບຫຼ້າສຸດ</target>
      </trans-unit>
      <trans-unit id="list.tableHead.linkTarget" approved="yes">
        <source>Link target</source>
        <target state="final">ປາຍທາງລິ້ງ</target>
      </trans-unit>
      <trans-unit id="list.tableHead.linkText" approved="yes">
        <source>Link text</source>
        <target state="final">ຂໍ້ຄວາມລິ້ງ</target>
      </trans-unit>
      <trans-unit id="list.tableHead.linkType" approved="yes">
        <source>Link type</source>
        <target state="final">ປະເພດລິ້ງ</target>
      </trans-unit>
      <trans-unit id="list.tableHead.page" approved="yes">
        <source>Located on page / folder</source>
        <target state="final">ຕັ້ງຢູ່ໜ້າ / ໂຟນເດີ</target>
      </trans-unit>
      <trans-unit id="list.tableHead.parentPage" approved="yes">
        <source>Parent page / folder</source>
        <target state="final">ໜ້າຫຼັກ / ໂຟນເດີຫຼັກ</target>
      </trans-unit>
      <trans-unit id="list.tableHead.record" approved="yes">
        <source>Record</source>
        <target state="final">ຂໍ້ມູນ</target>
      </trans-unit>
      <trans-unit id="list.tableHead.table" approved="yes">
        <source>Table</source>
        <target state="final">ຕາຕະລາງ</target>
      </trans-unit>
      <trans-unit id="list.tableHead.title" approved="yes">
        <source>Title</source>
        <target state="final">ຫົວຂໍ້</target>
      </trans-unit>
      <trans-unit id="list.tableHead.uid" approved="yes">
        <source>Uid</source>
        <target state="final">Uid (ໄອດີສະເພາະ)</target>
      </trans-unit>
      <trans-unit id="list.tableFoot.record" approved="yes">
        <source>Record</source>
        <target state="final">ລາຍການ</target>
      </trans-unit>
      <trans-unit id="list.tableFoot.records" approved="yes">
        <source>Records</source>
        <target state="final">ຂໍ້ມູນ</target>
      </trans-unit>
      <trans-unit id="list.edit" approved="yes">
        <source>Edit record containing this broken link</source>
        <target state="final">ແກ້ໄຂຂໍ້ມູນທີ່ມີລິ້ງທີ່ເສຍນີ້</target>
      </trans-unit>
      <trans-unit id="list.editField" approved="yes">
        <source>Edit only the field containing this broken link</source>
        <target state="final">ແກ້ໄຂສະເພາະຟີວທີ່ມີລິ້ງທີ່ເສຍນີ້</target>
      </trans-unit>
      <trans-unit id="list.report.btn.info.title" approved="yes">
        <source>Display information</source>
        <target state="final">ສະແດງຂໍ້ມູນ</target>
      </trans-unit>
      <trans-unit id="list.report.linkText.noValue" approved="yes">
        <source>[No value]</source>
        <target state="final">[ບໍ່ມີຄ່າ]</target>
      </trans-unit>
      <trans-unit id="list.report.pagedeleted" approved="yes">
        <source>Page '###title###' (id=###uid###) is deleted.</source>
        <target state="final">ໜ້າ '###title###' (id=###uid###) ຖືກລຶບແລ້ວ.</target>
      </trans-unit>
      <trans-unit id="list.report.pagenotvisible" approved="yes">
        <source>Page '###title###' (id=###uid###) is not visible.</source>
        <target state="final">ໜ້າ '###title###' (id=###uid###) ບໍ່ຖືກສະແດງ.</target>
      </trans-unit>
      <trans-unit id="list.report.pagenotexisting" approved="yes">
        <source>Page (id=###uid###) does not exist.</source>
        <target state="final">ໜ້າ (id=###uid###) ບໍ່ມີຢູ່.</target>
      </trans-unit>
      <trans-unit id="list.report.contentmoved" approved="yes">
        <source>Record '###title###' (id=###uid###) is not located on page ###wrongpage###, but on page ###rightpage###.</source>
        <target state="final">ຂໍ້ມູນ '###title###' (id=###uid###) ບໍ່ໄດ້ຕັ້ງຢູ່ໜ້າ ###wrongpage###, ແຕ່ຕັ້ງຢູ່ໜ້າ ###rightpage###.</target>
      </trans-unit>
      <trans-unit id="list.report.contentdeleted" approved="yes">
        <source>Record '###title###' (id=###uid###) is deleted.</source>
        <target state="final">ຂໍ້ມູນ '###title###' (id=###uid###) ຖືກລຶບແລ້ວ.</target>
      </trans-unit>
      <trans-unit id="list.report.contentnotvisible" approved="yes">
        <source>Record '###title###' (id=###uid###) is not visible.</source>
        <target state="final">ຂໍ້ມູນ '###title###' (id=###uid###) ບໍ່ຖືກສະແດງ.</target>
      </trans-unit>
      <trans-unit id="list.report.contentnotexisting" approved="yes">
        <source>Record (id=###uid###) does not exist.</source>
        <target state="final">ຂໍ້ມູນ (id=###uid###) ບໍ່ມີຢູ່.</target>
      </trans-unit>
      <trans-unit id="list.report.noinformation" approved="yes">
        <source>No information about the error is available.</source>
        <target state="final">ບໍ່ມີຂໍ້ມູນກ່ຽວກັບຂໍ້ຜິດພາດນີ້.</target>
      </trans-unit>
      <trans-unit id="list.report.redirectloop" approved="yes">
        <source>A redirect loop occurred. (%s: %s)</source>
        <target state="final">ເກີດການວົນລູບຂອງການປ່ຽນເສັ້ນທາງ. (%s: %s)</target>
      </trans-unit>
      <trans-unit id="list.report.tooManyRedirects" approved="yes">
        <source>Too many redirects.</source>
        <target state="final">ມີການປ່ຽນເສັ້ນທາງຫຼາຍເກີນໄປ.</target>
      </trans-unit>
      <trans-unit id="list.report.filenotexisting" approved="yes">
        <source>File doesn't exist.</source>
        <target state="final">ບໍ່ມີໄຟລ໌ນີ້ຢູ່.</target>
      </trans-unit>
      <!-- external linktype check errors -->
      <trans-unit id="linkcheck.error.external.generic" approved="yes">
        <source>External link is broken.</source>
        <target state="final">ລິ້ງພາຍນອກເສຍ.</target>
      </trans-unit>
      <trans-unit id="list.report.couldnotresolvehost" approved="yes">
        <source>Could not resolve host. The given remote host was not resolved.</source>
        <target state="final">ບໍ່ສາມາດລະບຸໂຮສ໌ (host) ໄດ້. ໂຮສ໌ປາຍທາງທີ່ລະບຸບໍ່ຖືກຄົ້ນພົບ.</target>
      </trans-unit>
      <trans-unit id="list.report.errornetworkdata" approved="yes">
        <source>Failure with receiving network data.</source>
        <target state="final">ເກີດຂໍ້ຜິດພາດໃນການຮັບຂໍ້ມູນເຄືອຂ່າຍ.</target>
      </trans-unit>
      <trans-unit id="list.report.otherhttpcode" approved="yes">
        <source>An error occurred (%s): "%s".</source>
        <target state="final">ເກີດຂໍ້ຜິດພາດຂຶ້ນ (%s): "%s".</target>
      </trans-unit>
      <trans-unit id="list.report.httpexception" approved="yes">
        <source>Exception: %s</source>
        <target state="final">ຂໍ້ຍົກເວັ້ນ (Exception): %s</target>
      </trans-unit>
      <trans-unit id="list.report.networkexception" approved="yes">
        <source>Network error / invalid domain</source>
        <target state="final">ຂໍ້ຜິດພາດເຄືອຂ່າຍ / ໂດເມນບໍ່ຖືກຕ້ອງ</target>
      </trans-unit>
      <!-- HTTP status code error messages -->
      <trans-unit id="list.report.error.httpstatuscode.300" approved="yes">
        <source>Multiple Choices (300).</source>
        <target state="final">ທາງເລືອກຫຼາກຫຼາຍ (300).</target>
      </trans-unit>
      <trans-unit id="list.report.error.httpstatuscode.305" approved="yes">
        <source>Use proxy (305).</source>
        <target state="final">ໃຊ້ພຣັອກຊີ (305).</target>
      </trans-unit>
      <trans-unit id="list.report.error.redirectPermanently" approved="yes">
        <source>URL permanently redirects to another URL (%d).</source>
        <target state="final">URL ນີ້ປ່ຽນເສັ້ນທາງໄປຫາ URL ອື່ນແບບຖາວອນ (%d).</target>
      </trans-unit>
      <trans-unit id="list.report.error.redirectTemporary" approved="yes">
        <source>URL temporarily redirects to another URL (%d).</source>
        <target state="final">URL ນີ້ປ່ຽນເສັ້ນທາງໄປຫາ URL ອື່ນແບບຊົ່ວຄາວ (%d).</target>
      </trans-unit>
      <trans-unit id="list.report.pageforbidden403" approved="yes">
        <source>Accessing this address is not allowed (403).</source>
        <target state="final">ການເຂົ້າເຖິງທີ່ຢູ່ນີ້ບໍ່ໄດ້ຮັບອະນຸຍາດ (403).</target>
      </trans-unit>
      <trans-unit id="list.report.pagenotfound404" approved="yes">
        <source>The requested URL was not found (404).</source>
        <target state="final">ບໍ່ພົບ URL ທີ່ຮ້ອງຂໍ (404).</target>
      </trans-unit>
      <trans-unit id="list.report.internalerror500" approved="yes">
        <source>Internal Server Error (500)</source>
        <target state="final">ເຊີບເວີເກີດຂໍ້ຜິດພາດພາຍໃນ (500)</target>
      </trans-unit>
      <trans-unit id="list.report.externalerror" approved="yes">
        <source>External Link returned HTTP error code (%s).</source>
        <target state="final">ລິ້ງພາຍນອກສົ່ງຄືນລະຫັດຂໍ້ຜິດພາດ HTTP (%s).</target>
      </trans-unit>
      <!-- libcurl error messages from https://curl.haxx.se/libcurl/c/libcurl-errors.html -->
      <!-- ignoring various FTP errors here: 10 - 15, 17, 19  and other error that are unlikely -->
      <trans-unit id="list.report.error.libcurl.1" approved="yes">
        <source>Unsupported protocol.</source>
        <target state="final">ໂປຣໂຕຄໍບໍ່ຮອງຮັບ.</target>
      </trans-unit>
      <trans-unit id="list.report.error.libcurl.2" approved="yes">
        <source>Initialization failed.</source>
        <target state="final">ການເລີ່ມຕົ້ນລະບົບລົ້ມເຫຼວ.</target>
      </trans-unit>
      <trans-unit id="list.report.error.libcurl.3" approved="yes">
        <source>The URL was not properly formatted.</source>
        <target state="final">ຮູບແບບ URL ບໍ່ຖືກຕ້ອງ.</target>
      </trans-unit>
      <trans-unit id="list.report.error.libcurl.4" approved="yes">
        <source>Feature not supported.</source>
        <target state="final">ຟີເຈີບໍ່ຮອງຮັບ.</target>
      </trans-unit>
      <trans-unit id="list.report.error.libcurl.5" approved="yes">
        <source>Couldn't resolve proxy.</source>
        <target state="final">ບໍ່ສາມາດແກ້ໄຂພຣັອກຊີ (proxy).</target>
      </trans-unit>
      <trans-unit id="list.report.error.libcurl.6" approved="yes">
        <source>Couldn't resolve host.</source>
        <target state="final">ບໍ່ສາມາດແກ້ໄຂໂຮສ (host).</target>
      </trans-unit>
      <trans-unit id="list.report.error.libcurl.7" approved="yes">
        <source>Failed to connect to host or proxy.</source>
        <target state="final">ເຊື່ອມຕໍ່ຫາໂຮສ ຫຼື ພຣັອກຊີລົ້ມເຫຼວ.</target>
      </trans-unit>
      <trans-unit id="list.report.error.libcurl.8" approved="yes">
        <source>The remote server sent data that could not be parsed.</source>
        <target state="final">ເຊີບເວີປາຍທາງສົ່ງຂໍ້ມູນທີ່ບໍ່ສາມາດປະມວນຜົນໄດ້.</target>
      </trans-unit>
      <trans-unit id="list.report.error.libcurl.9" approved="yes">
        <source>Access denied.</source>
        <target state="final">ການເຂົ້າເຖິງຖືກປະຕິເສດ.</target>
      </trans-unit>
      <trans-unit id="list.report.error.libcurl.16" approved="yes">
        <source>Generic HTTP/2 error.</source>
        <target state="final">ຂໍ້ຜິດພາດ HTTP/2 ທົ່ວໄປ.</target>
      </trans-unit>
      <trans-unit id="list.report.error.libcurl.18" approved="yes">
        <source>A file transfer was shorter or larger than expected.</source>
        <target state="final">ການສົ່ງຂໍ້ມູນໄຟລ໌ສັ້ນກວ່າ ຫຼື ໃຫຍ່ກວ່າທີ່ຄາດໄວ້.</target>
      </trans-unit>
      <trans-unit id="list.report.error.libcurl.28" approved="yes">
        <source>Timeout: The remote server possibly took too long to answer.</source>
        <target state="final">ໝົດເວລາ: ເຊີບເວີປາຍທາງອາດຈະໃຊ້ເວລາດົນເກີນໄປໃນການຕອບສະໜອງ.</target>
      </trans-unit>
      <trans-unit id="list.report.error.libcurl.35" approved="yes">
        <source>Problem with SSl / TLS handshake.</source>
        <target state="final">ມີບັນຫາກັບການເຊື່ອມຕໍ່ (handshake) SSI / TLS.</target>
      </trans-unit>
      <trans-unit id="list.report.error.libcurl.47" approved="yes">
        <source>Too many redirects.</source>
        <target state="final">ມີການປ່ຽນເສັ້ນທາງຫຼາຍເກີນໄປ.</target>
      </trans-unit>
      <trans-unit id="list.report.error.libcurl.55" approved="yes">
        <source>General network error. Send failed.</source>
        <target state="final">ຂໍ້ຜິດພາດເຄືອຂ່າຍທົ່ວໄປ. ການສົ່ງລົ້ມເຫຼວ.</target>
      </trans-unit>
      <trans-unit id="list.report.error.libcurl.56" approved="yes">
        <source>General network error. Receive failed.</source>
        <target state="final">ຂໍ້ຜິດພາດເຄືອຂ່າຍທົ່ວໄປ. ການຮັບລົ້ມເຫຼວ.</target>
      </trans-unit>
      <trans-unit id="list.report.error.libcurl.60" approved="yes">
        <source>The remote server's SSL certificate was deemed not OK.</source>
        <target state="final">ໃບຢັ້ງຢືນ SSL ຂອງເຊີບເວີປາຍທາງຖືກພິຈາລະນາວ່າບໍ່ຖືກຕ້ອງ.</target>
      </trans-unit>
      <trans-unit id="list.report.error.libcurl.63" approved="yes">
        <source>Maximum file size exceeded.</source>
        <target state="final">ຂະໜາດໄຟລ໌ເກີນຂີດຈຳກັດສູງສຸດ.</target>
      </trans-unit>
      <trans-unit id="list.msg.ok" approved="yes">
        <source>Ok</source>
        <target state="final">ຕົກລົງ</target>
      </trans-unit>
      <trans-unit id="list.msg.lastRun" approved="yes">
        <source>%1$s %2$s</source>
        <target state="final">%1$s %2$s</target>
      </trans-unit>
      <trans-unit id="list.no.broken.links.title" approved="yes">
        <source>No broken links found</source>
        <target state="final">ບໍ່ພົບລິ້ງທີ່ເສຍ</target>
      </trans-unit>
      <trans-unit id="list.no.broken.links" approved="yes">
        <source>There are no broken links for the selected link type restriction.</source>
