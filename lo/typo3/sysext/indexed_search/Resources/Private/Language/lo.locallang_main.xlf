<?xml version="1.0" encoding="UTF-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" version="1.2">
  <file source-language="en" datatype="plaintext" original="EXT:indexed_search/Resources/Private/Language/locallang_main.xlf" date="2011-10-17T20:22:33Z" product-name="indexed_search" target-language="lo">
    <header/>
    <body>
      <trans-unit id="mod_indexed_search" resname="mod_indexed_search" approved="yes">
        <source>Indexed search</source>
        <target state="final">ການຄົ້ນຫາແບບດັດສະນີ</target>
      </trans-unit>
      <trans-unit id="mod2_indexed_search" resname="mod2_indexed_search" approved="yes">
        <source>Indexed search statistics</source>
        <target state="final">ສະຖິຕິການຄົ້ນຫາແບບດັດສະນີ</target>
      </trans-unit>
      <trans-unit id="ignoreExtensions" resname="ignoreExtensions" approved="yes">
        <source>Extension %s was set to be ignored.</source>
        <target state="final">ສ່ວນເສີມ %s ຖືກຕັ້ງຄ່າໃຫ້ເພີກເສີຍ.</target>
      </trans-unit>
      <trans-unit id="pdfToolsNotFound" resname="pdfToolsNotFound" approved="yes">
        <source>PDF tools was not found in paths '%1$spdftotext' and/or '%1$spdfinfo'"</source>
        <target state="final">ບໍ່ພົບເຄື່ອງມື PDF ໃນເສັ້ນທາງ '%1$spdftotext' ແລະ/ຫຼື '%1$spdfinfo'</target>
      </trans-unit>
      <trans-unit id="pdfToolsDisabled" resname="pdfToolsDisabled" approved="yes">
        <source>PDF tools disabled</source>
        <target state="final">ເຄື່ອງມື PDF ຖືກປິດໃຊ້ງານ</target>
      </trans-unit>
      <trans-unit id="pdfToolsFailed" resname="pdfToolsFailed" approved="yes">
        <source>PDFtoText Failed on this document: '%s'. Maybe the PDF file is locked for printing or encrypted.</source>
        <target state="final">PDFToText ລົ້ມເຫຼວສຳລັບເອກະສານນີ້: '%s'. ບາງທີໄຟລ໌ PDF ອາດຖືກລັອກການພິມ ຫຼື ຖືກເຂົ້າລະຫັດໄວ້.</target>
      </trans-unit>
      <trans-unit id="catdocNotFound" resname="catdocNotFound" approved="yes">
        <source>'catdoc' tool for reading Word-files was not found in path '%scatdoc'</source>
        <target state="final">ບໍ່ພົບເຄື່ອງມື 'catdoc' ສຳລັບອ່ານໄຟລ໌ Word ໃນເສັ້ນທາງ '%s'catdoc'</target>
      </trans-unit>
      <trans-unit id="catdocDisabled" resname="catdocDisabled" approved="yes">
        <source>catdoc tools (Word-files) disabled</source>
        <target state="final">ເຄື່ອງມື catdoc (ໄຟລ໌ Word) ຖືກປິດໃຊ້ງານ</target>
      </trans-unit>
      <trans-unit id="ppthtmlNotFound" resname="ppthtmlNotFound" approved="yes">
        <source>'ppthtml' tool for reading Powerpoint-files was not found in path '%sppthtml'</source>
        <target state="final">ບໍ່ພົບເຄື່ອງມື 'ppthtml' ສຳລັບອ່ານໄຟລ໌ Powerpoint ໃນເສັ້ນທາງ '%s'ppthtml'</target>
      </trans-unit>
      <trans-unit id="ppthtmlDisabled" resname="ppthtmlDisabled" approved="yes">
        <source>ppthtml tools (Powerpoint-files) disabled</source>
        <target state="final">ເຄື່ອງມື ppthtml (ໄຟລ໌ Powerpoint) ຖືກປິດໃຊ້ງານ</target>
      </trans-unit>
      <trans-unit id="xlhtmlNotFound" resname="xlhtmlNotFound" approved="yes">
        <source>'xlhtml' tool for reading Excel-files was not found in path '%sxlhtml'</source>
        <target state="final">ບໍ່ພົບເຄື່ອງມື 'xlhtml' ສຳລັບອ່ານໄຟລ໌ Excel ໃນເສັ້ນທາງ '%s'xlhtml'</target>
