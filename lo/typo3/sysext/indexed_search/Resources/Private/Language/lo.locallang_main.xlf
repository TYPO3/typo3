        <target state="final">ເຄື່ອງມື xlhtml (ໄຟລ໌ Excel) ຖືກປິດໃຊ້ງານ</target>
      </trans-unit>
      <trans-unit id="unzipNotFound" resname="unzipNotFound" approved="yes">
        <source>'unzip' tool for reading OpenOffice.org-files was not found in path '%sunzip'</source>
        <target state="final">ບໍ່ພົບເຄື່ອງມື 'unzip' ສຳລັບອ່ານໄຟລ໌ OpenOffice.org ໃນເສັ້ນທາງ '%s'unzip'</target>
      </trans-unit>
      <trans-unit id="unzipDisabled" resname="unzipDisabled" approved="yes">
        <source>unzip tool (OpenOffice.org-files) disabled</source>
        <target state="final">ເຄື່ອງມື unzip (ໄຟລ໌ OpenOffice.org) ຖືກປິດໃຊ້ງານ</target>
      </trans-unit>
      <trans-unit id="unrtfNotFound" resname="unrtfNotFound" approved="yes">
        <source>'unrtf' tool for reading RTF-files was not found in path '%sunrtf'</source>
        <target state="final">ບໍ່ພົບເຄື່ອງມື 'unrtf' ສຳລັບອ່ານໄຟລ໌ RTF ໃນເສັ້ນທາງ '%s'unrtf'</target>
      </trans-unit>
      <trans-unit id="unrtfDisabled" resname="unrtfDisabled" approved="yes">
        <source>unrtf tool (RTF-files) disabled</source>
        <target state="final">ເຄື່ອງມື unrtf (ໄຟລ໌ RTF) ຖືກປິດໃຊ້ງານ</target>
      </trans-unit>
