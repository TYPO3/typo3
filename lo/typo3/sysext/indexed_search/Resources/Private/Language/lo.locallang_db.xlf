<?xml version="1.0" encoding="UTF-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" version="1.2">
  <file source-language="en" datatype="plaintext" original="EXT:indexed_search/Resources/Private/Language/locallang_db.xlf" date="2011-10-17T20:22:33Z" product-name="indexed_search" target-language="lo">
    <header/>
    <body>
      <trans-unit id="index_config" approved="yes">
        <source>Indexing Configuration</source>
        <target state="final">ການຕັ້ງຄ່າການເຮັດດັດສະນີ</target>
      </trans-unit>
      <trans-unit id="index_config.title" approved="yes">
        <source>Title</source>
        <target state="final">ຫົວຂໍ້</target>
      </trans-unit>
      <trans-unit id="index_config.description" approved="yes">
        <source>Description</source>
        <target state="final">ຄຳອະທິບາຍ</target>
      </trans-unit>
      <trans-unit id="index_config.type.I.0" translate="no" approved="yes">
        <source>-</source>
        <target state="final">-</target>
      </trans-unit>
      <trans-unit id="index_config.type.I.1" approved="yes">
        <source>Database Records</source>
        <target state="final">ຂໍ້ມູນໃນຖານຂໍ້ມູນ</target>
      </trans-unit>
      <trans-unit id="index_config.type.I.2" approved="yes">
        <source>Filepath on server</source>
        <target state="final">ເສັ້ນທາງໄຟລ໌ເທິງເຊີບເວີ</target>
      </trans-unit>
      <trans-unit id="index_config.type.I.3" approved="yes">
        <source>External URL</source>
        <target state="final">URL ພາຍນອກ</target>
      </trans-unit>
      <trans-unit id="index_config.type.I.4" approved="yes">
        <source>Page tree</source>
        <target state="final">ແຜນພູມໜ້າເວັບ</target>
      </trans-unit>
      <trans-unit id="index_config.type.I.5" approved="yes">
        <source>Meta configuration</source>
        <target state="final">ການຕັ້ງຄ່າ Meta</target>
      </trans-unit>
      <trans-unit id="index_config.type" approved="yes">
        <source>Type</source>
        <target state="final">ປະເພດ</target>
      </trans-unit>
      <trans-unit id="index_config.depth" approved="yes">
        <source>Depth</source>
        <target state="final">ຄວາມເລິກ</target>
      </trans-unit>
      <trans-unit id="index_config.table2index" approved="yes">
        <source>Table to index</source>
        <target state="final">ຕາຕະລາງທີ່ຈະເຮັດດັດສະນີ</target>
      </trans-unit>
      <trans-unit id="index_config.table2index.I.0" translate="no" approved="yes">
        <source>-</source>
        <target state="final">-</target>
      </trans-unit>
      <trans-unit id="index_config.alternative_source_pid" approved="yes">
        <source>Alternative Source Page</source>
        <target state="final">ໜ້າຕົ້ນທາງທາງເລືອກ</target>
      </trans-unit>
      <trans-unit id="index_config.get_params" approved="yes">
        <source>GET parameter string (with ###UID### substitution)</source>
        <target state="final">ຂໍ້ຄວາມພາລາມິເຕີ GET (ແທນທີ່ດ້ວຍ ###UID###)</target>
      </trans-unit>
      <trans-unit id="index_config.fields" approved="yes">
        <source>Fields (first is title)</source>
        <target state="final">ຟີວ (ຟີວທຳອິດແມ່ນຫົວຂໍ້)</target>
      </trans-unit>
      <trans-unit id="index_config.externalUrl" approved="yes">
        <source>External URL (eg. "http://www.domain.org/")</source>
        <target state="final">URL ພາຍນອກ (ຕົວຢ່າງ: "http://www.domain.org/")</target>
      </trans-unit>
      <trans-unit id="index_config.filepath" approved="yes">
        <source>Filepath</source>
        <target state="final">ເສັ້ນທາງໄຟລ໌
</target>
      </trans-unit>
      <trans-unit id="index_config.extensions" approved="yes">
        <source>Limit to extensions (commalist)</source>
        <target state="final">ຈຳກັດສະເພາະນາມສະກຸນໄຟລ໌ (ແຍກດ້ວຍຈຸດ)</target>
      </trans-unit>
      <trans-unit id="index_config.url_deny" approved="yes">
        <source>Enter sub-URLs in which not to decend</source>
        <target state="final">ປ້ອນ URL ຍ່ອຍທີ່ບໍ່ຕ້ອງການໃຫ້ເຂົ້າໄປກວດສອບ</target>
      </trans-unit>
      <trans-unit id="index_config.records_indexonchange" approved="yes">
        <source>Index Records immediately when saved?</source>
        <target state="final">ເຮັດດັດສະນີຂໍ້ມູນທັນທີເມື່ອບັນທຶກບໍ?</target>
      </trans-unit>
      <trans-unit id="index_config.timer_next_indexing" approved="yes">
        <source>Next indexing is scheduled (if empty, then immediately)</source>
        <target state="final">ກຳນົດເວລາການເຮັດດັດສະນີຄັ້ງຖັດໄປ (ຖ້າຫວ່າງໄວ້, ຈະເລີ່ມທັນທີ)</target>
      </trans-unit>
      <trans-unit id="index_config.timer_offset" approved="yes">
        <source>Timing offset from midnight</source>
        <target state="final">ໄລຍະເວລາເລີ່ມຕົ້ນຫ່າງຈາກທ່ຽງຄືນ</target>
      </trans-unit>
      <trans-unit id="index_config.timer_frequency" approved="yes">
        <source>How often would you like a re-index?</source>
        <target state="final">ເຈົ້າຕ້ອງການໃຫ້ເຮັດດັດສະນີໃໝ່ເລື້ອຍປານໃດ?</target>
      </trans-unit>
      <trans-unit id="index_config.timer_frequency.I.0" approved="yes">
        <source>Every hour</source>
        <target state="final">ທຸກໆຊົ່ວໂມງ</target>
      </trans-unit>
      <trans-unit id="index_config.timer_frequency.I.1" approved="yes">
        <source>Every day (24 hours)</source>
        <target state="final">ທຸກໆມື້ (24 ຊົ່ວໂມງ)</target>
      </trans-unit>
      <trans-unit id="index_config.timer_frequency.I.2" approved="yes">
        <source>Every week</source>
        <target state="final">ທຸກໆອາທິດ</target>
      </trans-unit>
      <trans-unit id="index_config.recordsbatch" approved="yes">
        <source>How many records to index a minute (default is 100)</source>
        <target state="final">ຈຳນວນຂໍ້ມູນທີ່ຈະເຮັດດັດສະນີຕໍ່ນາທີ (ຄ່າເລີ່ມຕົ້ນແມ່ນ 100)</target>
      </trans-unit>
      <trans-unit id="index_config.set_id" approved="yes">
        <source>Session ID (if &gt; zero, then indexing job is running)</source>
        <target state="final">ໄອດີເຊສຊັນ (Session ID) (ຖ້າຫາກຫຼາຍກວ່າສູນ, ສະແດງວ່າວຽກເຮັດດັດສະນີກຳລັງເຮັດວຽກຢູ່)</target>
      </trans-unit>
      <trans-unit id="index_config.indexcfgs" approved="yes">
        <source>Indexing configurations</source>
        <target state="final">ການຕັ້ງຄ່າການເຮັດດັດສະນີ</target>
      </trans-unit>
      <trans-unit id="index_config.parameterCfgs" approved="yes">
        <source>Parameter combination configuration ([tablename]:&amp;[param]=###UID###)</source>
        <target state="final">ການຕັ້ງຄ່າການປະສົມພາລາມິເຕີ ([tablename]:&amp;[param]=###UID###)</target>
      </trans-unit>
      <trans-unit id="index_config.rootpage" approved="yes">
        <source>Root page</source>
        <target state="final">ໜ້າຮາກ</target>
      </trans-unit>
      <trans-unit id="plugin_title" approved="yes">
        <source>Indexed Search</source>
        <target state="final">ການຄົ້ນຫາແບບມີດັດສະນີ (Indexed Search)</target>
      </trans-unit>
      <trans-unit id="plugin_description" approved="yes">
        <source>Search based on a database stored index.</source>
        <target state="final">ຄົ້ນຫາໂດຍອີງໃສ່ດັດສະນີທີ່ເກັບໄວ້ໃນຖານຂໍ້ມູນ.</target>
      </trans-unit>
    </body>
  </file>
</xliff>
