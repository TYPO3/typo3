<?xml version="1.0" encoding="UTF-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" version="1.2">
  <file source-language="en" datatype="plaintext" original="EXT:backend/Resources/Private/Language/Wizards/move_page.xlf" date="2024-03-08T20:22:34Z" product-name="backend" target-language="lo">
    <header/>
    <body>
      <trans-unit id="headline" approved="yes">
        <source>Move page "%1$s" [%2$d]</source>
        <target state="final">ຍ້າຍໜ້າ "%1$s" [%2$d]</target>
      </trans-unit>
      <trans-unit id="currentPath" approved="yes">
        <source>Current path</source>
        <target state="final">ເສັ້ນທາງປັດຈຸບັນ</target>
      </trans-unit>
      <trans-unit id="makeCopy" approved="yes">
        <source>Copy page instead of moving page</source>
        <target state="final">ຄັດລອກໜ້າ ແທນການຍ້າຍໜ້າ</target>
      </trans-unit>
      <trans-unit id="samePageConflict" approved="yes">
        <source>The page "%1$s" [%2$d] cannot get moved into itself.</source>
        <target state="final">ໜ້າ "%1$s" [%2$d] ບໍ່ສາມາດຍ້າຍເຂົ້າໄປຫາຕົວມັນເອງໄດ້.</target>
      </trans-unit>
      <trans-unit id="action.pasteAbove" approved="yes">
        <source>Paste above</source>
        <target state="final">ວາງໄວ້ທາງເທິງ</target>
      </trans-unit>
      <trans-unit id="action.pasteBelow" approved="yes">
        <source>Paste below</source>
        <target state="final">ວາງໄວ້ທາງລຸ່ມ</target>
      </trans-unit>
      <trans-unit id="action.pasteInto" approved="yes">
        <source>Paste into</source>
        <target state="final">ວາງໃສ່ໃນ</target>
      </trans-unit>
      <trans-unit id="movePage.notification.pageMoved.title" approved="yes">
        <source>Page successfully moved</source>
        <target state="final">ຍ້າຍໜ້າສຳເລັດແລ້ວ</target>
      </trans-unit>
      <trans-unit id="movePage.notification.pageMoved.message" approved="yes">
        <source>The page "%s" has been successfully moved.</source>
        <target state="final">ໜ້າ "%s" ຖືກຍ້າຍສຳເລັດແລ້ວ.</target>
      </trans-unit>
      <trans-unit id="movePage.notification.pageCopied.title" approved="yes">
        <source>Page successfully copied</source>
        <target state="final">ຄັດລອກໜ້າສຳເລັດແລ້ວ</target>
      </trans-unit>
      <trans-unit id="movePage.notification.pageCopied.message" approved="yes">
        <source>The page "%s" has been successfully copied.</source>
        <target state="final">ໜ້າ "%s" ຖືກຄັດລອກສຳເລັດແລ້ວ.</target>
      </trans-unit>
      <trans-unit id="movePage.notification.pagePasted.action.dismiss" approved="yes">
        <source>Dismiss</source>
        <target state="final">ປິດອອກ</target>
      </trans-unit>
      <trans-unit id="movePage.notification.pagePasted.action.open" approved="yes">
        <source>Open "%s"</source>
        <target state="final">ເປີດ "%s"</target>
      </trans-unit>
    </body>
  </file>
</xliff>
