  <file source-language="en" datatype="plaintext" original="EXT:backend/Resources/Private/Language/Wizards/general.xlf" date="2026-02-17T00:00:00Z" product-name="backend" target-language="lo">
    <header/>
    <body>
      <trans-unit id="wizard.loading" approved="yes">
        <source>Loading...</source>
        <target state="final">ກຳລັງໂຫຼດ...</target>
      </trans-unit>
      <trans-unit id="wizard.buttons.cancel" approved="yes">
        <source>Cancel</source>
        <target state="final">ຍົກເລີກ</target>
      </trans-unit>
      <trans-unit id="wizard.buttons.next" approved="yes">
        <source>Next</source>
        <target state="final">ຖັດໄປ</target>
      </trans-unit>
      <trans-unit id="wizard.buttons.previous" approved="yes">
        <source>Previous</source>
        <target state="final">ກ່ອນໜ້າ</target>
      </trans-unit>
      <trans-unit id="wizard.buttons.finish" approved="yes">
        <source>Finish</source>
        <target state="final">ສຳເລັດ</target>
      </trans-unit>
      <trans-unit id="wizard.loading_configuration" approved="yes">
        <source>Loading wizard configuration...</source>
        <target state="final">ກຳລັງໂຫຼດການກຳນົດຄ່າຕົວຊ່ວຍສ້າງ...</target>
      </trans-unit>
      <trans-unit id="wizard.loading_steps" approved="yes">
        <source>Loading step modules...</source>
        <target state="final">ກຳລັງໂຫຼດໂມດູນຂັ້ນຕອນ...</target>
      </trans-unit>
      <trans-unit id="wizard.loading_finisher" approved="yes">
        <source>Loading finisher...</source>
        <target state="final">ກຳລັງໂຫຼດຕົວສິ້ນສຸດ...</target>
      </trans-unit>
      <trans-unit id="wizard.status.pending.message" approved="yes">
        <source>Processing data...</source>
        <target state="final">ກຳລັງປະມວນຜົນຂໍ້ມູນ...</target>
      </trans-unit>
      <trans-unit id="wizard.status.error.title" approved="yes">
        <source>Error</source>
        <target state="final">ຂໍ້ຜິດພາດ</target>
      </trans-unit>
      <trans-unit id="wizard.status.error.message" approved="yes">
        <source>Failed to process data:</source>
        <target state="final">ປະມວນຜົນຂໍ້ມູນບໍ່ສຳເລັດ:</target>
      </trans-unit>
      <trans-unit id="wizard.finisher.load_error.message" approved="yes">
        <source>Failed to load finisher module:</source>
        <target state="final">ໂຫຼດໂມດູນຕົວສິ້ນສຸດບໍ່ສຳເລັດ:</target>
      </trans-unit>
      <trans-unit id="wizard.step.error.title" approved="yes">
        <source>Error</source>
        <target state="final">ຂໍ້ຜິດພາດ</target>
      </trans-unit>
      <!-- Step: Confirmation -->
      <trans-unit id="step.confirmation.title" approved="yes">
        <source>Confirmation</source>
        <target state="final">ການຢືນຢັນ</target>
      </trans-unit>
      <trans-unit id="step.confirmation.headline" approved="yes">
        <source>Confirm</source>
        <target state="final">ຢືນຢັນ</target>
      </trans-unit>
      <trans-unit id="step.confirmation.description" approved="yes">
        <source>Please review the following settings before proceeding:</source>
        <target state="final">ກະລຸນາກວດສອບຄືນການຕັ້ງຄ່າຕໍ່ໄປນີ້ ກ່ອນທີ່ຈະດຳເນີນການຕໍ່:</target>
      </trans-unit>
      <!-- Step: Finisher -->
      <trans-unit id="step.finisher.title" approved="yes">
        <source>Finish</source>
        <target state="final">ສຳເລັດ</target>
      </trans-unit>
