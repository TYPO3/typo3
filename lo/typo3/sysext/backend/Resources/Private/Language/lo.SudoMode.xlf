<?xml version="1.0" encoding="UTF-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" version="1.2">
  <file source-language="en" datatype="plaintext" original="EXT:backend/Resources/Private/Language/SudoMode.xlf" date="2023-04-08T00:00:00Z" product-name="backend" target-language="lo">
    <header/>
    <body>
      <trans-unit id="cancel" approved="yes">
        <source>Cancel</source>
        <target state="final">ຍົກເລີກ</target>
      </trans-unit>
      <trans-unit id="verify" approved="yes">
        <source>Verify</source>
        <target state="final">ກວດສອບສິດ</target>
      </trans-unit>
      <trans-unit id="password" approved="yes">
        <source>Password</source>
        <target state="final">ລະຫັດຜ່ານ</target>
      </trans-unit>
      <trans-unit id="verifyWithUserPassword" approved="yes">
        <source>Verify with user password</source>
        <target state="final">ກວດສອບສິດດ້ວຍລະຫັດຜ່ານຜູ້ໃຊ້</target>
      </trans-unit>
      <trans-unit id="verifyWithInstallToolPassword" approved="yes">
        <source>Verify with Install Tool password</source>
        <target state="final">ກວດສອບສິດດ້ວຍລະຫັດຜ່ານເຄື່ອງມືຕິດຕັ້ງ</target>
      </trans-unit>
      <trans-unit id="accessGranted" approved="yes">
        <source>Access granted</source>
        <target state="final">ໄດ້ຮັບອະນຸຍາດໃຫ້ເຂົ້າເຖິງ</target>
      </trans-unit>
      <trans-unit id="invalidPassword" approved="yes">
        <source>Invalid password</source>
        <target state="final">ລະຫັດຜ່ານບໍ່ຖືກຕ້ອງ</target>
      </trans-unit>
      <trans-unit id="userPasswordMode" approved="yes">
        <source>Use user password instead</source>
        <target state="final">ໃຊ້ລະຫັດຜ່ານຜູ້ໃຊ້ແທນ</target>
      </trans-unit>
      <trans-unit id="installToolPasswordMode" approved="yes">
        <source>Use Install Tool password instead</source>
        <target state="final">ໃຊ້ລະຫັດຜ່ານເຄື່ອງມືຕິດຕັ້ງແທນ</target>
      </trans-unit>
      <trans-unit id="sudoModeUserPasswordExplanation" approved="yes">
        <source>Authentication is required to perform this action. Please enter your user password to proceed.</source>
        <target state="final">ຈຳເປັນຕ້ອງມີການຢືນຢັນຕົວຕົນເພື່ອດຳເນີນການນີ້. ກະລຸນາປ້ອນລະຫັດຜ່ານຜູ້ໃຊ້ຂອງທ່ານເພື່ອດຳເນີນການຕໍ່.</target>
      </trans-unit>
      <trans-unit id="sudoModeInstallToolPasswordExplanation" approved="yes">
        <source>Authentication is required to perform this action. Please enter the Install Tool password to proceed.</source>
        <target state="final">ຈຳເປັນຕ້ອງມີການຢືນຢັນຕົວຕົນເພື່ອດຳເນີນການນີ້. ກະລຸນາປ້ອນລະຫັດຜ່ານຂອງເຄື່ອງມືຕິດຕັ້ງເພື່ອດຳເນີນການຕໍ່.</target>
      </trans-unit>
      <trans-unit id="verificationFailed" approved="yes">
        <source>Verification failed</source>
        <target state="final">ການກວດສອບສິດຫຼົ້ມເຫຼວ</target>
      </trans-unit>
      <trans-unit id="verificationExpired" approved="yes">
        <source>Confirmation has expired. Please try again.</source>
        <target state="final">ການຢືນຢັນໝົດອາຍຸແລ້ວ. ກະລຸນາລອງໃໝ່ອີກຄັ້ງ.</target>
      </trans-unit>
    </body>
  </file>
</xliff>
