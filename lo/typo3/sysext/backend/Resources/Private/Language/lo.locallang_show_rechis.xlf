<?xml version="1.0" encoding="UTF-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" version="1.2">
  <file source-language="en" datatype="plaintext" original="EXT:backend/Resources/Private/Language/locallang_show_rechis.xlf" date="2011-10-17T20:22:34Z" product-name="lang" target-language="lo">
    <header/>
    <body>
      <trans-unit id="title" approved="yes">
        <source>History/Undo</source>
        <target state="final">ປະຫວັດ/ຍ້ອນກັບ</target>
      </trans-unit>
      <trans-unit id="headline.titleOf" approved="yes">
        <source>of</source>
        <target state="final">ຂອງ</target>
      </trans-unit>
      <trans-unit id="time" approved="yes">
        <source>Time</source>
        <target state="final">ເວລາ</target>
      </trans-unit>
      <trans-unit id="user" approved="yes">
        <source>User</source>
        <target state="final">ຜູ້ໃຊ້</target>
      </trans-unit>
      <trans-unit id="workspace" approved="yes">
        <source>Workspace</source>
        <target state="final">ພື້ນທີ່ເຮັດວຽກ</target>
      </trans-unit>
      <trans-unit id="column.action" approved="yes">
        <source>Action</source>
        <target state="final">ການກະທຳ</target>
      </trans-unit>
      <trans-unit id="column.recordTitle" approved="yes">
        <source>Title</source>
        <target state="final">ຫົວຂໍ້</target>
      </trans-unit>
      <trans-unit id="differences" approved="yes">
        <source>Differences</source>
        <target state="final">ຂໍ້ແຕກຕ່າງ</target>
      </trans-unit>
      <trans-unit id="changes" approved="yes">
        <source>Changelog</source>
        <target state="final">ບັນທຶກການປ່ຽນແປງ</target>
      </trans-unit>
      <trans-unit id="return" approved="yes">
        <source>Return</source>
        <target state="final">ກັບຄືນ</target>
      </trans-unit>
      <trans-unit id="returnLink" approved="yes">
        <source>Click here to go back</source>
        <target state="final">ກົດບ່ອນນີ້ເພື່ອຍ້ອນກັບ</target>
      </trans-unit>
      <trans-unit id="revertAll" approved="yes">
        <source>Rollback all changes shown</source>
        <target state="final">ຍ້ອນກັບທຸກການປ່ຽນແປງທີ່ສະແດງ</target>
      </trans-unit>
      <trans-unit id="revertRecord" approved="yes">
        <source>Rollback single record</source>
        <target state="final">ຍ້ອນກັບສະເພາະບັນທຶກນີ້</target>
      </trans-unit>
      <trans-unit id="revertField" approved="yes">
        <source>Rollback single field</source>
        <target state="final">ຍ້ອນກັບສະເພາະຫ້ອງຂໍ້ມູນນີ້</target>
      </trans-unit>
      <trans-unit id="userNotFound" approved="yes">
        <source>Not found (non-existent user)</source>
        <target state="final">ບໍ່ພົບ (ບໍ່ມີຜູ້ໃຊ້ນີ້)</target>
      </trans-unit>
      <trans-unit id="externalChange" approved="yes">
        <source>Automated process (missing user information)</source>
        <target state="final">ຂະບວນການອັດຕະໂນມັດ (ບໍ່ມີຂໍ້ມູນຜູ້ໃຊ້)</target>
      </trans-unit>
      <trans-unit id="viaUser" approved="yes">
        <source>via</source>
        <target state="final">ຜ່ານ</target>
      </trans-unit>
      <trans-unit id="sumUpChanges" approved="yes">
        <source>Rollback all changes to this state (preview)</source>
        <target state="final">ຍ້ອນກັບທຸກການປ່ຽນແປງມາຍັງສະຖານະນີ້ (ເບິ່ງຕົວຢ່າງ)</target>
      </trans-unit>
      <trans-unit id="markState" approved="yes">
        <source>mark this change</source>
        <target state="final">ໝາຍການປ່ຽນແປງນີ້</target>
      </trans-unit>
      <trans-unit id="unmarkState" approved="yes">
        <source>unMark this change</source>
        <target state="final">ຍົກເລີກການໝາຍການປ່ຽນແປງນີ້</target>
      </trans-unit>
      <trans-unit id="elementHistory" approved="yes">
        <source>You are currently seeing the history for an element</source>
        <target state="final">ທ່ານກຳລັງເບິ່ງປະຫວັດຂອງອົງປະກອບໜຶ່ງ</target>
      </trans-unit>
      <trans-unit id="elementHistory_link" approved="yes">
        <source>Show the full page history</source>
        <target state="final">ສະແດງປະຫວັດທັງໝົດຂອງໜ້າ</target>
      </trans-unit>
      <trans-unit id="linkRecordHistory" approved="yes">
        <source>Limit history to this record</source>
        <target state="final">ຈຳກັດປະຫວັດໄວ້ສະເພາະບັນທຶກນີ້</target>
      </trans-unit>
      <trans-unit id="differenceMsg" approved="yes">
        <source>In the Difference column you can see the changes at every modification of records. New changes are displayed in green colored text and the red colored text are the old values which were removed.</source>
        <target state="final">ໃນຫ້ອງຂໍ້ແຕກຕ່າງ ທ່ານສາມາດເຫັນການປ່ຽນແປງໃນແຕ່ລະຄັ້ງຂອງການແກ້ໄຂບັນທຶກ. ການປ່ຽນແປງໃໝ່ຈະສະແດງເປັນຕົວໜັງສືສີຂຽວ ແລະ ຕົວໜັງສືສີແດງແມ່ນຄ່າເກົ່າທີ່ຖືກລຶບອອກ.</target>
      </trans-unit>
      <trans-unit id="fullView" approved="yes">
        <source>Return to full view</source>
        <target state="final">ກັບຄືນສູ່ການເບິ່ງແບບເຕັມ</target>
      </trans-unit>
      <trans-unit id="historyRow.actiontype.1" approved="yes">
        <source>created</source>
        <target state="final">ສ້າງແລ້ວ</target>
      </trans-unit>
      <trans-unit id="historyRow.actiontype.2" approved="yes">
        <source>modified</source>
        <target state="final">ແກ້ໄຂແລ້ວ</target>
      </trans-unit>
      <trans-unit id="historyRow.actiontype.3" approved="yes">
        <source>moved</source>
        <target state="final">ຍ້າຍແລ້ວ</target>
      </trans-unit>
      <trans-unit id="historyRow.actiontype.4" approved="yes">
        <source>deleted</source>
        <target state="final">ລຶບແລ້ວ</target>
      </trans-unit>
      <trans-unit id="historyRow.actiontype.5" approved="yes">
        <source>undeleted</source>
        <target state="final">ກູ້ຄືນແລ້ວ</target>
      </trans-unit>
      <trans-unit id="historyRow.actiontype.6" approved="yes">
        <source>stage changed</source>
        <target state="final">ປ່ຽນຂັ້ນຕອນແລ້ວ</target>
      </trans-unit>
      <trans-unit id="historyRow.actiontype.7" approved="yes">
        <source>published</source>
        <target state="final">ເຜີຍແຜ່ແລ້ວ</target>
      </trans-unit>
      <trans-unit id="rollback.plannedAction.insert" approved="yes">
        <source>The record has been deleted and will be restored again with the rollback.</source>
        <target state="final">ບັນທຶກນີ້ຖືກລຶບໄປແລ້ວ ແລະ ຈະຖືກກູ້ຄືນໃໝ່ດ້ວຍການຍ້ອນກັບ.</target>
      </trans-unit>
      <trans-unit id="rollback.plannedAction.delete" approved="yes">
        <source>The record will be deleted with the rollback.</source>
        <target state="final">ບັນທຶກນີ້ຈະຖືກລຶບອອກດ້ວຍການຍ້ອນກັບ.</target>
      </trans-unit>
      <trans-unit id="undelete" approved="yes">
        <source>undelete</source>
        <target state="final">ກູ້ຄືນການລຶບ</target>
      </trans-unit>
      <trans-unit id="mergedDifferences" approved="yes">
        <source>Preview for rollback</source>
        <target state="final">ເບິ່ງຕົວຢ່າງກ່ອນຍ້ອນກັບ</target>
      </trans-unit>
      <trans-unit id="mergedDifferences.description" approved="yes">
        <source>It is possible to rollback either individual fields or entire elements. Alternatively, all displayed changes can be rolled back.</source>
        <target state="final">ທ່ານສາມາດຍ້ອນກັບສະເພາະບາງຫ້ອງຂໍ້ມູນ ຫຼື ທັງໝົດອົງປະກອບ. ຫຼື ສາມາດຍ້ອນກັບທຸກການປ່ຽນແປງທີ່ສະແດງຢູ່ນີ້ກໍໄດ້.</target>
      </trans-unit>
      <trans-unit id="settings" approved="yes">
        <source>Settings</source>
        <target state="final">ການຕັ້ງຄ່າ</target>
      </trans-unit>
      <trans-unit id="maxSteps" approved="yes">
        <source>Show entries</source>
        <target state="final">ສະແດງລາຍການ</target>
      </trans-unit>
      <trans-unit id="maxSteps_all" approved="yes">
        <source>ALL</source>
        <target state="final">ທັງໝົດ</target>
      </trans-unit>
      <trans-unit id="maxSteps_marked" approved="yes">
        <source>marked</source>
        <target state="final">ໝາຍໄວ້</target>
      </trans-unit>
      <trans-unit id="showDiff" approved="yes">
        <source>Show differences</source>
        <target state="final">ສະແດງຂໍ້ແຕກຕ່າງ</target>
      </trans-unit>
      <trans-unit id="showSubElements" approved="yes">
        <source>Show sub elements</source>
        <target state="final">ສະແດງອົງປະກອບຍ່ອຍ</target>
      </trans-unit>
      <trans-unit id="no" approved="yes">
        <source>No</source>
        <target state="final">ບໍ່</target>
      </trans-unit>
      <trans-unit id="yes" approved="yes">
        <source>Yes</source>
        <target state="final">ແມ່ນ</target>
      </trans-unit>
      <trans-unit id="noDifferences" approved="yes">
        <source>There are no differences to the current page</source>
        <target state="final">ບໍ່ມີຂໍ້ແຕກຕ່າງໃນໜ້າປັດຈຸບັນ</target>
      </trans-unit>
      <trans-unit id="editLockIsActive" approved="yes">
        <source>Editing is blocked for non-admins</source>
        <target state="final">ການແກ້ໄຂຖືກລະງັບໄວ້ສຳລັບຜູ້ທີ່ບໍ່ແມ່ນຜູ້ດູແລລະບົບ</target>
      </trans-unit>
    </body>
  </file>
