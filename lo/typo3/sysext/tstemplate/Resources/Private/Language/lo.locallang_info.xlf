<?xml version="1.0" encoding="UTF-8"?>
<xliff xmlns:t3="http://typo3.org/schemas/xliff" version="1.0">
  <file t3:id="1415815005" source-language="en" datatype="plaintext" original="EXT:tstemplate/Resources/Private/Language/locallang_info.xlf" date="2011-10-17T20:22:37Z" product-name="tstemplate" target-language="lo">
    <header/>
    <body>
      <trans-unit id="delete" resname="delete" approved="yes">
        <source>Delete</source>
        <target state="final">ລຶບ</target>
      </trans-unit>
      <trans-unit id="toTop" resname="toTop" approved="yes">
        <source>To top</source>
        <target state="final">ໄປເທິງສຸດ</target>
      </trans-unit>
      <trans-unit id="fileChanged" resname="fileChanged" approved="yes">
        <source>File changed</source>
        <target state="final">ໄຟລ໌ມີການປ່ຽນແປງ</target>
      </trans-unit>
      <trans-unit id="resourceUpdated" resname="resourceUpdated" approved="yes">
        <source>Resource '%s' has been updated.</source>
        <target state="final">ຊັບພະຍາກອນ '%s' ໄດ້ຮັບການອັບເດດແລ້ວ.</target>
      </trans-unit>
      <trans-unit id="templateInformation" resname="templateInformation" approved="yes">
        <source>Template information</source>
        <target state="final">ຂໍ້ມູນແມ່ແບບ</target>
      </trans-unit>
      <trans-unit id="title" resname="title" approved="yes">
        <source>Title</source>
        <target state="final">ຊື່</target>
      </trans-unit>
      <trans-unit id="sitetitle" resname="sitetitle" approved="yes">
        <source>Sitetitle</source>
        <target state="final">ຊື່ເວັບໄຊ</target>
      </trans-unit>
      <trans-unit id="description" resname="description" approved="yes">
        <source>Description</source>
        <target state="final">ຄຳອະທິບາຍ</target>
      </trans-unit>
      <trans-unit id="allowedExtensions" resname="allowedExtensions" approved="yes">
        <source>Allowed extensions</source>
        <target state="final">ນາມສະກຸນໄຟລ໌ທີ່ອະນຸຍາດ</target>
      </trans-unit>
      <trans-unit id="maxFilesize" resname="maxFilesize" approved="yes">
        <source>Max filesize</source>
        <target state="final">ຂະໜາດໄຟລ໌ສູງສຸດ</target>
      </trans-unit>
      <trans-unit id="uploadResource" resname="uploadResource" approved="yes">
        <source>Upload resource</source>
        <target state="final">ອັບໂຫຼດຊັບພະຍາກອນ</target>
      </trans-unit>
      <trans-unit id="newTextResource" resname="newTextResource" approved="yes">
        <source>New text resource (enter name)</source>
        <target state="final">ສ້າງຊັບພະຍາກອນຂໍ້ຄວາມໃໝ່ (ໃສ່ຊື່)</target>
      </trans-unit>
      <trans-unit id="copyResource" resname="copyResource" approved="yes">
        <source>Make a copy of resource</source>
        <target state="final">ສ້າງສຳເນົາຊັບພະຍາກອນ</target>
      </trans-unit>
      <trans-unit id="updateResourceList" resname="updateResourceList" approved="yes">
        <source>Update resource list</source>
        <target state="final">ອັບເດດລາຍຊື່ຊັບພະຍາກອນ</target>
      </trans-unit>
      <trans-unit id="constants" resname="constants" approved="yes">
        <source>Constants</source>
        <target state="final">ຄ່າຄົງທີ່ (Constants)</target>
      </trans-unit>
      <trans-unit id="file" resname="file" approved="yes">
        <source>File</source>
        <target state="final">ໄຟລ໌</target>
      </trans-unit>
      <trans-unit id="editResource" resname="editResource" approved="yes">
        <source>Edit Resource</source>
        <target state="final">ແກ້ໄຂຊັບພະຍາກອນ</target>
      </trans-unit>
      <trans-unit id="filesizeExceeded" resname="filesizeExceeded" approved="yes">
        <source>Filesize exceeded %s KBytes</source>
        <target state="final">ຂະໜາດໄຟລ໌ເກີນ %s KBytes</target>
      </trans-unit>
      <trans-unit id="notAllowed" resname="notAllowed" approved="yes">
        <source>Files larger than %s KBytes are not allowed to be edited.</source>
        <target state="final">ໄຟລ໌ທີ່ມີຂະໜາດໃຫຍ່ກວ່າ %s KBytes ບໍ່ໄດ້ຮັບອະນຸຍາດໃຫ້ແກ້ໄຂ.</target>
      </trans-unit>
      <trans-unit id="setup" resname="setup" approved="yes">
        <source>Setup</source>
        <target state="final">ການຕັ້ງຄ່າ (Setup)</target>
      </trans-unit>
      <trans-unit id="resources" resname="resources" approved="yes">
        <source>Resources</source>
        <target state="final">ຊັບພະຍາກອນ</target>
      </trans-unit>
      <trans-unit id="editToView" resname="editToView" approved="yes">
        <source>(edit to view, %s lines)</source>
        <target state="final">(ແກ້ໄຂເພື່ອເບິ່ງ, %s ແຖວ)</target>
      </trans-unit>
      <trans-unit id="editTemplateRecord" resname="editTemplateRecord" approved="yes">
        <source>Edit the whole template record</source>
        <target state="final">ແກ້ໄຂບັນທຶກແມ່ແບບທັງໝົດ</target>
      </trans-unit>
    </body>
  </file>
