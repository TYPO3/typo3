<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" version="1.2">
  <file source-language="en" datatype="plaintext" original="EXT:filelist/Resources/Private/Language/locallang.xlf" date="2015-08-21T11:45:35Z" product-name="filelist" target-language="lo">
    <header/>
    <body>
      <trans-unit id="search" approved="yes">
        <source>Search "%s" in %s</source>
        <target state="final">ຄົ້ນຫາ "%s" ໃນ %s</target>
      </trans-unit>
      <trans-unit id="search.reset" approved="yes">
        <source>Reset search</source>
        <target state="final">ລຶບລ້າງການຄົ້ນຫາ</target>
      </trans-unit>
      <trans-unit id="flashmessage.no_results" approved="yes">
        <source>No results found</source>
        <target state="final">ບໍ່ພົບຜົນການຄົ້ນຫາ</target>
      </trans-unit>
      <trans-unit id="flashmessage.no_results.message" approved="yes">
        <source>This folder does not contain any files for "%s"</source>
        <target state="final">ໂຟນເດີນີ້ບໍ່ມີໄຟລ໌ສຳລັບ "%s"</target>
      </trans-unit>
      <trans-unit id="flashmessage.no_items" approved="yes">
        <source>This folder is empty</source>
        <target state="final">ໂຟນເດີນີ້ວ່າງເປົ່າ</target>
      </trans-unit>
      <trans-unit id="file_upload.php.pagetitle" approved="yes">
        <source>Upload files</source>
        <target state="final">ອັບໂຫຼດໄຟລ໌</target>
      </trans-unit>
      <trans-unit id="file_upload.php.submit" approved="yes">
        <source>Upload files</source>
        <target state="final">ອັບໂຫຼດໄຟລ໌</target>
      </trans-unit>
      <trans-unit id="file_upload.php.files" approved="yes">
        <source>files</source>
        <target state="final">ໄຟລ໌</target>
      </trans-unit>
      <trans-unit id="file_rename.exists.title" approved="yes">
        <source>File exists already</source>
        <target state="final">ມີໄຟລ໌ນີ້ຢູ່ແລ້ວ</target>
      </trans-unit>
      <trans-unit id="file_rename.exists.description" approved="yes">
        <source>You want to rename the file "{0}" to "{1}", but the file "{1}" already exists. How do you want to proceed?</source>
        <target state="final">ເຈົ້າຕ້ອງການປ່ຽນຊື່ໄຟລ໌ຈາກ "{0}" ເປັນ "{1}", ແຕ່ມີໄຟລ໌ "{1}" ຢູ່ແລ້ວ. ເຈົ້າຕ້ອງການດຳເນີນການຕໍ່ແນວໃດ?</target>
      </trans-unit>
      <trans-unit id="file_rename.actions.cancel" approved="yes">
        <source>Cancel</source>
        <target state="final">ຍົກເລີກ</target>
      </trans-unit>
      <trans-unit id="file_rename.actions.rename" approved="yes">
        <source>Rename with unique name</source>
        <target state="final">ປ່ຽນເປັນຊື່ອື່ນທີ່ບໍ່ຊ້ຳກັນ</target>
      </trans-unit>
      <trans-unit id="file_rename.actions.override" approved="yes">
        <source>Overwrite</source>
        <target state="final">ຂຽນທັບ</target>
      </trans-unit>
      <trans-unit id="file_rename.php.pagetitle" approved="yes">
        <source>Rename</source>
        <target state="final">ປ່ຽນຊື່</target>
      </trans-unit>
      <trans-unit id="file_rename.php.submit" approved="yes">
        <source>Rename</source>
        <target state="final">ປ່ຽນຊື່</target>
        <note>This label is not used since TYPO3 v9.</note>
      </trans-unit>
      <trans-unit id="file_rename.php.label.target.file" approved="yes">
        <source>New file name</source>
        <target state="final">ຊື່ໄຟລ໌ໃໝ່</target>
      </trans-unit>
      <trans-unit id="file_rename.php.label.target.folder" approved="yes">
        <source>New folder name</source>
        <target state="final">ຊື່ໂຟນເດີໃໝ່</target>
      </trans-unit>
      <trans-unit id="file_replace.title" approved="yes">
        <source>Replace file "%s"</source>
        <target state="final">ແທນບ່ອນໄຟລ໌ "%s"</target>
      </trans-unit>
      <trans-unit id="file_replace.intro" approved="yes">
        <source>You're about to replace the file "%s".</source>
        <target state="final">ເຈົ້າກຳລັງຈະແທນບ່ອນໄຟລ໌ "%s".</target>
      </trans-unit>
      <trans-unit id="file_replace.new_file.label" approved="yes">
        <source>Select new file</source>
        <target state="final">ເລືອກໄຟລ໌ໃໝ່</target>
      </trans-unit>
      <trans-unit id="file_replace.keepFilename.label" approved="yes">
        <source>Keep current filename "%s"?</source>
        <target state="final">ຮັກສາຊື່ໄຟລ໌ປັດຈຸບັນ "%s" ໄວ້ບໍ່?</target>
      </trans-unit>
      <trans-unit id="file_replace.button.replace" approved="yes">
        <source>Replace</source>
        <target state="final">ແທນບ່ອນ</target>
      </trans-unit>
      <trans-unit id="file_edit.php.pagetitle" approved="yes">
        <source>Edit</source>
        <target state="final">ແກ້ໄຂ</target>
      </trans-unit>
      <trans-unit id="file_edit.php.submit" approved="yes">
        <source>Save</source>
        <target state="final">ບັນທຶກ</target>
      </trans-unit>
      <trans-unit id="file_edit.php.saveAndClose" approved="yes">
        <source>Save and Close</source>
        <target state="final">ບັນທຶກ ແລະ ປິດອອກ</target>
      </trans-unit>
      <trans-unit id="file_edit.php.coundNot" approved="yes">
        <source>This filetype cannot be edited.&lt;br /&gt;The file must have an extension like:&lt;br /&gt;&lt;br
					/&gt; &lt;b&gt;%s&lt;/b&gt;
                </source>
        <target state="final">ປະເພດໄຟລ໌ນີ້ບໍ່ສາມາດແກ້ໄຂໄດ້.&lt;br /&gt;ໄຟລ໌ຕ້ອງມີນາມສະກຸນຄື:&lt;br /&gt;&lt;br
				/&gt; &lt;b&gt;%s&lt;/b&gt;
                </target>
      </trans-unit>
      <trans-unit id="file_newfolder.php.pagetitle" approved="yes">
        <source>New file or folder</source>
        <target state="final">ສ້າງໄຟລ໌ ຫຼື ໂຟນເດີໃໝ່</target>
      </trans-unit>
      <trans-unit id="file_newfolder.php.label_newfolder" approved="yes">
        <source>Folder</source>
        <target state="final">ໂຟນເດີ</target>
      </trans-unit>
      <trans-unit id="file_newfolder.php.submit" approved="yes">
        <source>Create folders</source>
        <target state="final">ສ້າງໂຟນເດີ</target>
      </trans-unit>
      <trans-unit id="file_newfolder.php.folders" approved="yes">
        <source>folders</source>
        <target state="final">ໂຟນເດີ</target>
      </trans-unit>
      <trans-unit id="file_newfolder.php.newfile_submit" approved="yes">
        <source>Create file</source>
        <target state="final">ສ້າງໄຟລ໌</target>
      </trans-unit>
      <trans-unit id="file_newfolder.php.newfile" approved="yes">
        <source>Create new textfile</source>
        <target state="final">ສ້າງໄຟລ໌ຂໍ້ຄວາມໃໝ່</target>
      </trans-unit>
      <trans-unit id="file_newfolder.php.label_newfile" approved="yes">
        <source>File name</source>
        <target state="final">ຊື່ໄຟລ໌</target>
      </trans-unit>
      <trans-unit id="file_newfolder.php.number_of_folders" approved="yes">
        <source>Number of folders</source>
        <target state="final">ຈຳນວນໂຟນເດີ</target>
      </trans-unit>
      <trans-unit id="download" approved="yes">
        <source>Download</source>
        <target state="final">ດາວໂຫຼດ</target>
      </trans-unit>
      <trans-unit id="actions.new_folder" approved="yes">
        <source>New Folder</source>
        <target state="final">ໂຟນເດີໃໝ່</target>
      </trans-unit>
      <trans-unit id="actions.new_file" approved="yes">
        <source>New File</source>
        <target state="final">ໄຟລ໌ໃໝ່</target>
      </trans-unit>
      <trans-unit id="translations" approved="yes">
        <source>Translations</source>
        <target state="final">ການແປພາສາ</target>
      </trans-unit>
    </body>
  </file>
