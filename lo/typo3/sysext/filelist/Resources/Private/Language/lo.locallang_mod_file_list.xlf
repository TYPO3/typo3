<?xml version="1.0" encoding="UTF-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" version="1.2">
  <file source-language="en" datatype="plaintext" original="EXT:filelist/Resources/Private/Language/locallang_mod_file_list.xlf" date="2011-10-17T20:22:34Z" product-name="lang" target-language="lo">
    <header/>
    <body>
      <trans-unit id="clipBoard" approved="yes">
        <source>Show clipboard</source>
        <target state="final">ສະແດງຄລິບບອດ</target>
      </trans-unit>
      <trans-unit id="clip_paste" approved="yes">
        <source>Paste in clipboard content</source>
        <target state="final">ວາງເນື້ອຫາໃນຄລິບບອດ</target>
      </trans-unit>
      <trans-unit id="clip_pasteInto" approved="yes">
        <source>Paste into: Clipboard content is inserted into this folder</source>
        <target state="final">ວາງໃສ່: ເນື້ອຫາໃນຄລິບບອດຈະຖືກແຊກລົງໃນໂຟນເດີນີ້</target>
      </trans-unit>
      <trans-unit id="editMarked" approved="yes">
        <source>Edit Metadata</source>
        <target state="final">ແກ້ໄຂຂໍ້ມູນກຳກັບ (Metadata)</target>
      </trans-unit>
      <trans-unit id="editColumns" approved="yes">
        <source>Edit specific Metadata</source>
        <target state="final">ແກ້ໄຂຂໍ້ມູນກຳກັບສະເພາະ</target>
      </trans-unit>
      <trans-unit id="deleteMarked" approved="yes">
        <source>Delete marked items</source>
        <target state="final">ລຶບລາຍການທີ່ໝາຍໄວ້</target>
      </trans-unit>
      <trans-unit id="clip_selectMarked" approved="yes">
        <source>Transfer to clipboard</source>
        <target state="final">ຍ້າຍໄປໄວ້ໃນຄລິບບອດ</target>
      </trans-unit>
      <trans-unit id="clip_deleteMarked" approved="yes">
        <source>Remove from clipboard</source>
        <target state="final">ເອົາອອກຈາກຄລິບບອດ</target>
      </trans-unit>
      <trans-unit id="deleteMarkedWarning" approved="yes">
        <source>Are you sure you want to delete all marked items from this folder?</source>
        <target state="final">ເຈົ້າແນ່ໃຈບໍ່ວ່າຕ້ອງການລຶບລາຍການທີ່ໝາຍໄວ້ທັງໝົດອອກຈາກໂຟນເດີນີ້?</target>
      </trans-unit>
      <trans-unit id="c_name" approved="yes">
        <source>Name</source>
        <target state="final">ຊື່</target>
      </trans-unit>
      <trans-unit id="c_size" approved="yes">
        <source>Size</source>
        <target state="final">ຂະໜາດ</target>
      </trans-unit>
      <trans-unit id="c_record_type" approved="yes">
        <source>Type</source>
        <target state="final">ປະເພດ</target>
      </trans-unit>
      <trans-unit id="c_rw" approved="yes">
        <source>RW</source>
        <target state="final">RW</target>
      </trans-unit>
      <trans-unit id="files" approved="yes">
        <source>files</source>
        <target state="final">ໄຟລ໌</target>
      </trans-unit>
      <trans-unit id="temp" approved="yes">
        <source>Temporary files</source>
        <target state="final">ໄຟລ໌ຊົ່ວຄາວ</target>
      </trans-unit>
      <trans-unit id="read" approved="yes">
        <source>R</source>
        <target state="final">R</target>
      </trans-unit>
      <trans-unit id="recycler" approved="yes">
        <source>Recycler</source>
        <target state="final">ຖັງຂີ້ເຫຍື້ອ</target>
      </trans-unit>
      <trans-unit id="write" approved="yes">
        <source>W</source>
        <target state="final">W</target>
      </trans-unit>
      <trans-unit id="storageNotBrowsableTitle" approved="yes">
        <source>Access denied.</source>
        <target state="final">ປະຕິເສດການເຂົ້າເຖິງ.</target>
      </trans-unit>
      <trans-unit id="storageNotBrowsableMessage" approved="yes">
        <source>You are trying to access a folder in a storage that is not browsable.</source>
        <target state="final">ເຈົ້າກຳລັງພະຍາຍາມເຂົ້າເຖິງໂຟນເດີໃນບ່ອນເກັບຂໍ້ມູນທີ່ບໍ່ສາມາດເບິ່ງໄດ້.</target>
      </trans-unit>
      <trans-unit id="missingFolderPermissionsTitle" approved="yes">
        <source>Missing folder permissions</source>
        <target state="final">ຂາດການອະນຸຍາດເຂົ້າເຖິງໂຟນເດີ</target>
      </trans-unit>
      <trans-unit id="missingFolderPermissionsMessage" approved="yes">
        <source>You have no access to the folder "%s".</source>
        <target state="final">ເຈົ້າບໍ່ມີສິດເຂົ້າເຖິງໂຟນເດີ "%s".</target>
      </trans-unit>
      <trans-unit id="localStorageOfflineTitle" approved="yes">
        <source>Base folder for local storage missing or not allowed</source>
        <target state="final">ບໍ່ພົບໂຟນເດີຫຼັກສຳລັບການເກັບຂໍ້ມູນພາຍໃນ ຫຼື ບໍ່ໄດ້ຮັບອະນຸຍາດ</target>
      </trans-unit>
      <trans-unit id="localStorageOfflineMessage" approved="yes">
        <source>Verify that the base folder for the storage "%s" exists and is allowed to be accessed.</source>
        <target state="final">ກວດສອບວ່າໂຟນເດີຫຼັກສຳລັບບ່ອນເກັບຂໍ້ມູນ "%s" ມີຢູ່ ແລະ ໄດ້ຮັບອະນຸຍາດໃຫ້ເຂົ້າເຖິງ.</target>
      </trans-unit>
      <trans-unit id="folderNotFoundTitle" approved="yes">
        <source>Folder not found.</source>
        <target state="final">ບໍ່ພົບໂຟນເດີ.</target>
      </trans-unit>
      <trans-unit id="folderNotFoundMessage" approved="yes">
        <source>The folder "%s" cannot be accessed. Trying to use parent folder(s).</source>
        <target state="final">ບໍ່ສາມາດເຂົ້າເຖິງໂຟນເດີ "%s" ໄດ້. ກຳລັງພະຍາຍາມໃຊ້ໂຟນເດີຫຼັກ.</target>
      </trans-unit>
      <trans-unit id="translateMetadata" approved="yes">
        <source>Translate metadata</source>
        <target state="final">ແປຂໍ້ມູນກຳກັບ</target>
      </trans-unit>
      <trans-unit id="createMetadataForLanguage" approved="yes">
        <source>Create metadata of this file for %s</source>
        <target state="final">ສ້າງຂໍ້ມູນກຳກັບຂອງໄຟລ໌ນີ້ສຳລັບ %s</target>
      </trans-unit>
      <trans-unit id="editMetadataForLanguage" approved="yes">
        <source>Edit metadata of this file for %s</source>
        <target state="final">ແກ້ໄຂຂໍ້ມູນກຳກັບຂອງໄຟລ໌ນີ້ສຳລັບ %s</target>
      </trans-unit>
      <trans-unit id="paramError" approved="yes">
        <source>Parameter Error</source>
        <target state="final">ພາຣາມິເຕີຜິດພາດ</target>
      </trans-unit>
      <trans-unit id="targetNoDir" approved="yes">
        <source>Target was not a directory!</source>
        <target state="final">ເປົ້າໝາຍບໍ່ແມ່ນໄດເຣັກທໍຣີ!</target>
      </trans-unit>
      <trans-unit id="reloadMetadata" approved="yes">
        <source>Reload Metadata</source>
        <target state="final">ໂຫລດຂໍ້ມູນກຳກັບຄືນໃໝ່</target>
      </trans-unit>
      <trans-unit id="rangeIndicator" approved="yes">
        <source>Media %1$d - %2$d</source>
        <target state="final">ສື່ %1$d - %2$d</target>
      </trans-unit>
    </body>
  </file>
</xliff>
