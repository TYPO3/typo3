<?xml version="1.0" encoding="UTF-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" version="1.2">
  <file source-language="en" datatype="plaintext" original="EXT:redirects/Resources/Private/Language/Modules/qrcodes.xlf" date="2025-11-13T18:00:15Z" product-name="redirects" target-language="lo">
    <header/>
    <body>
      <trans-unit id="title" approved="yes">
        <source>QR Codes</source>
        <target state="final">ຄິວອານໂຄດ (QR Codes)</target>
      </trans-unit>
      <trans-unit id="short_description" approved="yes">
        <source>QR Codes Administration</source>
        <target state="final">ການບໍລິຫານຄິວອານໂຄດ</target>
      </trans-unit>
      <trans-unit id="description" approved="yes">
        <source>Generate and customize QR codes to provide quick, scannable access to your digital content.</source>
        <target state="final">ສ້າງ ແລະ ປັບແຕ່ງລະຫັດ QR ເພື່ອໃຫ້ການເຂົ້າເຖິງເນື້ອຫາດີຈີຕອນຂອງທ່ານໄດ້ຢ່າງວ່ອງໄວ ແລະ ສາມາດສະແກນໄດ້.</target>
      </trans-unit>
      <trans-unit id="heading_text" approved="yes">
        <source>QR Code Management</source>
        <target state="final">ການຈັດການຄິວອານໂຄດ</target>
      </trans-unit>
      <trans-unit id="add_text" approved="yes">
        <source>Add QR Code</source>
        <target state="final">ເພີ່ມຄິວອານໂຄດ</target>
      </trans-unit>
      <trans-unit id="not_found_with_filter.message" approved="yes">
        <source>No QR Code could be found with the current set of filters applied.</source>
        <target state="final">ບໍ່ພົບລະຫັດ QR ຕາມຊຸດຕົວຕອງທີ່ນຳໃຊ້ໃນປະຈຸບັນ.</target>
      </trans-unit>
      <trans-unit id="not_found.title" approved="yes">
        <source>No QR Codes found</source>
        <target state="final">ບໍ່ພົບລະຫັດ QR</target>
      </trans-unit>
      <trans-unit id="not_found.message" approved="yes">
        <source>There are currently no QR Codes found in the database.</source>
        <target state="final">ປັດຈຸບັນບໍ່ພົບຂໍ້ມູນຄິວອານໂຄດໃນຖານຂໍ້ມູນ.</target>
      </trans-unit>
      <trans-unit id="create" approved="yes">
        <source>Create new QR Code</source>
        <target state="final">ສ້າງຄິວອານໂຄດໃໝ່</target>
      </trans-unit>
      <trans-unit id="delete.title" approved="yes">
        <source>Delete QR Codes</source>
        <target state="final">ລຶບຄິວອານໂຄດ</target>
      </trans-unit>
      <trans-unit id="delete.message" approved="yes">
        <source>Delete all marked QR Codes permanently? You cannot undo this action.</source>
        <target state="final"> ລຶບລະຫັດ QR ທັງໝົດທີ່ໝາຍໄວ້ຢ່າງຖາວອນບໍ? ທ່ານບໍ່ສາມາດກັບຄືນການເຮັດວຽກນີ້ໄດ້.</target>
      </trans-unit>
      <trans-unit id="download" approved="yes">
        <source>Download</source>
        <target state="final">ດາວໂຫຼດ</target>
      </trans-unit>
      <trans-unit id="show" approved="yes">
        <source>Show QR Code</source>
        <target state="final">ສະແດງຄິວອານໂຄດ</target>
      </trans-unit>
    </body>
  </file>
</xliff>
