<?xml version="1.0" encoding="UTF-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" version="1.2">
  <file source-language="en" datatype="plaintext" original="EXT:redirects/Resources/Private/Language/locallang_slug_service.xlf" date="2017-12-29T20:23:34Z" product-name="redirects" target-language="lo">
    <header/>
    <body>
      <trans-unit id="notification.slug_and_redirects.title" approved="yes">
        <source>Slugs updated and redirects created</source>
        <target state="final">ອັບເດດ Slug ແລ້ວ ແລະ ສ້າງການປ່ຽນເສັ້ນທາງແລ້ວ</target>
      </trans-unit>
      <trans-unit id="notification.slug_only.title" approved="yes">
        <source>Slugs updated</source>
        <target state="final">ອັບເດດ Slug ແລ້ວ</target>
      </trans-unit>
      <trans-unit id="notification.redirects.button.revert_update" approved="yes">
        <source>Revert update</source>
        <target state="final">ຄືນຄ່າການອັບເດດ</target>
      </trans-unit>
      <trans-unit id="notification.redirects.button.revert_redirect" approved="yes">
        <source>Revert redirects only</source>
        <target state="final">ຄືນຄ່າສະເພາະການປ່ຽນເສັ້ນທາງ</target>
      </trans-unit>
      <trans-unit id="redirects_error_title" approved="yes">
        <source>An error occurred</source>
        <target state="final">ເກີດຂໍ້ຜິດພາດຂຶ້ນ</target>
      </trans-unit>
      <trans-unit id="redirects_error_message" approved="yes">
        <source>Sorry something went wrong.</source>
        <target state="final">ຂໍອະໄພ, ມີບາງຢ່າງຜິດພາດ.</target>
      </trans-unit>
      <trans-unit id="revert_update_success_title" approved="yes">
        <source>Revert successful</source>
        <target state="final">ຄືນຄ່າສຳເລັດແລ້ວ</target>
      </trans-unit>
      <trans-unit id="revert_update_success_message" approved="yes">
        <source>All slug changes of sub pages have been reverted.</source>
        <target state="final">ການປ່ຽນແປງ slug ທັງໝົດຂອງໜ້າເວັບຍ່ອຍຖືກຄືນຄ່າແລ້ວ.</target>
      </trans-unit>
      <trans-unit id="revert_redirects_success_title" approved="yes">
        <source>Revert successful</source>
        <target state="final">ຄືນຄ່າສຳເລັດແລ້ວ</target>
      </trans-unit>
      <trans-unit id="revert_redirects_success_message" approved="yes">
        <source>All created redirects have been reverted.</source>
        <target state="final">ການປ່ຽນເສັ້ນທາງທີ່ສ້າງຂຶ້ນທັງໝົດຖືກຄືນຄ່າແລ້ວ.</target>
      </trans-unit>
    </body>
