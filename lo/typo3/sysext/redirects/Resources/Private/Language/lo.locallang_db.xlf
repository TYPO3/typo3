<?xml version="1.0" encoding="UTF-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" version="1.2">
  <file source-language="en" datatype="plaintext" original="EXT:redirects/Resources/Private/Language/locallang_db.xlf" date="2017-12-29T20:22:14Z" product-name="redirects" target-language="lo">
    <header/>
    <body>
      <trans-unit id="sys_redirect" approved="yes">
        <source>Redirect</source>
        <target state="final">ການປ່ຽນເສັ້ນທາງ</target>
      </trans-unit>
      <trans-unit id="sys_redirect.redirect_type.qr_code" approved="yes">
        <source>QR Code</source>
        <target state="final">ຄິວອານໂຄດ (QR Code)</target>
      </trans-unit>
      <trans-unit id="sys_redirect.redirect_type.short_url" approved="yes">
        <source>Short URL</source>
        <target state="final">URL ສັ້ນ</target>
      </trans-unit>
      <trans-unit id="sys_redirect.source_host" approved="yes">
        <source>Source Domain</source>
        <target state="final">ໂດເມນຕົ້ນທາງ</target>
      </trans-unit>
      <trans-unit id="sys_redirect.source_path" approved="yes">
        <source>Source Path</source>
        <target state="final">ເສັ້ນທາງຕົ້ນທາງ</target>
      </trans-unit>
      <trans-unit id="sys_redirect.force_https" approved="yes">
        <source>SSL Redirect</source>
        <target state="final">ການປ່ຽນເສັ້ນທາງ SSL</target>
      </trans-unit>
      <trans-unit id="sys_redirect.force_https.0" approved="yes">
        <source>Force SSL Redirect</source>
        <target state="final">ບັງຄັບການປ່ຽນເສັ້ນທາງ SSL</target>
      </trans-unit>
      <trans-unit id="sys_redirect.keep_query_parameters" approved="yes">
        <source>GET Parameters</source>
        <target state="final">ພາລາມິເຕີ GET</target>
      </trans-unit>
      <trans-unit id="sys_redirect.keep_query_parameters.0" approved="yes">
        <source>Keep GET Parameters</source>
        <target state="final">ຮັກສາພາລາມິເຕີ GET</target>
      </trans-unit>
      <trans-unit id="sys_redirect.respect_query_parameters" approved="yes">
        <source>GET Parameters (source)</source>
        <target state="final">ພາລາມິເຕີ GET (ຕົ້ນທາງ)</target>
      </trans-unit>
      <trans-unit id="sys_redirect.respect_query_parameters.0" approved="yes">
        <source>Respect GET Parameters</source>
        <target state="final">ປະຕິບັດຕາມພາລາມິເຕີ GET</target>
      </trans-unit>
      <trans-unit id="sys_redirect.target" approved="yes">
        <source>Target</source>
        <target state="final">ປາຍທາງ</target>
      </trans-unit>
      <trans-unit id="sys_redirect.target_statuscode" approved="yes">
        <source>Status Code HTTP Header</source>
        <target state="final">ລະຫັດສະຖານະສ່ວນຫົວ HTTP</target>
      </trans-unit>
      <trans-unit id="sys_redirect.target_statuscode.301" approved="yes">
        <source>301 Moved Permanently</source>
        <target state="final">301 ຍ້າຍອອກຖາວອນ</target>
      </trans-unit>
      <trans-unit id="sys_redirect.target_statuscode.302" approved="yes">
        <source>302 Found</source>
        <target state="final">302 ພົບແລ້ວ</target>
      </trans-unit>
      <trans-unit id="sys_redirect.target_statuscode.303" approved="yes">
        <source>303 See Other</source>
        <target state="final">303 ເບິ່ງບ່ອນອື່ນ</target>
      </trans-unit>
      <trans-unit id="sys_redirect.target_statuscode.307" approved="yes">
        <source>307 Temporary Redirect</source>
        <target state="final">307 ການປ່ຽນເສັ້ນທາງຊົ່ວຄາວ</target>
      </trans-unit>
      <trans-unit id="sys_redirect.target_statuscode.308" approved="yes">
        <source>308 Permanent Redirect</source>
        <target state="final">308 ການປ່ຽນເສັ້ນທາງຖາວອນ</target>
      </trans-unit>
      <trans-unit id="sys_redirect.target_statuscode.keep" approved="yes">
        <source>Keep HTTP method</source>
        <target state="final">ຮັກສາວິທີການ HTTP</target>
      </trans-unit>
      <trans-unit id="sys_redirect.target_statuscode.change" approved="yes">
        <source>Change HTTP method to GET</source>
        <target state="final">ປ່ຽນວິທີການ HTTP ເປັນ GET</target>
      </trans-unit>
      <trans-unit id="sys_redirect.hitcount" approved="yes">
        <source>Hit count</source>
        <target state="final">ຈຳນວນການເຂົ້າເຖິງ</target>
      </trans-unit>
      <trans-unit id="sys_redirect.lasthiton" approved="yes">
        <source>Last Hit on</source>
        <target state="final">ເຂົ້າເຖິງຫຼ້າສຸດເມື່ອ</target>
      </trans-unit>
      <trans-unit id="sys_redirect.hitcountState" approved="yes">
        <source>Hit Counter</source>
        <target state="final">ຕົວນັບການເຂົ້າເຖິງ</target>
      </trans-unit>
      <trans-unit id="sys_redirect.disable_hitcount" approved="yes">
        <source>Disable Hit Counter</source>
        <target state="final">ປິດການໃຊ້ງານຕົວນັບການເຂົ້າເຖິງ</target>
      </trans-unit>
      <trans-unit id="sys_redirect.disable_hitcount.0" approved="yes">
        <source>Disable</source>
        <target state="final">ປິດໃຊ້ງານ</target>
      </trans-unit>
      <trans-unit id="tabs.redirectCount" approved="yes">
        <source>Statistics</source>
        <target state="final">ສະຖິຕິ</target>
      </trans-unit>
      <trans-unit id="sys_redirect.protected" approved="yes">
        <source>Protected</source>
        <target state="final">ຖືກປົກປ້ອງ</target>
      </trans-unit>
      <trans-unit id="sys_redirect.protected.description" approved="yes">
        <source>When enabled, this redirect will be skipped by scheduled cleanup tasks that might delete redirects under certain conditions.</source>
        <target state="final">ເມື່ອເປີດໃຊ້ງານ, ການປ່ຽນເສັ້ນທາງນີ້ຈະຖືກຂ້າມໂດຍໜ້າທີ່ການລ້າງຂໍ້ມູນທີ່ກຳນົດເວລາໄວ້ ເຊິ່ງອາດຈະລຶບການປ່ຽນເສັ້ນທາງພາຍໃຕ້ເງື່ອນໄຂໃດໜຶ່ງ.</target>
      </trans-unit>
      <trans-unit id="sys_redirect.is_regexp" approved="yes">
        <source>Is regular expression?</source>
        <target state="final">ແມ່ນ Regular Expression ບໍ?</target>
      </trans-unit>
      <trans-unit id="sys_redirect.is_regexp.0" approved="yes">
        <source>Yes</source>
        <target state="final">ແມ່ນ</target>
      </trans-unit>
      <trans-unit id="sys_redirect.disabled" approved="yes">
        <source>Disable</source>
        <target state="final">ປິດໃຊ້ງານ</target>
      </trans-unit>
      <trans-unit id="sys_redirect.disabled.0" approved="yes">
        <source>Deactivate redirect</source>
        <target state="final">ປິດການປ່ຽນເສັ້ນທາງ</target>
      </trans-unit>
      <trans-unit id="sys_redirect.creation_type" approved="yes">
        <source>Creation Type</source>
        <target state="final">ປະເພດການສ້າງ</target>
      </trans-unit>
      <trans-unit id="sys_redirect.creation_type.description" approved="yes">
        <source>Defines how the redirect was created.</source>
        <target state="final">ກຳນົດວ່າການປ່ຽນເສັ້ນທາງຖືກສ້າງຂຶ້ນແນວໃດ.</target>
      </trans-unit>
      <trans-unit id="sys_redirect.creation_type.1" approved="yes">
        <source>manually created</source>
        <target state="final">ສ້າງຂຶ້ນດ້ວຍຕົນເອງ</target>
      </trans-unit>
      <trans-unit id="sys_redirect.creation_type.0" approved="yes">
        <source>automatically created</source>
        <target state="final">ສ້າງຂຶ້ນໂດຍອັດຕະໂນມັດ</target>
      </trans-unit>
      <trans-unit id="sys_redirect.webhook_type.typo3-redirect-was-hit" approved="yes">
        <source>... when a redirect has been hit</source>
        <target state="final">... ເມື່ອການປ່ຽນເສັ້ນທາງຖືກເຂົ້າເຖິງ</target>
      </trans-unit>
      <trans-unit id="sys_redirect.integrity_status" approved="yes">
        <source>Integrity status</source>
        <target state="final">ສະຖານະຄວາມຖືກຕ້ອງສົມບູນ</target>
      </trans-unit>
      <trans-unit id="sys_redirect.integrity_status.description" approved="yes">
        <source>Redirects can be checked via the command redirects:checkintegrity.</source>
        <target state="final">ການປ່ຽນເສັ້ນທາງສາມາດກວດສອບໄດ້ຜ່ານຄຳສັ່ງ redirects:checkintegrity.</target>
      </trans-unit>
      <trans-unit id="sys_redirect.integrity_status.no_conflict" approved="yes">
        <source>No conflict</source>
        <target state="final">ບໍ່ມີຂໍ້ຂັດແຍ່ງ</target>
      </trans-unit>
      <trans-unit id="sys_redirect.integrity_status.self_reference" approved="yes">
        <source>Self reference</source>
        <target state="final">ການອ້າງອີງຕົນເອງ</target>
      </trans-unit>
      <trans-unit id="sys_redirect.integrity_status.invalid_target" approved="yes">
        <source>Invalid target</source>
        <target state="final">ປາຍທາງບໍ່ຖືກຕ້ອງ</target>
      </trans-unit>
      <trans-unit id="sys_redirect.uid" approved="yes">
        <source>UID</source>
        <target state="final">UID (ໄອດີສະເພາະ)</target>
      </trans-unit>
      <trans-unit id="sys_redirect.createdby" approved="yes">
        <source>Created by</source>
        <target state="final">ສ້າງໂດຍ</target>
      </trans-unit>
      <trans-unit id="sys_redirect.short_url" approved="yes">
        <source>Short URL</source>
        <target state="final">URL ສັ້ນ</target>
      </trans-unit>
      <trans-unit id="sys_redirect.short_url.description" approved="yes">
        <source>Enter a Short URL or generate a random one automatically. Once saved, the Short URL cannot be changed.</source>
        <target state="final">ປ້ອນ URL ສັ້ນ ຫຼື ສ້າງແບບສຸ່ມໂດຍອັດຕະໂນມັດ. ເມື່ອບັນທຶກແລ້ວ, URL ສັ້ນ ຈະບໍ່ສາມາດປ່ຽນແປງໄດ້.</target>
      </trans-unit>
      <trans-unit id="sys_redirect.short_url.shortUrlGenerator" approved="yes">
        <source>Generate Short URL</source>
        <target state="final">ສ້າງ URL ສັ້ນ</target>
      </trans-unit>
    </body>
  </file>
