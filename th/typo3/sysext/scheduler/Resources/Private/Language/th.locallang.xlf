        <target state="final">ข้อมูลเกี่ยวกับการทำงานสุดท้ายของ Scheduler ไม่สมบูรณ์</target>
      </trans-unit>
      <trans-unit id="msg.invalidFrequency" approved="yes">
        <source>Invalid frequency. Please enter either a number of seconds or a valid cron command.</source>
        <target state="final">ความถี่ไม่ถูกต้อง กรุณากรอกจำนวนวินาทีหรือคำสั่ง cron ที่ถูกต้อง</target>
      </trans-unit>
      <trans-unit id="msg.invalidSleepTime" approved="yes">
