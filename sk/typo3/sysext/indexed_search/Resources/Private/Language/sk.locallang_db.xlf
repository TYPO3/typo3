    <header/>
    <body>
      <trans-unit id="index_config" resname="index_config" approved="yes">
        <source>Indexing Configuration</source>
        <target state="final">Konfigurácia indexovania:</target>
      </trans-unit>
      <trans-unit id="index_config.type.I.1" resname="index_config.type.I.1" approved="yes">
        <source>Database Records</source>
        <target state="final">Záznamy databázy</target>
      </trans-unit>
      <trans-unit id="index_config.type.I.2" resname="index_config.type.I.2" approved="yes">
        <source>Filepath on server</source>
        <target state="final">Cesta k súborom na servri</target>
      </trans-unit>
      <trans-unit id="index_config.type.I.3" resname="index_config.type.I.3" approved="yes">
        <source>External URL</source>
        <target state="final">Externá URL</target>
      </trans-unit>
      <trans-unit id="index_config.type.I.4" resname="index_config.type.I.4" approved="yes">
        <source>Page tree</source>
        <target state="final">Strom stránok</target>
      </trans-unit>
      <trans-unit id="index_config.type.I.5" resname="index_config.type.I.5" approved="yes">
        <source>Meta configuration</source>
        <target state="final">Meta konfigurácia</target>
      </trans-unit>
      <trans-unit id="index_config.url_deny" resname="index_config.url_deny" approved="yes">
        <source>Enter sub-URLs in which not to decend</source>
        <target state="final">Vložte pod-URL, které chcete zakázať:</target>
      </trans-unit>
      <trans-unit id="index_config.timer_next_indexing" resname="index_config.timer_next_indexing" approved="yes">
        <source>Next indexing is scheduled (if empty, then immediately)</source>
        <target state="final">Nasledujúce indexovanie je naplánované (pokiaľ nie je vyplnené, tak okamžite):</target>
      </trans-unit>
      <trans-unit id="index_config.timer_frequency.I.0" resname="index_config.timer_frequency.I.0" approved="yes">
        <source>Every hour</source>
        <target state="final">Každú hodinu</target>
      </trans-unit>
      <trans-unit id="index_config.timer_frequency.I.1" resname="index_config.timer_frequency.I.1" approved="yes">
