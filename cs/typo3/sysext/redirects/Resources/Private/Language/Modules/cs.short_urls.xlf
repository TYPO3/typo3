        <target state="final">Trvale odstranit všechny označené zkrácené URL adresy? Tuto akci nelze vrátit zpět.</target>
      </trans-unit>
      <trans-unit id="show" approved="yes">
        <source>Show Short URL</source>
        <target state="final">Zobrazit zkrácenou URL</target>
