    <header/>
    <body>
      <trans-unit id="submodule.title" approved="yes">
        <source>Edit TypoScript record</source>
        <target state="final">Upravit záznam TypoScriptu</target>
      </trans-unit>
      <trans-unit id="submodule.titleWithRecord" approved="yes">
        <source>Edit TypoScript record "%s"</source>
        <target state="final">Upravit záznam TypoScriptu "%s"</target>
      </trans-unit>
      <trans-unit id="submodule.description" approved="yes">
        <source>Modify the content of the selected TypoScript record of the current page. Modifications can be made either for configurations like TypoScript constants and setup or basics like the title and description of the TypoScript record itself.</source>
        <target state="final">Upravit obsah vybraného záznamu TypoScriptu aktuální stránky. Modifikace lze provést buď pro konfigurace, jako jsou typoScript konstanty a nastavení, nebo pro základy, jako je název a popis samotného TypoScriptu.</target>
      </trans-unit>
      <trans-unit id="options.selectedRecord" approved="yes">
        <source>Selected record</source>
        <target state="final">Vybraný záznam</target>
      </trans-unit>
      <trans-unit id="table.column.constants" approved="yes">
        <source>Constants</source>
        <target state="final">Konstanty</target>
      </trans-unit>
      <trans-unit id="table.column.description" approved="yes">
        <source>Description</source>
        <target state="final">Popis</target>
      </trans-unit>
      <trans-unit id="table.column.lines" approved="yes">
        <source>%s lines</source>
        <target state="final">%s řádky</target>
      </trans-unit>
      <trans-unit id="table.column.setup" approved="yes">
        <source>Setup</source>
        <target state="final">Nastavení</target>
      </trans-unit>
      <trans-unit id="table.column.title" approved="yes">
        <source>Title</source>
        <target state="final">Název</target>
      </trans-unit>
      <trans-unit id="btn.editSiteConfiguration" approved="yes">
        <source>Edit site configuration</source>
        <target state="final">Upravit konfiguraci webu</target>
      </trans-unit>
      <trans-unit id="btn.editSiteSettings" approved="yes">
        <source>Edit site settings</source>
        <target state="final">Upravit nastavení webu</target>
      </trans-unit>
      <trans-unit id="btn.editTypoScriptRecord" approved="yes">
        <source>Edit the whole TypoScript record</source>
        <target state="final">Upravit celý záznam TypoScriptu</target>
      </trans-unit>
      <trans-unit id="infoTypoScriptRecordFromSite.title" approved="yes">
        <source>TypoScript settings have been implicitly generated from site sets includes</source>
        <target state="final">Nastavení TypoScriptu bylo implicitně vygenerováno ze sady stránek včetně</target>
      </trans-unit>
      <trans-unit id="infoTypoScriptRecordFromSite.message" approved="yes">
        <source>The site configuration '%s' has one or more dependencies on site sets. The sets can be configured in the 'Sites » Setup' backend module. The TypoScript definitions can be edited on the file system.</source>
        <target state="final">Konfigurace webu „%s“ má jednu nebo více závislostí na webových sadách. Sady lze konfigurovat v backendovém modulu „Weby » Nastavení“. Definice TypoScriptu lze upravovat v systému souborů.</target>
      </trans-unit>
      <trans-unit id="noConstantsButSiteSettings.title" approved="yes">
        <source>Site Settings available</source>
        <target state="final">Dostupná nastavení webu</target>
      </trans-unit>
      <trans-unit id="noConstantsButSiteSettings.message" approved="yes">
        <source>Edit site settings via the 'Sites » Setup' backend module.</source>
        <target state="final">Upravte nastavení webu pomocí modulu „Weby » Nastavení“ v administraci.</target>
      </trans-unit>
