        <target state="final">Záznamy</target>
      </trans-unit>
      <trans-unit id="contentStatistics.noRecords" approved="yes">
        <source>No records found</source>
        <target state="final">Nebyly nalezeny žádné záznamy</target>
      </trans-unit>
