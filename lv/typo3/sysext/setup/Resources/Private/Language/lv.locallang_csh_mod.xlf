<?xml version="1.0" encoding="UTF-8"?>
<xliff xmlns:t3="http://typo3.org/schemas/xliff" version="1.0">
  <file t3:id="1415814989" source-language="en" datatype="plaintext" original="EXT:setup/Resources/Private/Language/locallang_csh_mod.xlf" date="2011-10-17T20:22:37Z" product-name="setup" target-language="lv">
    <header/>
    <body>
      <trans-unit id=".alttitle" resname=".alttitle" approved="yes">
        <source>User &gt; Setup module</source>
        <target state="final">Lietotājs &gt; Uzstādījumi</target>
      </trans-unit>
      <trans-unit id=".image_descr" resname=".image_descr" xml:space="preserve" approved="yes">
				<source>The Setup module is selected in the left menu.
This is how the Setup module interface looks like - a list of options to configure.</source>
			<target state="final">Uzstādījumu modulis tiek izvēlēts no izvēlnes pa kreisi. Šādi izskatās Uzstādījumu moduļa interfeiss - iespēju saraksts konfigurācijai.</target></trans-unit>
      <trans-unit id="language.alttitle" resname="language.alttitle" approved="yes">
        <source>Backend Language selection</source>
        <target state="final">Backend valodas izvēle</target>
      </trans-unit>
      <trans-unit id="language.description" resname="language.description" approved="yes">
        <source>Select the backend language you prefer. Most parts of TYPO3s backend (for regular users) are translated into other languages.</source>
        <target state="final">Izvēlieties backend valodu, kurai dodat priekšroku. Lielākā daļa no TYPO3 backend daļas (parastiem lietotājiem) ir iztulkotas citās valodās.</target>
      </trans-unit>
      <trans-unit id="language.image_descr" resname="language.image_descr" approved="yes">
        <source>TYPO3 is translated into around 40 languages. English is the default language and all labels must be available in English first and foremost. This screenshot shows translations for Hebrew, Arabic, Russian and Chinese.</source>
        <target state="final">TYPO3 ir iztulkots vairāk nekā 40 valodās. Angļu valoda ir noklusējuma valoda, un visi uzraksti angļu valodā ir pieejami sākumā un jebkurā laikā. Šie ekrānšāviņi parāda tulkojumus ebreju, arābu, krievu un ķīniešu valodā.</target>
      </trans-unit>
      <trans-unit id="option_startModule.alttitle" resname="option_startModule.alttitle" approved="yes">
        <source>Start module</source>
        <target state="final">Sākuma modulis</target>
      </trans-unit>
      <trans-unit id="option_startModule.description" resname="option_startModule.description" xml:space="preserve" approved="yes">
				<source>Let you select the module that is called when you login in the Backend
The default module is "About Modules".</source>
			<target state="final">Ļauj izvēlēties moduli, kurš tiek parādīts pēc autorizācijas. Standarta modulis ir "Par moduļiem".</target></trans-unit>
      <trans-unit id="option_showThumbs.alttitle" resname="option_showThumbs.alttitle" approved="yes">
        <source>Show Thumbnails by default</source>
        <target state="final">Rādīt sīkattēlus pēc noklusējuma</target>
      </trans-unit>
      <trans-unit id="option_helpText.alttitle" resname="option_helpText.alttitle" approved="yes">
        <source>Show help text when applicable</source>
        <target state="final">Rādīt palīdzības tekstu, ja tāds ir pieejams</target>
      </trans-unit>
      <trans-unit id="option_maxTitleLen.alttitle" resname="option_maxTitleLen.alttitle" approved="yes">
        <source>Maximum title length</source>
        <target state="final">Maksimālais nosaukuma garums</target>
      </trans-unit>
      <trans-unit id="option_copyLevels.alttitle" resname="option_copyLevels.alttitle" approved="yes">
        <source>Recursive Copy</source>
        <target state="final">Rekursīvā kopēšana</target>
      </trans-unit>
      <trans-unit id="option_recursiveDelete.alttitle" resname="option_recursiveDelete.alttitle" approved="yes">
        <source>Recursive Delete</source>
        <target state="final">Rekursīvā dzēšana</target>
      </trans-unit>
      <trans-unit id="option_edit_RTE.alttitle" resname="option_edit_RTE.alttitle" approved="yes">
        <source>Enable Rich Text Editor</source>
        <target state="final">Aktivizēt Rich Text Editor</target>
      </trans-unit>
      <trans-unit id="option_beUser_realName.alttitle" resname="option_beUser_realName.alttitle" approved="yes">
        <source>Your real name</source>
        <target state="final">Jūsu vārds</target>
      </trans-unit>
      <trans-unit id="option_beUser_realName.description" resname="option_beUser_realName.description" approved="yes">
        <source>Enter your real name here.</source>
        <target state="final">Ievadiet Jūsu īsto vārdu</target>
      </trans-unit>
      <trans-unit id="option_beUser_email.alttitle" resname="option_beUser_email.alttitle" approved="yes">
        <source>Your email address</source>
        <target state="final">Jūsu e-pasta adrese</target>
      </trans-unit>
      <trans-unit id="option_emailMeAtLogin.alttitle" resname="option_emailMeAtLogin.alttitle" approved="yes">
        <source>Notify by login</source>
        <target state="final">Notificēt pie autorizācijas</target>
      </trans-unit>
      <trans-unit id="option_newPassword.alttitle" resname="option_newPassword.alttitle" approved="yes">
        <source>Change password</source>
        <target state="final">Mainīt paroli</target>
      </trans-unit>
      <trans-unit id="option_newPasswordAgain.alttitle" resname="option_newPasswordAgain.alttitle" approved="yes">
        <source>Change password, confirm</source>
        <target state="final">Mainīt paroli, apstiprināt</target>
      </trans-unit>
      <trans-unit id="reset.alttitle" resname="reset.alttitle" approved="yes">
        <source>Reset all Values to default</source>
        <target state="final">Atspēkot visas vērtības uz standarta</target>
      </trans-unit>
      <trans-unit id="simuser.alttitle" resname="simuser.alttitle" approved="yes">
        <source>Simulate backend user</source>
        <target state="final">Simulēt backend lietotāju</target>
      </trans-unit>
    </body>
  </file>
