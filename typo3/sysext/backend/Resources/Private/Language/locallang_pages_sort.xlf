<?xml version="1.0" encoding="UTF-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" version="1.2">
  <file source-language="en" datatype="plaintext" original="EXT:backend/Resources/Private/Language/locallang_pages_sort.xlf" date="2011-10-17T20:22:37Z" product-name="backend">
    <header/>
    <body>
      <trans-unit id="title">
        <source>Sort sub pages</source>
      </trans-unit>
      <trans-unit id="currentPageOrder">
        <source>Current page order</source>
      </trans-unit>
      <trans-unit id="changeOrder">
        <source>Sort these pages by</source>
      </trans-unit>
      <trans-unit id="changeOrderConfirm" x-unused-since="15.0">
        <source>You're about to change the order of the above pages. Are you sure you want to continue?</source>
      </trans-unit>
      <trans-unit id="sort">
        <source>Sort</source>
      </trans-unit>
      <trans-unit id="sort_by_title.title">
        <source>Sort pages by page title</source>
      </trans-unit>
      <trans-unit id="sort_by_title.description">
        <source>The pages will be sorted by their page title. Continue? You can restore the previous order using the 'History/Undo' feature.</source>
      </trans-unit>
      <trans-unit id="sort_by_subtitle.title">
        <source>Sort pages by subtitle</source>
      </trans-unit>
      <trans-unit id="sort_by_subtitle.description">
        <source>The pages will be sorted by their subtitle. Continue? You can restore the previous order using the 'History/Undo' feature.</source>
      </trans-unit>
      <trans-unit id="sort_by_navigation_title.title">
        <source>Sort pages by navigation title</source>
      </trans-unit>
      <trans-unit id="sort_by_navigation_title.description">
        <source>The pages will be sorted by their navigation title. Continue? You can restore the previous order using the 'History/Undo' feature.</source>
      </trans-unit>
      <trans-unit id="sort_by_change_time.title">
        <source>Sort pages by change-time</source>
      </trans-unit>
      <trans-unit id="sort_by_change-time.description">
        <source>The pages will be sorted by their change-time. Continue? You can restore the previous order using the 'History/Undo' feature.</source>
      </trans-unit>
      <trans-unit id="sort_by_create-time.title">
        <source>Sort pages by create-time</source>
      </trans-unit>
      <trans-unit id="sort_by_create-time.description">
        <source>The pages will be sorted by their create-time. Continue? You can restore the previous order using the 'History/Undo' feature.</source>
      </trans-unit>
      <trans-unit id="sort_by_reverse_order.title">
        <source>Reverse the page order</source>
      </trans-unit>
      <trans-unit id="sort_by_reverse_order.description">
        <source>The pages will be sorted by reversing the current page order. Continue? You can restore the previous order using the 'History/Undo' feature.</source>
      </trans-unit>
      <trans-unit id="fieldTitle">
        <source>Page title</source>
      </trans-unit>
      <trans-unit id="fieldSubtitle">
        <source>Subtitle</source>
      </trans-unit>
      <trans-unit id="fieldNavTitle">
        <source>Navigation title</source>
      </trans-unit>
      <trans-unit id="fieldCrdate">
        <source>Create-time</source>
      </trans-unit>
      <trans-unit id="fieldTstamp">
        <source>Change-time</source>
      </trans-unit>
      <trans-unit id="changeOrderByTitle">
        <source>Page title</source>
      </trans-unit>
      <trans-unit id="changeOrderBySubtitle">
        <source>Subtitle</source>
      </trans-unit>
      <trans-unit id="changeOrderByNavtitle">
        <source>Navigation title</source>
      </trans-unit>
      <trans-unit id="changeOrderByTstamp">
        <source>Change-time</source>
      </trans-unit>
      <trans-unit id="changeOrderByCreate">
        <source>Create-time</source>
      </trans-unit>
      <trans-unit id="changeOrderReverse">
        <source>Reverse current order</source>
      </trans-unit>
      <trans-unit id="hasInvisiblePage.title">
        <source>Invisible subpages</source>
      </trans-unit>
      <trans-unit id="hasInvisiblePage.message">
        <source>Some subpages are not visible because of access restrictions. These hidden pages are excluded from sorting.</source>
      </trans-unit>
      <trans-unit id="noSubpages.title">
        <source>No subpages</source>
      </trans-unit>
      <trans-unit id="noSubpages.message">
        <source>Please select a page with subpages.</source>
      </trans-unit>
      <trans-unit id="notAvailableInWorkspace.title">
        <source>Not implemented</source>
      </trans-unit>
      <trans-unit id="notAvailableInWorkspace.message">
        <source>This function is not available in the current draft workspace; please switch back to the LIVE workspace.</source>
      </trans-unit>
      <trans-unit id="noEditPermissions">
        <source>No edit permissions on this sub page. This page can not be re-sorted among others.</source>
      </trans-unit>
    </body>
  </file>
</xliff>
