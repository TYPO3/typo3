{
	"name": "typo3tests/test-canonical-plugin",
	"type": "typo3-cms-extension",
	"description": "This extension provides an uncached plugin that changes the canonical URL.",
	"version": "1.0.0",
	"license": "GPL-2.0-or-later",
	"require": {
		"typo3/cms-core": "15.0.*@dev",
		"typo3/cms-seo": "15.0.*@dev"
	},
	"extra": {
		"typo3/cms": {
			"extension-key": "test_canonical_plugin",
			"Package": {
				"providesPackages": []
			}
		}
	},
	"autoload": {
		"psr-4": {
			"TYPO3Tests\\TestCanonicalPlugin\\": "Classes/"
		}
	}
}
