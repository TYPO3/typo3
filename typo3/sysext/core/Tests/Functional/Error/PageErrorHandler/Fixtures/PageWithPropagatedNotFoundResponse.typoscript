page = PAGE
page.10 = TEXT
page.10.value = contentOfRequestedPage
page.headerData.10 = TEXT
page.headerData.10.value = <meta name="marker" content="headerDataOfRequestedPage">
page.footerData.10 = TEXT
page.footerData.10.value = <!-- footerDataOfRequestedPage -->

[page["uid"] == 404]
page.10.value = contentOfNotFoundPage
page.headerData.10.value = <meta name="marker" content="headerDataOfNotFoundPage">
page.footerData.10.value = <!-- footerDataOfNotFoundPage -->
page.30 = USER_INT
page.30.userFunc = TYPO3\CMS\Core\Tests\Functional\Error\PageErrorHandler\Fixtures\PageContentErrorHandlerUserFuncs->renderRequestType
page.40 = COA_INT
page.40.10 = TEXT
page.40.10.data = context:date:timestamp
page.40.10.wrap = <!-- dateOfNotFoundPage:|-->
page.40.20 = TEXT
page.40.20.data = context:frontend.user:groupIds
page.40.20.wrap = <!-- frontendUserGroupsOfNotFoundPage:|-->
page.40.30 = TEXT
page.40.30.data = GP:example
page.40.30.wrap = <!-- exampleParameterOfNotFoundPage:|-->
[global]

[page["uid"] == 100]
page.20 = USER_INT
page.20.userFunc = TYPO3\CMS\Core\Tests\Functional\Error\PageErrorHandler\Fixtures\PageContentErrorHandlerUserFuncs->propagateNotFoundResponse
[global]

[page["uid"] == 101]
page.20 = USER_INT
page.20.userFunc = TYPO3\CMS\Core\Tests\Functional\Error\PageErrorHandler\Fixtures\PageContentErrorHandlerUserFuncs->propagateNotFoundResponseFromExtbasePlugin
[global]
