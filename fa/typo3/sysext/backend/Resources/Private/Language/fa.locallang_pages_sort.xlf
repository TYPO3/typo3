        <source>Create-time</source>
        <target state="final">زمان ساخت</target>
      </trans-unit>
      <trans-unit id="fieldTstamp" approved="yes">
        <source>Change-time</source>
        <target state="final">زمان تغییر</target>
      </trans-unit>
