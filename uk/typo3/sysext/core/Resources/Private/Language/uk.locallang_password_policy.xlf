<?xml version="1.0" encoding="UTF-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" version="1.2">
  <file source-language="en" datatype="plaintext" original="EXT:core/Resources/Private/Language/locallang_password_policy.xlf" date="2022-04-13T14:28:00Z" product-name="cms" target-language="uk">
    <header/>
    <body>
      <trans-unit id="passwordRequirements.description" approved="yes">
        <source>The password must match the following requirements:</source>
        <target state="final">Пароль повинен відповідати наступним вимогам:</target>
      </trans-unit>
      <trans-unit id="requirement.minimumLength" approved="yes">
        <source>Minimum length: %d chars</source>
        <target state="final">Мінімальна довжина: %d символів</target>
      </trans-unit>
      <trans-unit id="requirement.upperCaseCharacterRequired" approved="yes">
        <source>At least one upper case char</source>
        <target state="final">Принаймні один символ верхнього регістру</target>
      </trans-unit>
      <trans-unit id="requirement.lowerCaseCharacterRequired" approved="yes">
        <source>At least one lower case char</source>
        <target state="final">Принаймні один символ нижнього регістру</target>
      </trans-unit>
      <trans-unit id="requirement.digitCharacterRequired" approved="yes">
        <source>At least one digit</source>
        <target state="final">Принаймні одна цифра</target>
      </trans-unit>
      <trans-unit id="requirement.specialCharacterRequired" approved="yes">
        <source>At least one special char</source>
        <target state="final">Принаймні один спеціальний символ</target>
      </trans-unit>
      <trans-unit id="requirement.notCurrentPassword" approved="yes">
        <source>Must be different from current password</source>
        <target state="final">Має відрізнятися від поточного пароля</target>
      </trans-unit>
      <trans-unit id="error.minimumLength" approved="yes">
        <source>The password is too short. Minimum length is %d chars</source>
        <target state="final">Пароль занадто короткий. Мінімальна довжина — %d символів</target>
      </trans-unit>
      <trans-unit id="error.upperCaseCharacterRequired" approved="yes">
        <source>The password must at least contain one upper case char</source>
        <target state="final">Пароль має містити принаймні один символ верхнього регістру</target>
      </trans-unit>
      <trans-unit id="error.lowerCaseCharacterRequired" approved="yes">
        <source>The password must at least contain one lower case char</source>
        <target state="final">Пароль має містити принаймні один символ нижнього регістру</target>
      </trans-unit>
      <trans-unit id="error.digitCharacterRequired" approved="yes">
        <source>The password must at least contain one digit</source>
        <target state="final">Пароль має містити принаймні одну цифру</target>
      </trans-unit>
      <trans-unit id="error.specialCharacterRequired" approved="yes">
        <source>The password must at least contain one special char</source>
        <target state="final">Пароль має містити принаймні один спеціальний символ</target>
      </trans-unit>
      <trans-unit id="error.notCurrentPassword" approved="yes">
        <source>The password must be different from the old password</source>
        <target state="final">Пароль має відрізнятися від старого</target>
      </trans-unit>
    </body>
  </file>
</xliff>
