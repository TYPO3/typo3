        <source>Never</source>
        <target state="final">Ніколи</target>
      </trans-unit>
      <trans-unit id="visit_destination" resname="visit_destination" approved="yes">
        <source>Go to</source>
        <target state="final">Перейти до</target>
      </trans-unit>
      <trans-unit id="view_redirect" resname="view_redirect" approved="yes">
        <source>View redirect</source>
        <target state="final">Перегляд перенаправлення</target>
      </trans-unit>
