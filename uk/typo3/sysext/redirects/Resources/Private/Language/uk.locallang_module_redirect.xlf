        <target state="final">Скинути лічильник попадань цього запису?</target>
      </trans-unit>
      <trans-unit id="hit_reset.confirm.content" resname="hit_reset.confirm.content" approved="yes">
        <source>Are you sure you want to reset the hitcounter of this record?</source>
        <target state="final">Ви впевнені, що хочете скинути лічильник попадань цього запису?</target>
      </trans-unit>
      <trans-unit id="hit_last" resname="hit_last" approved="yes">
        <source>Last Hit on</source>
        <target state="final">Останнє попадання</target>
      </trans-unit>
